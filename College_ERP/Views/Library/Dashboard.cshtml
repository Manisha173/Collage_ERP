
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_libraryLayout.cshtml";
}


<style>
    .custom-border {
        border: 2px solid rgba(0, 0, 0, 0.1);
        border-radius: 12px;
        margin-top: 10px;
        background-color: #fff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }
</style>
<div class="content-page">
    <div class="content">
