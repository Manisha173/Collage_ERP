                                                        <div class="p-2 border border-primary border-opacity-10 bg-primary-subtle rounded-pill me-2">
                                                            <div class="bg-primary rounded-circle widget-size text-center">
                                                                <i data-feather="book" class="text-light"></i>
                                                            </div>
                                                        </div>
                                                        <p class="mb-0 text-dark fs-15">Total Books</p>
                                                    </div>

                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black ps-5 ms-1 me-3">
                                                            @if (Model != null)
                                                            {
                                                                @Model.totalbooks
                                                            }
                                                            else
                                                            {
                                                                <span>No data</span>
                                                            }
                                                        </h3>
                                                        <div class="text-center">
                                                            <span class="text-dark fs-13 mb-0">View More</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
