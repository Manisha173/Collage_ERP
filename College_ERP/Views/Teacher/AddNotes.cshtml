
@{
    ViewBag.Title = "AddNotes";
    Layout = "~/Views/Shared/_teacherLayout.cshtml";
    var classList = ViewData["classList"] as List<College_ERP.Models.Teacher.SubjectAssignModel>;
}

<style>
    th {
        text-align: center !important;
    }

    td {
        text-align: center !important;
    }
</style>
<div class="content-page">
    <div class="content">
        <div class="container-fluid">

            <div class="row mt-2">
                <div class="col-sm-12">
                    <div class="card">
                        <div class="py-0 card-header border-bottom-0 d-flex justify-content-between">
                            <h4 class="card-title mb-0">Notes List</h4>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#notesModal">
                                Add Notes
                            </button>
                        </div>
                        <div class="card-body">
                            <table id="datatable" class="table table-bordered dt-responsive table-responsive nowrap">
                                <thead>
                                    <tr>
                                        <th>SR</th>
                                        <th>Class Name</th>
                                        <th>Section Name</th>
                                        <th>Subject Name</th>
                                        <th>Academic Year</th>  
                                        <th>Attachment</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        int srNo = 1;
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@srNo</td>

                                                <td>@item.ClassName</td>
                                                <td>@item.SectionName</td>
                                                <td>@item.SubjectName</td>
                                                <td>@item.AcademicYear</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.Attachmentpath))
                                                    {
                                                        <a href="@Url.Content(item.Attachmentpath)" target="_blank">View</a>
                                                    }
                                                    else
                                                    {
                                                        <span>No Certificate Uploaded</span>
                                                    }
                                                </td>

                                                <td>
                                                    <a href="" title="Update" data-id="@item.NoteId" class="btn btn-sm editDriver p-0"> <i data-feather="edit" class="text-warning" style="width:22px; height:22px;"></i></a>
                                                    <a href="" class="btn btn-sm p-0 deletemat" data-id="@item.NoteId" title="Delete"><i data-feather="trash-2" class="text-danger" style="width:22px; height:22px;"></i></a>

                                                </td>

                                            </tr>
                                            srNo++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Task Modal-->
<div class="modal fade" id="notesModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="notesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom-0">
                <h1 class="modal-title fs-5" id="notesModalLabel">Add Notes</h1>
                <button type="button" class="btn-close" id="CloseModal"></button>
            </div>
            <div class="modal-body">
                <form class="notesForm">
                    <div class="row">
                        <div class="col-sm-4">
                            <label class="form-label ">Class</label>
                            <select id="class-dropdown" name="ClassId" class="form-select" required>

                                <option value="">Select Class</option>
                                @if (classList != null && classList.Count > 0)
                                {
                                    foreach (var item in classList)
                                    {
                                        <option value="@item.ClassId">@item.ClassName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label ">Section</label>
                            <select id="section-dropdown" name="SectionId" class="form-select" required>
                                <option value="">--Select Section--</option>
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label ">Subject</label>
                            <select id="subject-dropdown" name="SubjectId" class="form-select" required>
                                <option value="">--Select Subject--</option>
                            </select>
                        </div>
                        <div class="col-md-6 mt-2">
                            <label class="form-label ">Academic Year</label>
                            <!--academic year-->
                            <select name="academicyear" class="form-select " id="academicyear" required>
                                <option selected disabled value="">--select academic year--</option>
                                @{
                                    for (int i = 0; i <= 10; i++)
                                    {
                                        <option @(DateTime.Now.Year == DateTime.Now.AddYears(-i).Year ? "selected" : "") value="@(DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i+1)).Year)">@(DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i+1)).Year)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-sm-6 mt-2">
                            <label for="attachment" class="form-label">Attachment (Optional)</label>
                            <input type="file" name="Attachment" id="attachment" class="form-control" />
                        </div>


                    </div>
                    <div class="mt-2 text-center">
                        <button type="button" class="btn btn-primary" id="submit-note-btn">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@*edit modal*@
<div class="modal fade" id="editnoteModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="notesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom-0">
                <h1 class="modal-title fs-5" id="notesModalLabel">Edit Notes</h1>
                <button type="button" class="btn-close" id="editCloseModal"></button>
            </div>
            <div class="modal-body">
                <form class="EditnotesForm">
                    <div class="row">
                        <div class="col-sm-4">
                            <input type="hidden" id="noteId" name="NoteId" />

                            <label class="form-label ">Class</label>
                            <select id="Editclass-dropdown" name="ClassId" class="form-select" required>

                                <option value="">Select Class</option>
                                @if (classList != null && classList.Count > 0)
                                {
                                    foreach (var item in classList)
                                    {
                                        <option value="@item.ClassId">@item.ClassName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label ">Section</label>
                            <select id="Editsection-dropdown" name="SectionId" class="form-select" required>
                                <option value="">--Select Section--</option>
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label ">Subject</label>
                            <select id="Editsubject-dropdown" name="SubjectId" class="form-select" required>
                                <option value="">--Select Subject--</option>
                            </select>
                        </div>
                        <div class="col-md-6 mt-2">
                            <label class="form-label ">Academic Year</label>
                            <!--academic year-->
                            <select name="academicyear" class="form-select " id="Editacademicyear" required>
                                <option selected disabled value="">--select academic year--</option>
                                @{
                                    for (int i = 0; i <= 10; i++)
                                    {
                                        <option @(DateTime.Now.Year == DateTime.Now.AddYears(-i).Year ? "selected" : "") value="@(DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i+1)).Year)">@(DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i+1)).Year)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-sm-6 mt-2">
                            <label for="attachment" class="form-label">Attachment (Optional)</label>
                            <input type="file" name="Attachment" id="Editattachment" class="form-control" />
                        </div>


                    </div>
                    <div class="mt-2 text-center">
                        <button type="button" class="btn btn-primary" id="updateNoteBtn">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {

        $('#CloseModal').on('click', function () {
            $('.notesForm')[0].reset();
            $('#notesModal').modal('hide');
        });
    });
    $(document).ready(function () {

        $('#editCloseModal').on('click', function () {
            $('.EditnotesForm')[0].reset();
            $('#editnoteModal').modal('hide');
        });
    });
    $('#class-dropdown').on('change', function () {
        let classid = $(this).val();
        $.ajax({
            url: '/teacher/GetSectionByClass', type: 'get', data: { classid: classid },
            success: function (res) {
                console.log(res);
                let $sectionDropdown = $('#section-dropdown');
                $sectionDropdown.empty();
                if (res && res.length > 0) {
                    $sectionDropdown.append('<option value="">Select Section</option>');
                    res.forEach(function (section) {

                        $sectionDropdown.append(
                            `<option value="${section.SectionId}">${section.SectionName}</option>`
                        );
                    });
                } else {
                    $sectionDropdown.append('<option value="">No sections available</option>');
                }
            },
            error: function (xhr) {
                console.log(xhr);
            }
        }).then(() => {

            $("#section-dropdown").change()
        })
    });

    $('#section-dropdown').on('change', function () {
        let classid = $('#class-dropdown').val();
        let sectionid = $(this).val();
        $.ajax({
            url: '/teacher/GetSubjectBySection', type: 'get', data: { classid: classid, sectionid: sectionid },
            success: function (res) {
                console.log(res);
                let $subjectDropdown = $('#subject-dropdown');
                $subjectDropdown.empty();
                if (res && res.length > 0) {
                    $subjectDropdown.append('<option value="">Select Subject</option>');
                    res.forEach(function (subject) {
                        $subjectDropdown.append(
                            `<option value="${subject.SubjectId}">${subject.SubjectName}</option>`
                        );
                    });
                } else {
                    $subjectDropdown.append('<option value="">No subjects available</option>');
                }
            },
            error: function (xhr) {
                console.log(xhr);
            }
        }).then(() => {

            $('#attendance-filter-form').trigger('submit');
        })


    });
    $("#class-dropdown").change();


    //insert
    $(document).ready(function () {
        $('#submit-note-btn').on('click', function () {
            Swal.fire({
                title: 'Please wait!',
                text: 'Processing your request...',
                allowEscapeKey: false,
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });
            var formData = new FormData();

            formData.append("ClassId", $("#class-dropdown").val());
            formData.append("SectionId", $("#section-dropdown").val());
            formData.append("SubjectId", $("#subject-dropdown").val());
            formData.append("AcademicYear", $("#academicyear").val());

            var fileInput = $("#attachment")[0];
            if (fileInput.files.length > 0) {
                formData.append("Attachment", fileInput.files[0]);
            }

            $.ajax({
                url: '/teacher/AddOrUpdateNote',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            confirmButtonColor: '#3085d6',
                            didClose: () => { location.reload(true); }
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            confirmButtonColor: '#d33'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'AJAX Error',
                        text: 'An unexpected error occurred.',
                        confirmButtonColor: '#d33'
                    });
                }
            });
        });
    });

    //delete
    $(document).off('click', '.deletemat').on('click', '.deletemat', function (e) {
        e.preventDefault();
        let id = $(this).data('id');
        debugger;
        Swal.fire({
            title: 'Are you sure?',
            text: 'Do you really want to delete this item?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete',
            cancelButtonText: 'Cancel',
            reverseButtons: true,
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'mx-2 btn btn-danger',
                cancelButton: 'mx-2 btn btn-light'
            },
            buttonsStyling: false
        }).then((result) => {
            console.log("Swal result:", result);
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Please Wait!',
                    text: 'Processing Your Request...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/teacher/DeleteNote',
                    type: 'POST',
                    data: { Id: id },
                    dataType: 'json',
                    success: function (res) {
                        console.log(res);
                        Swal.close(); 
                        if (res.status) {
                            Swal.fire({
                                title: 'Success',
                                text: res.message,
                                icon: 'success',
                            }).then(() => {
                                console.log("Reloading page...");
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: res.message,
                                icon: 'warning'
                            });
                        }
                    },
                    error: function (xhr) {
                        Swal.fire({
                            title: 'Error',
                            text: 'Server Error. Try Again Later!',
                            icon: 'error'
                        });
                        console.log(xhr);
                    }
                });
            } else {
                Swal.fire('Cancelled', 'Your item is safe.', 'info');
            }
        });
    });


    async function bindsection(id) {
        await $.ajax({
            url: '/teacher/GetSectionByClass', type: 'get', data: { classid: id },
            success: function (res) {
                console.log(res);
                let $sectionDropdown = $('#Editsection-dropdown');
                $sectionDropdown.empty();
                if (res && res.length > 0) {
                    $sectionDropdown.append('<option value="">Select Section</option>');
                    res.forEach(function (section) {

                        $sectionDropdown.append(
                            `<option value="${section.SectionId}">${section.SectionName}</option>`
                        );
                    });
                } else {
                    $sectionDropdown.append('<option value="">No sections available</option>');
                }
            },
            error: function (xhr) {
                console.log(xhr);
            }
        }).then(() => {

            $("#Editsection-dropdown").change()
        })
    }
    $('#Editclass-dropdown').on('change',async function () {
        let classid = $(this).val();
        await bindsection(id);
    });


    async function bindsubject(classid, sectionid) {
      await  $.ajax({
            url: '/teacher/GetSubjectBySection', type: 'get', data: { classid: classid, sectionid: sectionid },
            success: function (res) {
                console.log(res);
                let $subjectDropdown = $('#Editsubject-dropdown');
                $subjectDropdown.empty();
                if (res && res.length > 0) {
                    $subjectDropdown.append('<option value="">Select Subject</option>');
                    res.forEach(function (subject) {
                        $subjectDropdown.append(
                            `<option value="${subject.SubjectId}">${subject.SubjectName}</option>`
                        );
                    });
                } else {
                    $subjectDropdown.append('<option value="">No subjects available</option>');
                }
            },
            error: function (xhr) {
                console.log(xhr);
            }
        }).then(() => {


        })
    }
    $('#Editsection-dropdown').on('change',async function () {
        let classid = $('#Editclass-dropdown').val();
        let sectionid = $(this).val();
        await bindsubject(classid, sectionid);


    });
    $("#Editclass-dropdown").change();


    //get by id
    $(document).on('click', '.editDriver', function (e) {
        e.preventDefault();

        let noteId = $(this).data('id');

        $.ajax({
            url: '/teacher/GetNoteById',
            type: 'GET',
            data: { id: noteId },
            success: function (response) {
                if (response.success) {
                    let data = response.data;

                    $("#noteId").val(data.NoteId);
                    $("#Editacademicyear").val(data.AcademicYear);
                    $("#Editclass-dropdown").val(data.ClassId); 
                    bindsection(data.ClassId).then(() => {
                        $('#Editsection-dropdown').val(data.SectionId);
                    })
                    bindsubject(data.ClassId, data.SectionId).then(() => {
                        $('#Editsubject-dropdown').val(data.SubjectId);
                    })
                    if (data.Attachment) {
                        $("#Attachment").text(data.Attachment);
                    }

                    $('#editnoteModal').modal('show');
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Error', 'An error occurred while loading note details.', 'error');
            }
        });
    });

    //update
    $('#updateNoteBtn').on('click', function () {
        var formData = new FormData();

        formData.append("NoteId", $("#noteId").val());
        formData.append("ClassId", $("#Editclass-dropdown").val());
        formData.append("SectionId", $("#Editsection-dropdown").val());
        formData.append("SubjectId", $("#Editsubject-dropdown").val());
        formData.append("AcademicYear", $("#Editacademicyear").val());

        var fileInput = $("#Editattachment")[0];
        if (fileInput.files.length > 0) {
            formData.append("Attachment", fileInput.files[0]);
        }

        $.ajax({
            url: '/teacher/AddOrUpdateNote',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: response.message,
                        confirmButtonColor: '#3085d6'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Error', 'An unexpected error occurred.', 'error');
            }
        });
    });

</script>
