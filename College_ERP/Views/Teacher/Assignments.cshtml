                didOpen: () => {
                    Swal.showLoading();
                }
            })
            $("#exampleModal").modal("show")
            $(".modalAction").text("Update")
            let id = $(this).data("id");
            //console.log($("#classsection_" + id).attr("data-class"))
            $("#upId").val(id)
            $("#class-dropdown").val($("#classsection_" + id).attr("data-class")).change()
            setTimeout(() => {

            $("#section-dropdown").val($("#classsection_" + id).attr("data-section")).change()
            },1000)
            setTimeout(() => {
                //alert($("#subject_" + id).attr("data-id"))
                $("#subject-dropdown").val($("#subject_" + id).attr("data-id"))
                Swal.close()
            },2000)
            $("#title").val($("#title_" + id).text())
            $("#academicyear").val($("#year_" + id).text())
            $("#completion").val($("#completion_" + id).data("date"))
            $("#description").val($("#desc_" + id).children().data("desc"))
        })

        // Modal for viewing address
        $(document).on('click', '.view-address', function (e) {
            e.preventDefault();
            const address = $(this).data('address');
            $('#addressModalBody').text(address);
            $('#addressModal').modal('show');
        });

        // Load dropdowns and setup form
        //$.ajax({
        //    url: '/Teacher/GetAssignedSubjects',
        //    type: 'GET',
        //    success: function (data) {
        //        const today = new Date().toISOString().split('T')[0];
        //        $('#current-date').attr('max', today).val(today);

        //        const assignments = data.Assignments;
        //        const classMap = new Map();

        //        assignments.forEach(item => {
        //            if (!classMap.has(item.ClassId)) {
        //                classMap.set(item.ClassId, {
        //                    className: item.ClassName,
        //                    sections: new Map(),
        //                    subjects: new Map()
        //                });
        //            }
        //            let entry = classMap.get(item.ClassId);
        //            entry.sections.set(item.SectionId, item.SectionName);
        //            entry.subjects.set(item.SubjectId, item.SubjectName);
        //        });

        //        $('#class-dropdown').on('change', function () {
        //            const selectedClassId = parseInt($(this).val());
        //            const selectedData = classMap.get(selectedClassId);

        //            $('#section-dropdown').empty();
        //            selectedData.sections.forEach((name, id) => {
        //                $('#section-dropdown').append(`<option value="${id}">${name}</option>`);
        //            });

        //            $('#subject-dropdown').empty();
        //            selectedData.subjects.forEach((name, id) => {
        //                $('#subject-dropdown').append(`<option value="${id}">${name}</option>`);
        //            });
        //        });

        //        classMap.forEach((value, classId) => {
        //            $('#class-dropdown').append(`<option value="${classId}">${value.className}</option>`);
        //        });

        //        const firstClassId = $('#class-dropdown option:first').val();
        //        if (firstClassId) {
        //            $('#class-dropdown').val(firstClassId).trigger('change');
        //        }
        //    },
        //    error: function () {
        //        Swal.fire("error", "Failed to load assigned subjects.", "error");
        //    }
        //});

        // Load student list
        $('#attendance-filter-form').on('submit', function (e) {
            e.preventDefault();
            Swal.fire({
                title: "Please Wait..!",
                html: "your request are under process",
                allowOutSideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            })
            let formData = new FormData(this)
            let attachement = $("#attachment").get(0);
            if (attachement.files.length > 0) {
                formData.append("attachement", attachement.files[0])
            }
            $.ajax({
                url: '/Teacher/insertAssignment',
                type: 'Post',
                data: formData,
                processData: false,
                contentType: false,
                success: function (data) {
                    console.log(data)
                    if (data.status) {
                        Swal.fire({
                            title: "Success",
                            text: data.message,
                            icon: "success"
                        }).then(() => {
                            location.reload();
                        })
                    } else {
                        Swal.fire({
                            title: "error",
                            text: data.message,
                            icon: "error"
                        })
                    }
                },
                error: function (xhr) {
                    Swal.fire("error", xhr.responseText, "error");
                }
            });
        });

        // Mark All Present


        // Change individual checkbox
        $(document).on('change', '.student-check', function () {
            const icon = $(this).siblings('.status-icon');
            if ($(this).is(':checked')) {
                if ($('#mark-all-present').is(':checked')) {
                    icon.removeClass('text-danger').addClass('text-success').text('✔');
                } else if ($('#mark-all-absent').is(':checked')) {
                    icon.removeClass('text-success').addClass('text-danger').text('✘');
                }
            } else {
                icon.removeClass('text-success text-danger').text('');
            }
        });

        // Submit Attendance
        $('#submit-attendance').on('click', function () {
            const classId = $('#class-dropdown').val();
            const sectionId = $('#section-dropdown').val();
            const subjectId = $('#subject-dropdown').val();
            const attendanceDate = $('#current-date').val();

            const allPresent = $("#mark-all-present").prop("checked");
            const allAbsent = $("#mark-all-absent").prop("checked");

            if (!allPresent && !allAbsent) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Attention!',
                    text: "Please select either 'All Present' or 'All Absent' before submitting.",
                    confirmButtonText: 'OK'
                });
                return;
            }

            Swal.fire({
                title: "Please Wait..!",
                html: "your request are under process",
                allowOutSideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            })

            let attendanceData = [];
            let IsPresent = $("#mark-all-present").is(":checked");
            let IsAbsent = $("#mark-all-absent").is(":checked");
            $('#student-attendance-table tbody tr').each(function () {
                const checkbox = $(this).find('.student-check');
                const studentId = checkbox.data('studentid');
                let isChecked = checkbox.prop("checked");
                debugger
                if (IsPresent && isChecked) {
                    isChecked = true
                } else if (IsAbsent && isChecked) {
                    isChecked = false;
                } else if (IsAbsent && !isChecked) {
                    isChecked = true;
                }

                attendanceData.push({
                    StudentId: studentId,
                    AttendanceStatus: isChecked
                });
            });

            $.ajax({
                url: '/Teacher/SubmitAttendance',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ClassId: classId,
                    SectionId: sectionId,
                    SubjectId: subjectId,
                    attendanceDate: attendanceDate,
                    AttendanceList: attendanceData
                }),
                success: function (res) {
                    if (res.status) {
                        Swal.fire({
                            title: "Success",
                            text: res.message,
                            icon: "success"
                        })
                    } else {
                        Swal.fire({
                            title: "Error",
                            text: res.message,
                            icon: "error"
                        })
                    }
                    $('#mark-all-present, #mark-all-absent').prop('checked', false);
                    toggleStudentCheckboxes(false);
                },
                error: function () {
                    Swal.fire("Error",'Failed to submit attendance.',"error");
                }
            });
        });

        $('#class-dropdown').on('change', function () {
            let classid = $(this).val();
            $.ajax({
                url: '/teacher/GetSectionByClass', type: 'get', data: { classid: classid },
                success: function (res) {
                    console.log(res);
                    let $sectionDropdown = $('#section-dropdown');
                    $sectionDropdown.empty();

                    $sectionDropdown.append('<option value="" selected disabled>--Select Section--</option>');
                    if (res && res.length > 0) {
                        res.forEach(function (section) {
                            $sectionDropdown.append(
                                `<option value="${section.SectionId}">${section.SectionName}</option>`
                            );
                        });
                    } else {
                        $sectionDropdown.append('<option value="">No sections available</option>');
                    }
                },
                error: function (xhr) {
                    console.log(xhr);
                }
            })
        });

        $('#section-dropdown').on('change', function () {
            let classid = $('#class-dropdown').val();
            let sectionid = $(this).val();
            $.ajax({
                url: '/teacher/GetSubjectBySection', type: 'get', data: { classid: classid, sectionid: sectionid },
                success: function (res) {
                    console.log(res);
                    let $subjectDropdown = $('#subject-dropdown');
                    $subjectDropdown.empty();
                    if (res && res.length > 0) {
                        $subjectDropdown.append('<option selected disabled value="">Select Subject</option>');
                        res.forEach(function (subject) {
                            $subjectDropdown.append(
                                `<option value="${subject.SubjectId}">${subject.SubjectName}</option>`
                            );
                        });
                    } else {
                        $subjectDropdown.append('<option value="">No subjects available</option>');
                    }
                },
                error: function (xhr) {
                    console.log(xhr);
                }
            })


        });
    });
</script>



