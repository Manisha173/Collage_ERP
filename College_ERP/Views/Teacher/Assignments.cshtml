
@{
    ViewBag.Title = "Assignments";
    Layout = "~/Views/Shared/_teacherLayout.cshtml";
    var classList = ViewData["classList"] as List<College_ERP.Models.Teacher.SubjectAssignModel>;
}

<style>
    .status-icon::before {
        content: "";
        display: inline-block;
        width: 15px;
        height: 15px;
        margin-left: 5px;
        border-radius: 50%;
        vertical-align: middle;
    }

    .present .status-icon::before {
        background-color: green;
    }

    .absent .status-icon::before {
        background-color: red;
    }
    .modal-content {
        overflow-x: hidden; /* Hide horizontal scroll */
        word-wrap: break-word; /* Break long words */
    }
</style>

<div class="content-page">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex my-2 justify-content-between">
                        <span class="fs-5 fw-bold">
                            Assignment List
                        </span>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                            Add Assignment
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered" id="student-attendance-table">
                            <thead>
                                <tr>
                                    <th>SR</th>
                                    <th>Title</th>
                                    <th>Class</th>
                                    <th>Subject</th>
                                    <th>Assign date</th>
                                    <th>Completion date</th>
                                    <th>Academic year</th>
                                    <th>Description</th>
                                    <th>Attachment</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    int count = 0;
                                    foreach (var item in Model as List<College_ERP.Models.Teacher.Assignment>)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <td id="title_@item.Id">@item.Title</td>


                                            <td id="classsection_@item.Id" data-class="@item.ClassId" data-section="@item.SectionId">@item.classname - @item.sectionname</td>

                                            <td id="subject_@item.Id" data-id="@item.SubjectId">@item.subjectname</td>
                                            <td>@(item.AssignDate?.ToString("dd-MMM-yyyy"))</td>
                                            <td data-date="@(item.CompletionDate?.ToString("yyyy-MM-dd"))" id="completion_@item.Id">@(item.CompletionDate?.ToString("dd-MMM-yyyy"))</td>
                                            <td id="year_@item.Id" data-year="@item.AcademicYear">@item.AcademicYear</td>
                                            <td id="desc_@item.Id"><a role="button" data-desc="@item.Description" class="showDescription">View</a></td>
                                            <td>
                                                @if (string.IsNullOrEmpty(item.AttachmentUrl))
                                                {
                                                    <span>Not Uploaded</span>
                                                }
                                                else
                                                {
                                                    <a target="_blank" href="@item.AttachmentUrl">View</a>
                                                }
                                            </td>
                                            <td>
                                                <i role="button" data-id="@item.Id" id="editAssignment" class="fa-solid fs-5 text-warning fa-pen-to-square"></i>&nbsp;
                                                <a target="_blank" href="/teacher/StudentAssignmentList?classid=@item.ClassId&sectionid=@item.SectionId&assid=@item.Id">
                                                    <i role="button" id="studentList" data-id="@item.Id" class="fa-solid fs-5 text-info fa-users-rectangle"></i>
                                                </a>

                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!--add/update Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel"><span class="modalAction">Add</span> Assignment</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="attendance-filter-form">
                    <input type="hidden" name="Id" value="0" id="upId" />
                    <div class="row">
                        <div class="col-md-4">
                            <label class="fw-bold required-label">Class</label>
                            <select id="class-dropdown" name="ClassId" class="form-select" required>
                                <option value="" selected disabled>--Select Class--</option>
                                @if (classList != null && classList.Count > 0)
                                {
                                    foreach (var item in classList)
                                    {
                                        <option value="@item.ClassId">@item.ClassName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="fw-bold required-label">Section</label>
                            <select id="section-dropdown" name="SectionId" class="form-select" required>
                                <option selected disabled>--Select Section--</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="fw-bold required-label">Subject</label>
                            <select id="subject-dropdown" name="SubjectId" class="form-select" required>
                                <option selected disabled>--Select Subject--</option>
                            </select>
                        </div>

                        <div class="col-md-6 mt-3">
                            <label class="fw-bold required-label">Title</label>
                            <input type="text" id="title" required name="title" placeholder="Enter Title" class="form-control" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="fw-bold">Completion Date</label>
                            <input type="date" id="completion" name="CompletionDate" required class="form-control"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-6 mt-3">
                            <label class="fw-bold">Attachment</label>
                            <input type="file" id="attachment" name="Attachment" class="form-control" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="fw-bold required-label">Academic Year</label>
                            <!--academic year-->
                            <select name="academicyear" required class="form-select " id="academicyear">
                                <option selected disabled value="">--select academic year--</option>
                                @{
                                    for (int i = 0; i <= 10; i++)
                                    {
                                        <option @(DateTime.Now.Year == DateTime.Now.AddYears(-i).Year ? "selected" : "") value="@(DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i+1)).Year)">@(DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i+1)).Year)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-sm-12 mt-3">
                            <label class="fw-bold required-label">Description</label>
                            <textarea name="description" id="description" required class="form-control" placeholder="Write here.." rows="3"></textarea>
                        </div>
                        <div class="col-sm-12 mt-3 text-center">
                            <button class="btn btn-primary" type="submit"><span class="modalAction">Add</span> Assignment</button>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

<!-- Address Modal -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addressModalLabel">Description</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="addressModalBody">
                <!-- Address will go here -->
            </div>
        </div>
    </div>
</div>

<!--end modal-->
<script>
    $(document).ready(function () {
        $("#student-attendance-table").DataTable();
    })

    document.getElementById('completion').addEventListener('change', function () {
        const selectedDate = new Date(this.value);
        const today = new Date();
        today.setHours(0, 0, 0, 0);  

        if (selectedDate < today) {
            alert("Completion date cannot be in the past.");
            this.value = "";  
        }
    });

    function toggleStudentCheckboxes(enabled) {
        $('.student-check').prop('disabled', !enabled).prop('checked', false);
        $('.status-icon').text('');
    }

    $(document).ready(function () {

        $(document).on("click", ".showDescription", function () {
            $("#addressModal").modal("show")
            let desc = $(this).data("desc")
            $("#addressModalBody").text(desc)
        })

        $("#exampleModal").on("hide.bs.modal", function () {
            $(".modalAction").text("Add")
            $('#attendance-filter-form')[0].reset()
        })
        $(document).on("click", "#editAssignment", function () {
            Swal.fire({
                title: "Please Wait..!",
