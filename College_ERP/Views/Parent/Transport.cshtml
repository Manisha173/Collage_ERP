@model College_ERP.Models.StudentServices.main.TrasportDetailsModel
@{
    ViewBag.Title = "Transport";
    Layout = "~/Views/Shared/_ParentLayoutPage.cshtml";
}

<style>
    :root {
        --trp-navy: #1c3f66;
        --trp-muted: #6b7280;
        --trp-ink: #1e2433;
        --trp-green: #2e9e4f;
        --trp-dark-badge: #2b2f36;
    }

    .trp-header {
        background: var(--trp-navy);
        color: #fff;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: .75rem;
    }

        .trp-header a {
            color: #fff;
        }

        .trp-header h5 {
            margin: 0;
            font-weight: 600;
        }

    .trp-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.25rem;
    }

    /* Map */
    .trp-map-card {
        border: 1px solid #eceef2;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 1.75rem;
        position: relative;
    }

        .trp-map-card iframe {
            width: 100%;
            height: 220px;
            border: 0;
            display: block;
        }

    .trp-map-link {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #fff;
        border-radius: 6px;
        padding: .35rem .7rem;
        font-size: .82rem;
        font-weight: 600;
        color: #4285F4;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.15);
        text-decoration: none;
    }

        .trp-map-link:hover {
            color: #4285F4;
            text-decoration: none;
        }

    /* Driver info */
    .trp-driver-row {
        display: flex;
        align-items: flex-start;
        gap: 1.1rem;
        margin-bottom: 1.25rem;
    }

    .trp-driver-avatar {
        width: 72px;
        height: 72px;
        border-radius: 12px;
        border: 1px solid #e5e8ee;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
        background: #fff;
    }

        .trp-driver-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .trp-driver-avatar i {
            font-size: 2rem;
            color: var(--trp-navy);
        }

    .trp-driver-details {
        display: flex;
        flex-direction: column;
        gap: .55rem;
    }

    .trp-detail-item {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .trp-icon-badge {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: var(--trp-dark-badge);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        flex-shrink: 0;
    }

    .trp-detail-item span {
        font-weight: 600;
        color: var(--trp-ink);
        font-size: .92rem;
    }

    .trp-detail-item a {
        font-weight: 600;
        color: var(--trp-ink);
        font-size: .92rem;
        text-decoration: none;
    }

        .trp-detail-item a:hover {
            color: var(--trp-navy);
        }

    /* Verified */
    .trp-verified {
        display: flex;
        align-items: center;
        gap: .5rem;
        color: var(--trp-green);
        font-weight: 600;
        font-size: .92rem;
        margin-bottom: 1rem;
    }

        .trp-verified i {
            font-size: 1rem;
        }

    /* Drop point */
    .trp-drop-point {
        display: flex;
        align-items: center;
        gap: .5rem;
        color: var(--trp-navy);
        font-weight: 600;
        font-size: .95rem;
    }

        .trp-drop-point i {
            color: var(--trp-navy);
        }
</style>
@if (Model == null)
{
    <div class="content-page bg-white">
        <center><div class="alert alert-warning m-3">
    No transport details found.
</div></center>
    </div>
        }
        else
        {
        <div class="content-page bg-white">

            <div class="trp-header">
                <a href="/Parent/Dashboard"><i class="fa-solid fa-arrow-left"></i></a>
                <h5>Transport</h5>
            </div>

            <div class="trp-wrap">

                <!-- Map -->
                <div class="trp-map-card">

                    <a href="https://www.google.com/maps?q=@Url.Encode(Model.Address)"
                       target="_blank"
                       class="trp-map-link">

                        Maps
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>

                    </a>

                    <iframe loading="lazy"
                            allowfullscreen
                            src="https://www.google.com/maps?q=@Url.Encode(Model.Address)&output=embed">
                    </iframe>

                </div>

                <!-- Driver info -->
                <div class="trp-driver-row" id="driverInfo"
                     data-driver-name="Rakesh"
                     data-driver-phone="8965412301">
                    <div class="trp-driver-avatar">

                        <div class="trp-driver-avatar">

                            @if (!string.IsNullOrEmpty(Model.DLFileName))
                            {
                                <img src="~/Uploads/Driver/@Model.DLFileName" alt="Driver" />
                            }
                            else
                            {
                                <i class="fa-solid fa-user-tie"></i>
                            }

                        </div>

                    </div>
                    <div class="trp-driver-details">

                        <div class="trp-detail-item">
                            <span class="trp-icon-badge bg-light">
                                <i class="fa-solid fa-user"></i>
                            </span>
                            <span>@Model.driverName</span>
                        </div>

                        <div class="trp-detail-item">
                            <span class="trp-icon-badge bg-light">
                                <i class="fa-solid fa-phone"></i>
                            </span>

                            <a href="tel:@Model.ContactNo">
                                @Model.ContactNo
                            </a>
                        </div>

                        <div class="trp-detail-item">
                            <span class="trp-icon-badge bg-light">
                                <i class="fa-solid fa-bus"></i>
                            </span>

                            <span>@Model.bussNo</span>
                        </div>

                        <div class="trp-detail-item">
                            <span class="trp-icon-badge bg-light">
                                <i class="fa-solid fa-indian-rupee-sign"></i>
                            </span>

                            <span>₹ @Model.busCharge</span>
                        </div>

                    </div>
                </div>

                <!-- Verified -->
                <div class="trp-verified">
                    <i class="fa-solid fa-circle-check"></i> Verified
                </div>
                <div class="trp-detail-item mt-3">

                    <span class="trp-icon-badge bg-light">
                        <i class="fa-solid fa-map-location-dot"></i>
                    </span>

                    <span>@Model.Address</span>

                </div>
                <!-- Drop Point -->
                <div class="trp-drop-point ms-1">
                    <i class="fa-solid fa-location-dot">
                        </i>  Pickup Point:- @Model.pickupPoint
                </div>

                <div class="trp-detail-item">

                    <span class="trp-icon-badge bg-light">
                        <i class="fa-solid fa-bus"></i>
                    </span>

                    <span>@Model.bussNo</span>

                </div>

                <div class="trp-detail-item">

                    <span class="trp-icon-badge bg-light">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                    </span>

                    <span>₹ @Model.busCharge</span>

                </div>

                <div class="trp-detail-item">

                    <span class="trp-icon-badge bg-light">
                        <i class="fa-solid fa-location-dot"></i>
                    </span>

                    <span>@Model.Address</span>

                </div>

            </div>
        </div>
        }
