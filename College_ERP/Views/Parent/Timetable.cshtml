@model College_ERP.ViewModels.ParentTimeTableViewModel
@{
    ViewBag.Title = "Timetable";
    Layout = "~/Views/Shared/_ParentLayoutPage.cshtml";

}

<style>
    :root {
        --tt-accent: #3F6079;
        --tt-accent-soft: #eef2ff;
        --tt-ink: #1e2433;
        --tt-muted: #6b7280;
    }

    .tt-day-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 12px;
        padding: .5rem;
        height: 100%;
        min-height: 650px;
    }

    .tt-day-header {
        padding: .4rem .25rem .5rem;
        margin-bottom: .5rem;
        text-align: center;
    }



    .tt-class-card {
        background: #f8f9fb;
        border-radius: 10px;
        padding: .55rem .65rem;
        margin-bottom: .5rem;
        position: relative;
        padding-left: .8rem;
        transition: box-shadow .15s ease, transform .15s ease;
    }

        .tt-class-card:last-child {
            margin-bottom: 0;
        }

        .tt-class-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 6px;
            bottom: 6px;
            width: 3px;
            border-radius: 3px;
            background: var(--tt-accent);
        }

        .tt-class-card:hover {
            box-shadow: 0 4px 12px rgba(20,20,40,.08);
            transform: translateY(-1px);
        }

    .tt-subject {
        font-weight: 600;
        font-size: .85rem;
        color: var(--tt-ink);
        line-height: 1.2;
        margin: 0;
    }

    .tt-time {
        font-size: .72rem;
        color: var(--tt-muted);
        margin: .2rem 0 0;
    }

    /* Teacher schedule list — sits above Weekly Timetable */
    .tsc-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 10px;
        padding: 1rem 1.1rem;
        margin-bottom: 1rem;
    }

    .tsc-top {
        display: flex;
        align-items: center;
        gap: .8rem;
        margin-bottom: .8rem;
    }

    .tsc-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #e9ebf0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
    }

        .tsc-avatar i {
            font-size: 1.6rem;
            color: #8b93a1;
        }

        .tsc-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .tsc-name {
        font-weight: 600;
        color: var(--tt-accent);
        font-size: .95rem;
        margin: 0;
        line-height: 1.3;
    }

    .tsc-subtitle {
        color: var(--tt-accent);
        font-size: .85rem;
        margin: 0;
        opacity: .85;
    }

    .tsc-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid #eceef2;
        padding-top: .7rem;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .tsc-meta-item {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .82rem;
        color: var(--tt-accent);
    }

        .tsc-meta-item i {
            color: var(--tt-accent);
            font-size: .9rem;
        }

    /* Highlight today's column - toggle the .tt-today class server-side */

    .tt-today .tt-day-header h6 {
        color: #4F7CFF;
    }
</style>

<div class="content-page bg-gray">
    <div class="content">
        <div class="container-fluid mt-3">
            <div class="col-sm-12">
                <!-- Teacher / Class Schedule list (new section) -->
                <div id="teacherScheduleList" class="row p-3 mt-3 mb-4">

                    @if (Model.TodaySchedule != null && Model.TodaySchedule.Any())
                    {
                        foreach (var item in Model.TodaySchedule)
                        {
                            <div class="tsc-card p-3 col-sm-8 mx-auto">

                                <div class="tsc-top">

                                    <div class="tsc-avatar">
                                        <i class="fa-solid fa-user"></i>
                                    </div>

                                    <div>

                                        <p class="tsc-name">
                                            @item.teacherName
                                        </p>

                                        <p class="tsc-subtitle">
                                            @item.subjectName
                                        </p>

                                    </div>

                                </div>

                                <div class="tsc-meta">

                                    <div class="tsc-meta-item">

                                        <i class="fa-regular fa-calendar"></i>

                                        @(char.ToUpper(item.day[0]) + item.day.Substring(1))

                                    </div>

                                    <div class="tsc-meta-item">

                                        <i class="fa-regular fa-clock"></i>

                                        @item.combineTime

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-md-12 text-center">
                            No Schedule Available
                        </div>
                    }

                </div>
            </div>
            <div class="col-sm-12">
                <div class="row px-3">
                    <div class="col-sm-12">
                        <h5>Weekly TimeTable</h5>

                        <div class="row mt-3 g-3">

                            @foreach (var day in Model.WeeklyTimeTable)
                            {
                                var today =
                                    DateTime.Now.DayOfWeek.ToString()
                                    .Equals(day.day,
                                    StringComparison.OrdinalIgnoreCase);

                                <div class="col-6 col-md-4 col-lg-2 @(today ? "tt-today" : "")">

                                    <div class="tt-day-card">

                                        <div class="tt-day-header">

                                            <h6 style="font-weight:bold">
                                                @day.day
                                            </h6>

                                        </div>

                                        @if(day.ttdata != null && day.ttdata.Any())
                                        {
                                            foreach (var cls in day.ttdata)
                                            {
                                                <div class="tt-class-card">

                                                    <p class="text-dark">

                                                        @($"{cls.className} {cls.sectionName}")

                                                    </p>

                                                    <p class="tt-subject">

                                                        @cls.subjectName

                                                    </p>

                                                    <p class="tt-time">

                                                        @cls.from - @cls.to

                                                    </p>

                                                </div>
                                            }
                                        }
                                        else
                                        {
                                    <div class="d-flex align-items-center justify-content-center text-muted"
                                         style="height:500px">
                                        <div>
                                            <i class="fa-regular fa-calendar-xmark fa-2x mb-2"></i>
                                            <br />
                                            No Classes
                                        </div>
                                    </div>
                                        }

                                    </div>

                                </div>
                            }

