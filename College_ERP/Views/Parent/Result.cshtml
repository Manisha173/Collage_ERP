@using College_ERP.Models.Admin
@{
    ViewBag.Title = "Result";
    Layout = "~/Views/Shared/_ParentLayoutPage.cshtml";
}
@{
    var exams = ViewBag.ExamList as List<ScheduleExamModel>;
}
<style>
    :root {
        --res-navy: #1c3f66;
        --res-navy-dark: #16324f;
        --res-muted: #6b7280;
        --res-green: #2e9e4f;
    }

    .res-header {
        background: var(--res-navy);
        color: #fff;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: .9rem;
    }

        .res-header a {
            color: #fff;
        }

        .res-header h5 {
            margin: 0;
            font-weight: 600;
        }

    .res-score {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: 1rem 1.25rem .5rem;
        color: var(--res-navy);
        font-weight: 600;
    }

    /* Form section */
    .res-form-wrap {
        max-width: 600px;
        margin: 1.5rem auto;
        padding: 0 1.25rem;
    }

    .res-field {
        border: 1px solid #d7dbe1;
        border-radius: 6px;
        padding: .55rem .9rem .6rem;
        margin-bottom: 1rem;
        position: relative;
        cursor: pointer;
        background: #fafbfc;
    }

        .res-field.active {
            border-color: var(--res-green);
        }

        .res-field label {
            position: absolute;
            top: -9px;
            left: 10px;
            background: #fff;
            padding: 0 5px;
            font-size: .72rem;
            font-weight: 600;
            color: var(--res-muted);
        }

        .res-field.active label {
            color: var(--res-green);
        }

        .res-field .res-field-value {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: .95rem;
            color: #1e2433;
        }

            .res-field .res-field-value.placeholder {
                color: #8b93a1;
            }

    .res-submit-btn {
        background: var(--res-navy);
        border: none;
        color: #fff;
        width: 100%;
        padding: .75rem;
        border-radius: 6px;
        font-weight: 600;
    }

        .res-submit-btn:hover {
            background: var(--res-navy-dark);
            color: #fff;
        }

    /* Picker modal (Academic Year / Exam Schedule) */
    #pickerModal .modal-content {
        border-radius: 8px;
        border: none;
        overflow: hidden;
    }

    #pickerModal .modal-header {
        border: none;
        padding: 1.1rem 1.25rem .5rem;
    }

    #pickerModal .modal-title {
        font-weight: 600;
        font-size: 1.15rem;
    }

    #pickerModal .modal-body {
        padding: 0;
        max-height: 320px;
        overflow-y: auto;
    }

    .picker-option {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .7rem 1.25rem;
        cursor: pointer;
    }

        .picker-option:hover {
            background: #f7f9fc;
        }

        .picker-option input[type="radio"] {
            width: 18px;
            height: 18px;
            accent-color: var(--res-navy);
            margin: 0;
        }

        .picker-option span {
            font-size: .95rem;
            color: #1e2433;
        }

    #pickerModal .modal-footer {
        border: none;
        padding: .6rem 1.25rem 1rem;
        justify-content: flex-end;
        gap: 1.5rem;
    }

        #pickerModal .modal-footer button {
            background: transparent;
            border: none;
            color: var(--res-navy);
            font-weight: 600;
            font-size: .9rem;
            padding: .3rem .2rem;
        }

    /* Result accordion */
    .res-results-wrap {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1.25rem 2rem;
    }

    .subject-card {
        border: 1px solid #e5e8ee;
        border-radius: 8px;
        margin-bottom: .9rem;
        overflow: hidden;
    }

    .subject-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .85rem 1.1rem;
        background: #fff;
        cursor: pointer;
        transition: background .15s ease;
    }

        .subject-card-header .subject-name {
            font-weight: 600;
            color: #1e2433;
            font-size: .95rem;
        }

        .subject-card-header .grade-badge {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--res-green);
            color: #fff;
            font-size: .78rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: .6rem;
        }

        .subject-card-header .header-right {
            display: flex;
            align-items: center;
        }

        .subject-card-header .chevron {
            color: #8b93a1;
            margin-left: .6rem;
            transition: transform .15s ease;
        }

    .subject-card.expanded .subject-card-header {
        background: var(--res-navy);
    }

        .subject-card.expanded .subject-card-header .subject-name {
            color: #fff;
        }

        .subject-card.expanded .subject-card-header .chevron {
            color: #fff;
            transform: rotate(180deg);
        }

    .subject-card-body {
        display: none;
        padding: .3rem 1.1rem .6rem;
    }

    .subject-card.expanded .subject-card-body {
        display: block;
    }

    .subject-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .55rem 0;
        border-bottom: 1px solid #f0f2f5;
    }

        .subject-row:last-child {
            border-bottom: none;
        }

        .subject-row .row-left {
            display: flex;
            align-items: center;
            gap: .8rem;
            color: #333;
            font-size: .9rem;
        }

            .subject-row .row-left i {
                color: var(--res-navy);
                width: 18px;
                text-align: center;
            }

        .subject-row .row-value {
            font-weight: 600;
            color: #1e2433;
            font-size: .92rem;
        }
</style>

<div class="content-page bg-white">

    <div class="res-header">
        <a href="/Parent/Dashboard"><i class="fa-solid fa-arrow-left"></i></a>
        <h5>Results</h5>
    </div>

    <div class="res-score">
        <i class="fa-solid fa-trophy"></i>
        <span>Your Score: <span id="scoreValue">0%</span></span>
    </div>

    <!-- Filter form -->
    <div class="res-form-wrap" id="resultForm">
        <div class="res-field" id="academicYearField" onclick="openPicker('academicYear')">
            <label>Academic Year</label>
                <span>Select Academic Year</span>
                <select id="academicYear" class="form-control">

                    @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 10; i--)
                    {
                        <option value="@($"{i}-{i+1}")">
                            @($"{i}-{i+1}")
                        </option>
                    }

                </select>
        </div>

        <div class="res-field" id="examScheduleField" onclick="openPicker('examSchedule')">
            <label>Exam Schedule</label>
                <span>Select Exam Schedule</span>
                <select id="examId" class="form-control">
                    <option value="">Select Exam</option>

                    @foreach (var exam in exams)
                    {
                        <option value="@exam.scheduleId">
                            @exam.examName
                        </option>
                    }
                </select>
        </div>

        <button type="button"
                id="btnSearch"
                class="btn w-100" style="background: var(--res-navy); color:white !important;"> Show Result
        </button>
</div>

    <!-- Results (subjects accordion) -->
    <div class="res-results-wrap" id="resultsWrap" style="display:none;"></div>

</div>

<!-- Generic Picker Modal -->
<div class="modal fade" id="pickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pickerModalTitle"></h5>
            </div>
            <div class="modal-body" id="pickerModalBody"></div>
            <div class="modal-footer">
                <button type="button" id="pickerCancelBtn">Cancel</button>
                <button type="button" id="pickerOkBtn">OK</button>
            </div>
        </div>
    </div>
</div>

<script>
    function loadResult(data) {

        var html = "";

        $.each(data, function (i, item) {

            html += `

<div class="subject-card">

<div class="subject-card-header">

<div class="subject-name">

${item.Subject}

</div>

<div class="header-right">

<div class="grade-badge">

${item.Grade}

</div>

<i class="fa fa-chevron-down chevron"></i>

</div>

</div>

<div class="subject-card-body">

<div class="subject-row">

<div class="row-left">

<i class="fa fa-book"></i>

Theory Marks

</div>

<div class="row-value">

${item.TheoryMarks}

</div>

</div>

<div class="subject-row">

<div class="row-left">

<i class="fa fa-layer-group"></i>

Total Marks

</div>

<div class="row-value">

${item.TotalMarks}

</div>

</div>

<div class="subject-row">

<div class="row-left">

<i class="fa fa-medal"></i>

Obtained Marks

</div>

<div class="row-value">

${item.TotalObtainedMarks}

</div>

</div>

<div class="subject-row">

<div class="row-left">

<i class="fa fa-flask"></i>

Practical Marks

</div>

<div class="row-value">

${item.PracticalMarks}

</div>

</div>

<div class="subject-row">

<div class="row-left">

<i class="fa fa-pencil"></i>

Total Theory

</div>

<div class="row-value">

${item.TotalTheoryMarks}

</div>

</div>

</div>

</div>

`;

        });

        $("#resultsWrap")
            .html(html)
            .show();
    }
    $(document).on("click", ".subject-card-header", function () {

        $(this)
            .parent()
            .toggleClass("expanded");

    });
    $("#btnSearch").on("click", function (e) {

        e.preventDefault();

        var examId = $("#examId").val();

        var academicYear = $("#academicYear").val();

        if (examId == "") {

            alert("Select Exam");

            return;
        }

        $.ajax({

            url: "/Parent/GetReportCard",

            type: "GET",

            data: {

                examId: examId,

                academicYear: academicYear

            },

            success: function (res) {

                console.log(res);

                if (!res.status || res.data.length == 0) {

                    alert("No Result Found");

                    return;
                }

                $("#scoreValue").text(
                    res.overallPercentage.toFixed(2) + "%"
                );

                loadResult(res.data);

            },

            error: function (xhr) {

                console.log(xhr);

                alert("Server Error");

            }

        });

    });
</script>