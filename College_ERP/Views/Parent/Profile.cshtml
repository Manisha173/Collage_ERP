@using College_ERP.Models.ParentServices;
@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_ParentLayoutPage.cshtml";
}
@{
    var parent = ViewBag.Parent as College_ERP.Models.ParentServices.main.ParentProfileModel;
}

<style>
    :root {
        --prf-navy: #1c3f66;
        --prf-navy-dark: #16324f;
        --prf-navy-light: #e8f0f8;
        --prf-navy-mid: #d5e3f0;
        --prf-muted: #6b7280;
        --prf-ink: #1e2433;
    }

    .prf-header {
        background: var(--prf-navy);
        color: #fff;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: .75rem;
    }

        .prf-header a {
            color: #fff;
        }

        .prf-header h5 {
            margin: 0;
            font-weight: 600;
        }

    .prf-hero {
        background: linear-gradient(135deg,#16324f,#1c3f66);
        padding: 10px 30px 10px;
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        overflow: hidden;
    }

        .prf-hero:before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            top: -120px;
            right: -70px;
        }

        .prf-hero:after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            left: -70px;
            bottom: -90px;
        }

    .prf-avatar {
        width: 25px;
        height: 25px;
        border-radius: 50%;
        overflow: hidden;
        background: #fff;
        padding: 4px;
        box-shadow: 0 8px 25px rgba(0,0,0,.18);
        flex-shrink: 0;
    }

        .prf-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .prf-avatar i {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #f5f7fb;
            color: #1c3f66;
            font-size: 32px;
        }

    .prf-hero-info .prf-name {
        color: #fff;
        font-weight: 700;
        font-size: 1.2rem;
        margin: 0;
    }

    .prf-hero-info .prf-email {
        color: rgba(255,255,255,.75);
        font-size: .88rem;
        margin: .2rem 0 0;
    }

    .prf-wrap {
        max-width: 900px;
        margin: -28px auto 25px;
        padding: 0 18px;
        position: relative;
        z-index: 10;
    }

    .prf-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(28,63,102,.08);
        padding: 22px;
        border: none;
    }

    /* ===== New: section title band (like "Personal Information" bar) ===== */
    .prf-card-title {
        display: flex;
        align-items: center;
        gap: .6rem;
        color: #fff;
        font-weight: 700;
        font-size: 1.05rem;
        margin: 0 0 1.1rem;
        background: linear-gradient(135deg, var(--prf-navy), var(--prf-navy-dark));
        padding: .9rem 1.1rem;
        border-radius: 12px;
    }

        .prf-card-title i {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255,255,255,.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
            color: #fff;
        }

    /* ===== New: info grid + info tile (replaces prf-row list) ===== */
    .prf-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .prf-info-tile {
        background: var(--prf-navy-light);
        border: 1px solid var(--prf-navy-mid);
        border-radius: 10px;
        padding: .85rem 1rem;
    }

        .prf-info-tile .tile-label {
            display: flex;
            align-items: center;
            gap: .5rem;
            color: var(--prf-navy);
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
            margin-bottom: .35rem;
        }

            .prf-info-tile .tile-label i {
                color: var(--prf-navy);
                width: 16px;
                text-align: center;
            }

        .prf-info-tile .tile-value {
            font-weight: 600;
            color: var(--prf-ink);
            font-size: .95rem;
            word-break: break-word;
        }

            .prf-info-tile .tile-value.empty {
                color: #b0b6c0;
                font-weight: 400;
                font-style: italic;
            }

    @@media (max-width: 576px) {
        .prf-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="content-page bg-white">
    <!-- Hero: avatar + name + email -->
    <div class="prf-hero">
        <div class="prf-avatar" id="parentAvatar">
            <img src="@parent.FatherPhoto" alt="Parent" style="display:none;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <center><i class="fa-solid fa-user"></i></center>
        </div>
        <div class="prf-hero-info">

            <h3 class="prf-name">
                @parent.FatherName
            </h3>

            <p class="prf-email">
                <i class="fa-solid fa-phone"></i>
                @parent.FatherNo
            </p>

        </div>
    </div>

    <div class="prf-wrap">

        <!-- Father Information -->
        <div class="prf-card mt-5">
            <p class="prf-card-title"><i class="fa-solid fa-user-tie"></i> Father Information</p>

            <div class="prf-grid">
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-signature"></i>Father Name</div>
                    <div class="tile-value" id="fatherName">@parent.FatherName</div>
                </div>
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-briefcase"></i>Occupation</div>
                    <div class="tile-value" id="fatherOccupation">@parent.FatherOccupation</div>
                </div>
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-phone"></i>Mobile Number</div>
                    <div class="tile-value" id="fatherMobile">@parent.FatherNo</div>
                </div>
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-building"></i>Office Address</div>
                    <div class="tile-value" id="fatherOfficeAddress">@parent.FatherOfficeAddress</div>
                </div>
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-graduation-cap"></i>Qualification</div>
                    <div class="tile-value" id="fatherQualification">@parent.FatherQualification</div>
                </div>
            </div>
        </div>

        <!-- Mother Information -->
        <div class="prf-card mt-3">
            <p class="prf-card-title"><i class="fa-solid fa-person-dress"></i> Mother Information</p>

            <div class="prf-grid">
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-signature"></i>Mother Name</div>
                    <div class="tile-value" id="motherName">@parent.MotherName</div>
                </div>
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-briefcase"></i>Occupation</div>
                    <div class="tile-value" id="motherOccupation">@parent.MotherOccupation</div>
                </div>
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-phone"></i>Mobile Number</div>
                    <div class="tile-value" id="motherMobile">@parent.MotherNo</div>
                </div>
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-building"></i>Office Address</div>
                    <div class="tile-value" id="motherOfficeAddress">@parent.MotherOfficeAddress</div>
                </div>
                <div class="prf-info-tile">
                    <div class="tile-label"><i class="fa-solid fa-graduation-cap"></i>Qualification</div>
                    <div class="tile-value" id="motherQualification">@parent.MotherQualification</div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    (function () {
        // Fill empty-looking values with an "empty" styled placeholder instead of leaving blank
        document.querySelectorAll('.tile-value').forEach(function (el) {
            var text = el.textContent.trim();
            if (text === '' || text === '—') {
                el.textContent = 'Not Provided';
                el.classList.add('empty');
            }
        });
    })();
</script>
