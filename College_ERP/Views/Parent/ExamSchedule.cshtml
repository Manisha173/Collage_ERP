@model List<College_ERP.Models.Admin.ScheduleExamModel>
@{
    ViewBag.Title = "ExamSchedule";
    Layout = "~/Views/Shared/_ParentLayoutPage.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
    :root {
        --exs-navy: #1c3f66;
        --exs-muted: #6b7280;
    }

    .exs-header {
        background: var(--exs-navy);
        color: #fff;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: .75rem;
    }

        .exs-header a {
            color: #fff;
        }

        .exs-header h5 {
            margin: 0;
            font-weight: 600;
        }

    .exs-card {
        margin: 1.25rem;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid #eceef2;
    }

        .exs-card h5 {
            color: var(--exs-navy);
            font-weight: 600;
            font-size: 1.05rem;
            margin-bottom: .3rem;
        }

        .exs-card p {
            color: #333;
            font-size: .9rem;
            margin-bottom: .9rem;
        }

    th {
        background: var(--exs-navy) !important;
    }
    .exs-btn-download {
        background: #eef1f5;
        border: none;
        border-radius: 20px;
        padding: .4rem 1rem;
        font-size: .85rem;
        font-weight: 500;
        color: #1e2433;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .exs-btn-download:hover {
            background: #e2e6ec;
        }
</style>

<div class="content-page bg-white">

    <div class="exs-header">
        <a href="/Parent/Dashboard"><i class="fa-solid fa-arrow-left"></i></a>
        <h5>Exam Schedule</h5>
    </div>

    <div class="row mt-5">
        <div class="col-sm-12 mx-auto table-responsive">
            <table class="table">
                <thead class="table-dark text-light">
                    <tr>
                        <th>Exam Id</th>
                        <th>Schedule Id</th>
                        <th>Exam Name</th>
                        <th>Academic Year</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Description</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var exam in Model)
                    {
                        <tr>
                            <td>@exam.examId</td>
                            <td>@exam.scheduleId</td>
                            <td>@exam.examName</td>
                            <td>@exam.academicYear</td>
                            <td>@exam.startExamDate.ToString("dd MMM yyyy")</td>
                            <td>@exam.endExamDate.ToString("dd MMM yyyy")</td>
                            <td>@exam.description</td>
                            <td>@exam.createdAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <button class="btn btn-sm viewExam" style="background: #1c3f66; color:white;"
                                        data-id="@exam.scheduleId">
                                    View Time Table
                                </button>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<div class="modal fade" id="examModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header" style="background: #1c3f66 !important;">
                <h4>Exam Time Table</h4>
            </div>

            <div class="modal-body">

                <h4 id="examName"></h4>

                <p>
                    <b>Class :</b>
                    <span id="className"></span>
                </p>

                <p>
                    <b>Academic Year :</b>
                    <span id="academicYear"></span>
                </p>

                <p>
                    <b>Description :</b>
                    <span id="description"></span>
                </p>

                <a id="attachment"
                   class="btn btn-primary" style="background: #1c3f66 !important;"
                   target="_blank">
                    Download Time Table
                </a>

            </div>

        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        //================ DOWNLOAD PDF ===================
        var downloadBtn = document.getElementById("downloadPdfBtn");
        var card = document.getElementById("examTimetableCard");

        if (downloadBtn && card) {

            downloadBtn.addEventListener("click", function () {

                if (!window.jspdf) {
                    console.error("jsPDF failed to load.");
                    return;
                }

                var jsPDF = window.jspdf.jsPDF;
                var doc = new jsPDF();

                var title = card.dataset.title;
                var description = card.dataset.description;

                var marginLeft = 15;
                var pageWidth = doc.internal.pageSize.getWidth();
                var maxWidth = pageWidth - marginLeft * 2;
                var y = 20;

                doc.setFont("helvetica", "bold");
                doc.setFontSize(16);
                doc.text(title, marginLeft, y);

                y += 12;

                doc.line(marginLeft, y, pageWidth - marginLeft, y);

                y += 10;

                doc.setFont("helvetica", "normal");
                doc.setFontSize(11);

                var lines = doc.splitTextToSize(description, maxWidth);

                doc.text(lines, marginLeft, y);

                doc.save("exam_schedule.pdf");
            });

        }

        //================ VIEW BUTTON ===================
        $(document).on("click", ".viewExam", function () {

            var scheduleId = $(this).data("id");

            $.ajax({
                url: "/Parent/GetExamTimeTable",
                type: "GET",
                data: {
                    scheduleId: scheduleId
                },
                success: function (res) {

                    console.log(res);

                    if (!res.status || res.data.length == 0) {
                        alert("No timetable found.");
                        return;
                    }

                    var item = res.data[0];

                    $("#examName").text(item.examName);
                    $("#className").text(item.className);
                    $("#academicYear").text(item.academicYear);
                    $("#description").text(item.description);

                    if (item.attachmentName) {
                        $("#attachment")
                            .attr("href", item.attachmentName)
                            .show();
                    }
                    else {
                        $("#attachment").hide();
                    }

                    $("#examModal").modal("show");
                },
                error: function (xhr) {
                    console.log(xhr);
                    alert("Error while loading timetable.");
                }
            });

        });

    });
</script>