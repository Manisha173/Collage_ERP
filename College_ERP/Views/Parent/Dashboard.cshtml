                                                                </h3>
                                                                <div class="text-center">
                                                                    <span class="text-dark fs-13 mb-0">View More</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-0 custom-border">
                                            <div class="card-body">
                                                <a href="/Parent/Assignment?studentid=@student.StudentId">
                                                    <div class="widget-first">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="p-2 border border-secondary border-opacity-10 bg-secondary-subtle rounded-pill me-2">
                                                                <div class="bg-secondary rounded-circle widget-size text-center">
                                                                    <i data-feather="user-check" class="text-light"></i>
                                                                </div>
                                                            </div>
                                                            <p class="mb-0 text-dark fs-15">Assignments</p>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black me-3 ps-5 ms-1">
                                                            </h3>
                                                            <div class="text-center">
                                                                <span class="text-dark fs-13 mb-0">View More</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="card mb-0 custom-border">
                                            <div class="card-body">
                                                <a href="/Parent/ParentCommunication?studentid=@student.StudentId">
                                                    <div class="widget-first">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="p-2 border border-danger border-opacity-10 bg-danger-subtle rounded-pill me-2">
                                                                <div class="bg-danger rounded-circle widget-size text-center">
                                                                    <i data-feather="user" class="text-light"></i>
                                                                </div>
                                                            </div>
                                                            <p class="mb-0 text-dark fs-15">Parent Communication</p>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black me-3 ps-5 ms-1">
                                                            </h3>
                                                            <div class="text-center">
                                                                <span class="text-dark fs-13 mb-0">View More</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="card mb-0 custom-border">
                                            <div class="card-body">
                                                <a href="/Parent/ExamSchedule?classid=@student.ClassId">
                                                    <div class="widget-first">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="p-2 border border-success border-opacity-10 bg-success-subtle rounded-pill me-2">
                                                                <div class="bg-primary rounded-circle widget-size text-center">
                                                                    <i data-feather="slash" class="text-light"></i>
                                                                </div>
                                                            </div>
                                                            <p class="mb-0 text-dark fs-15">Exam Schedule</p>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black me-3 ps-5 ms-1">
                                                            </h3>
                                                            <div class="text-center">
                                                                <span class="text-dark fs-13 mb-0">View More</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="card mb-0 custom-border">
                                            <div class="card-body">
                                                <a href="/Parent/Notice?studentid=@student.StudentId">
                                                    <div class="widget-first">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="p-2 border border-warning border-opacity-10 bg-warning-subtle rounded-pill me-2">
                                                                <div class="bg-warning rounded-circle widget-size text-center">
                                                                    <i data-feather="wind" class="text-light"></i>
                                                                </div>
                                                            </div>
                                                            <p class="mb-0 text-dark fs-15">Notice</p>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black me-3 ps-5 ms-1">
                                                            </h3>
                                                            <div class="text-center">
                                                                <span class="text-dark fs-13 mb-0">View More</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="card mb-0 custom-border">
                                            <div class="card-body">
                                                <a href="/Parent/Result?studentId=@student.StudentId&academicYear=@student.AcademicYear">
                                                    <div class="widget-first">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="p-2 border border-warning border-opacity-10 bg-warning-subtle rounded-pill me-2">
                                                                <div class="bg-success rounded-circle widget-size text-center">
                                                                    <i data-feather="slash" class="text-light"></i>
                                                                </div>
                                                            </div>
                                                            <p class="mb-0 text-dark fs-15">Result</p>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black me-3 ps-5 ms-1">
                                                            </h3>
                                                            <div class="text-center">
                                                                <span class="text-dark fs-13 mb-0">View More</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-0 custom-border">
                                            <div class="card-body">
                                                <a href="/Parent/Fees?studentid=@student.StudentId">
                                                    <div class="widget-first">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="p-2 border border-warning border-opacity-10 bg-warning-subtle rounded-pill me-2">
                                                                <div class="bg-secondary rounded-circle widget-size text-center">
                                                                    <i data-feather="wind" class="text-light"></i>

                                                                </div>
                                                            </div>
                                                            <p class="mb-0 text-dark fs-15">Fees</p>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black me-3 ps-5 ms-1">
                                                            </h3>
                                                            <div class="text-center">
                                                                <span class="text-dark fs-13 mb-0">View More</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-0 custom-border">
                                            <div class="card-body">
                                                <a href="/Parent/Transport?studentid=@student.StudentId">
                                                    <div class="widget-first">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="p-2 border border-primary border-opacity-10 bg-primary-subtle rounded-pill me-2">
                                                                <div class="bg-primary rounded-circle widget-size text-center">
                                                                    <i data-feather="mail" class="text-light"></i>
                                                                </div>
                                                            </div>
                                                            <p class="mb-0 text-dark fs-15">Transport</p>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black me-3 ps-5 ms-1">
                                                            </h3>
                                                            <div class="text-center">
                                                                <span class="text-dark fs-13 mb-0">View More</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-0 custom-border">
                                            <div class="card-body">
                                                <a href="/Parent/Hostel?studentid=@student.StudentId">
                                                    <div class="widget-first">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <div class="p-2 border border-primary border-opacity-10 bg-primary-subtle rounded-pill me-2">
                                                                <div class="bg-secondary rounded-circle widget-size text-center">
                                                                    <i data-feather="bell" class="text-light"></i>
                                                                </div>
                                                            </div>
                                                            <p class="mb-0 text-dark fs-15">Hostel</p>
                                                        </div>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h3 style="margin-top: -20px;" class="mb-0 fs-22 text-black me-3 ps-5 ms-1" id="noticeCount">

                                                                <!---notice-->
                                                            </h3>
                                                            <div class="text-center">
                                                                <span class="text-dark fs-13 mb-0">View More</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>


        </div>
        <!-- end start -->


    </div> <!-- container-fluid -->
</div> <!-- content -->
