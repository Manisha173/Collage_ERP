    <script>
        $("#logoutuser").click(function () {
            Swal.fire({
                icon: "info",
                title: "Do you really want to Logout?",
                showCancelButton: true,
                confirmButtonText: "Logout"
            }).then((result) => {
                /* Read more about isConfirmed, isDenied below */
                if (result.isConfirmed) {
                    location.href = "/home/Logout"
                }
            });
        })

        $(document).ready(function () {
            $("#datatable").DataTable({
                paging: true,
                pageLength: 10,
                "columnDefs": [
                    { "width": "50px", "targets": 0 }
                ]
            })

            $.ajax({
                url: '/admin/GetAdminDetails',
                type: 'GET',
                success: function (data) {
                    console.log(data.adminImage)
                    if (data) {
                        $('#admin-name').text(data.adminName);
                        //$('#admin-profile-link').attr('href', '/admin/adminprofile?id=' + data.adminId);
                        if (data.adminImage) {
                            $('#adminI1').attr('src', data.adminImage);
                            $('#adminI2').attr('src', data.adminImage);

                        } else {
                            $('#adminI1').attr('src', '/Upload/default-user.png');
                            $('#adminI2').attr('src', '/Upload/default-user.png');
                        }

                        $('.admin-avatar').attr('title', data.adminName);
                    }
                },
                error: function () {
                    $('#admin-name').text("Error loading data.");
                    $('.admin-avatar').attr('src', '/Upload/default-user.png');
                }
            });

        })

        function showLoading(action) {
            Swal.fire({
                title: "Please Wait..!",
                html: "your request are under process",
                didOpen: () => {
                    Swal.showLoading();
                }
            })
            if (!action) {
                Swal.close();
            }
        }

        document.addEventListener('click', function (event) {
            let container = document.getElementById('searchContainer');
            if (container && !container.contains(event.target)) {
                let urlcontainer = $("#componentUrlContainer");
                urlcontainer.addClass("d-none");
                $("#searchComponent").val('');
            }
        });

        $("#searchForm").on("submit", function (e) {
            e.preventDefault()
            debugger
            let url = $("#componentUrlContainer").children().first().children().attr("href")
            if (url != null && url != "" && url)
                location.href = url;
        })

        let searchInterval;
        $("#searchComponent").on("input", function () {
            clearInterval(searchInterval)
            searchInterval = setTimeout(() => {
                let input = $(this).val().trim();
                let container = $("#componentUrlContainer")
                container.empty();
                container.removeClass("d-none")

                $.get("/admin/getUrlByUserInput", { input: input }).done((res) => {
                    console.log(res, "res")
                    if (res != null) {
                        if (res.length > 0) {
                            res.forEach(function (d, i) {
                                $("#componentUrlContainer").append(`
                                        <li class='border-bottom urlLi p-1 w-100'><a class='w-100 d-block' href='${d.url}'>${d.name}</a></li>
                                        `)
                            })
                        } else {
                            $("#componentUrlContainer").append(`
                                        <li class='border-bottom urlLi p-1 w-100'><a class='w-100 d-block' >no result found</a></li>
                                        `)
                        }
                    }
                }).fail((err) => {
                    console.log(err, "err")
                })
            }, 500)
        })
        let IsValidToBindFavorite = true;
        let isCliCkable = true;
        $("#sidebarfavoriteContainer").on("click", function () {
            if (IsValidToBindFavorite && isCliCkable) {
                $("#favoriteUrlContainer").empty()
                IsValidToBindFavorite = false;
                $.get("/admin/getUrlByUserFavorite").done((res) => {
                    console.log(res, "res")
                    if (res != null) {
                        if (res.length > 0) {
                            res.forEach(function (d, i) {
                                $("#favoriteUrlContainer").append(`
                                                <li>
                    <a class='tp-link' href='${d.url}'><i class="fa-solid text-warning fa-star-of-life"></i>&nbsp; ${d.name}</a>
</li>
                         `)
                            })
                        } else {
                            $("#favoriteUrlContainer").append(`
                         <li class='border-bottom urlLi p-1 w-100'><a class='w-100 d-block' >no result found</a></li>
                         `)
                        }
                    }
                }).fail((err) => {
                    console.log(err, "err")
                })
            }
            isCliCkable = !isCliCkable;
            setTimeout(() => {
                IsValidToBindFavorite = true
            }, 1000)

        })
    </script>

