@{
    Layout = null;
}

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>505 - Service Unavailable</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0f766e;
            --secondary: #134e4a;
            --accent: #115e59;
            --light: #042f2e;
            --dark: #042f2e;
            --success: #0d9488;
            --teal-50: #f0fdfa;
            --teal-100: #ccfbf1;
            --teal-200: #99f6e4;
            --teal-300: #5eead4;
            --teal-400: #2dd4bf;
            --teal-500: #14b8a6;
            --teal-600: #0d9488;
            --teal-700: #0f766e;
            --teal-800: #115e59;
            --teal-900: #134e4a;
            --teal-950: #042f2e;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(-45deg, var(--teal-800), var(--teal-700), var(--teal-600), var(--teal-500));
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
            height: 100vh;
            overflow: hidden;
        }

        @@keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .container {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .error-content {
            text-align: center;
            color: var(--teal-50);
            z-index: 10;
        }

        .error-number {
            font-size: 12rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 1rem;
            text-shadow: 0 0 30px rgba(240, 253, 250, 0.5);
            animation: bounce 2s infinite, glow 3s ease-in-out infinite alternate;
            position: relative;
            display: inline-block;
        }

        /* Googly Eyes for the Zero */
        .zero-with-eyes {
            position: relative;
            display: inline-block;
        }

        .googly-eye {
            position: absolute;
            width: 60px;
            height: 60px;
            background: white;
            border-radius: 50%;
            border: 3px solid var(--teal-900);
            animation: eyeBlink 4s infinite;
        }

        .googly-eye::after {
            content: '';
            position: absolute;
            width: 25px;
            height: 25px;
            background: var(--teal-900);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation: eyeMove 3s ease-in-out infinite;
        }

        .left-eye {
            top: 25%;
            left: 20%;
            animation-delay: 0s;
        }

        .left-eye::after {
            animation-delay: 0s;
        }

        .right-eye {
            top: 25%;
            right: 20%;
            animation-delay: 0.5s;
        }

        .right-eye::after {
            animation-delay: 0.5s;
        }

        @@keyframes eyeBlink {
            0%, 90%, 100% { transform: scaleY(1); }
            95% { transform: scaleY(0.1); }
        }

        @@keyframes eyeMove {
            0%, 100% { transform: translate(-50%, -50%); }
            25% { transform: translate(-30%, -30%); }
            50% { transform: translate(-70%, -50%); }
            75% { transform: translate(-50%, -70%); }
        }

        @@keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-20px); }
            60% { transform: translateY(-10px); }
        }

        @@keyframes glow {
            from { text-shadow: 0 0 30px rgba(240, 253, 250, 0.5); }
            to { text-shadow: 0 0 50px rgba(240, 253, 250, 0.8), 0 0 70px rgba(94, 234, 212, 0.6); }
        }

        .error-title {
            font-size: 2.5rem;
            font-weight: 300;
            margin-bottom: 1rem;
            opacity: 0;
            animation: fadeInUp 1s ease 0.5s forwards;
            color: var(--teal-100);
        }

        .error-subtitle {
            font-size: 1.2rem;
            font-weight: 300;
            margin-bottom: 3rem;
            opacity: 0;
            animation: fadeInUp 1s ease 1s forwards;
            color: var(--teal-200);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .btn-home {
            background: rgba(240, 253, 250, 0.1);
            border: 2px solid var(--teal-300);
            color: var(--teal-50);
            padding: 15px 40px;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            opacity: 0;
            animation: fadeInUp 1s ease 1.5s forwards;
        }

        .btn-home:hover {
            background: var(--teal-400);
            border-color: var(--teal-200);
            color: var(--teal-900);
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(15, 118, 110, 0.3);
        }

        /* Floating Particles */
        .particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .particle {
            position: absolute;
            background: var(--teal-300);
            border-radius: 50%;
            animation: float 6s infinite linear;
            opacity: 0.3;
        }

        .particle:nth-child(1) {
            width: 10px;
            height: 10px;
            left: 10%;
            animation-duration: 8s;
            animation-delay: 0s;
            background: var(--teal-400);
        }

        .particle:nth-child(2) {
            width: 15px;
            height: 15px;
            left: 20%;
            animation-duration: 10s;
            animation-delay: 2s;
            background: var(--teal-300);
        }

        .particle:nth-child(3) {
            width: 8px;
            height: 8px;
            left: 30%;
            animation-duration: 12s;
            animation-delay: 4s;
            background: var(--teal-200);
        }

        .particle:nth-child(4) {
            width: 12px;
            height: 12px;
            left: 40%;
            animation-duration: 9s;
            animation-delay: 1s;
            background: var(--teal-400);
        }

        .particle:nth-child(5) {
            width: 20px;
            height: 20px;
            left: 50%;
            animation-duration: 11s;
            animation-delay: 3s;
            background: var(--teal-300);
        }

        .particle:nth-child(6) {
            width: 6px;
            height: 6px;
            left: 60%;
            animation-duration: 7s;
            animation-delay: 5s;
            background: var(--teal-200);
        }

        .particle:nth-child(7) {
            width: 14px;
            height: 14px;
            left: 70%;
            animation-duration: 13s;
            animation-delay: 2.5s;
            background: var(--teal-400);
        }

        .particle:nth-child(8) {
            width: 18px;
            height: 18px;
            left: 80%;
            animation-duration: 8.5s;
            animation-delay: 1.5s;
            background: var(--teal-300);
        }

        .particle:nth-child(9) {
            width: 11px;
            height: 11px;
            left: 90%;
            animation-duration: 10.5s;
            animation-delay: 4.5s;
            background: var(--teal-200);
        }

        @@keyframes float {
            0% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }
            10% {
                opacity: 0.3;
            }
            90% {
                opacity: 0.3;
            }
            100% {
                transform: translateY(-100px) rotate(360deg);
                opacity: 0;
            }
        }

        /* Geometric Shapes */
        .shapes {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }

        .shape {
            position: absolute;
            border: 2px solid var(--teal-300);
            animation: rotate 20s linear infinite;
            opacity: 0.2;
        }

        .shape.triangle {
            width: 0;
            height: 0;
            border-left: 25px solid transparent;
            border-right: 25px solid transparent;
            border-bottom: 50px solid var(--teal-400);
            border-radius: 0;
            top: 20%;
            left: 15%;
            animation-duration: 25s;
            opacity: 0.3;
        }

        .shape.square {
            width: 40px;
            height: 40px;
            background: var(--teal-500);
            top: 60%;
            right: 20%;
            animation-duration: 30s;
            animation-direction: reverse;
            opacity: 0.2;
        }

        .shape.circle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--teal-600);
            bottom: 30%;
            left: 10%;
            animation-duration: 35s;
            opacity: 0.2;
        }

        @@keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Mobile Responsive */
        @@media (max-width: 768px) {
            .error-number {
                font-size: 8rem;
            }



            .error-title {
                font-size: 1rem;
            }

            .error-subtitle {
                font-size: 1rem;
                padding: 0 1rem;
            }

            .btn-home {
                padding: 12px 30px;
                font-size: 0.9rem;
            }
        }

        @@media (max-width: 480px) {
            .error-number {
                font-size: 6rem;
            }



            .error-title {
                font-size: 1.5rem;
            }
        }

        /* Fun wiggle animation for the whole error number */
        .error-number:hover {
            animation: wiggle 0.5s ease-in-out;
        }

        @@keyframes wiggle {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(-3deg); }
            75% { transform: rotate(3deg); }
        }
    </style>

    <!-- Animated Background Particles -->
    <div class="particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>

    <!-- Geometric Shapes -->
    <div class="shapes">
        <div class="shape triangle"></div>
        <div class="shape square"></div>
        <div class="shape circle"></div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <div class="error-content">
            <div class="error-number">
               505
            </div>
            <h1 class="error-title">Oops! Something went wrong</h1>
            <p class="error-subtitle">We're working to fix this issue</p>
            <a href="#" class="btn-home" id="btnGoBack">Previous Page</a>

        </div>
    </div>

    <script>
        // Add some interactive mouse effects
        document.addEventListener('mousemove', function(e) {
            const particles = document.querySelectorAll('.particle');
            const mouseX = e.clientX / window.innerWidth;
            const mouseY = e.clientY / window.innerHeight;

            particles.forEach((particle, index) => {
                const speed = (index + 1) * 0.3;
                const x = mouseX * speed;
                const y = mouseY * speed;

                particle.style.transform += ` translate(${x}px, ${y}px)`;
            });
        });

        // Make googly eyes follow mouse cursor
        document.addEventListener('mousemove', function(e) {
            const eyes = document.querySelectorAll('.googly-eye::after');
            const errorNumber = document.querySelector('.error-number');
            const rect = errorNumber.getBoundingClientRect();

            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;

            const mouseX = e.clientX;
            const mouseY = e.clientY;

            const angle = Math.atan2(mouseY - centerY, mouseX - centerX);
            const distance = Math.min(10, Math.sqrt(Math.pow(mouseX - centerX, 2) + Math.pow(mouseY - centerY, 2)) / 10);

            const eyePupils = document.querySelectorAll('.googly-eye');
            eyePupils.forEach(eye => {
                const pupil = eye.querySelector('::after');
                const moveX = Math.cos(angle) * distance;
                const moveY = Math.sin(angle) * distance;
                eye.style.setProperty('--pupil-x', moveX + 'px');
                eye.style.setProperty('--pupil-y', moveY + 'px');
            });
        });

        // Add click effect to button
        document.getElementById('btnGoBack').addEventListener('click', function (e) {
            e.preventDefault(); // Prevent default anchor action
            this.style.transform = 'scale(0.95)';
            setTimeout(() => {
                this.style.transform = '';
                history.back(); // Navigate to previous page
            }, 150);
        });



    </script>

