    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>


    <style>
        body {
            font-family: 'Poppins', sans-serif !important;
            background-color: white !important;
            color: #19476d !important;
        }

        .college-theme .btn-primary {
            background-color: #19476d !important;
            border-color: #19476d !important;
            color: white !important;
        }

        .college-theme a {
            color: #19476d !important;
        }

        .college-theme h1,
        .college-theme h2,
        .college-theme h3,
        .college-theme h4 {
            color: #19476d !important;
        }

        th {
            background: #287f71 !important;
            color: antiquewhite !important;
            border-radius: 0 !important;
            white-space: nowrap;
        }

        td {
            white-space: nowrap;
        }

        .dt-layout-end {
            text-align: end !important;
            margin-bottom: 5px !important;
        }

        .dt-layout-start {
            float: left !important;
        }

        .modal-header {
            background: teal;
            color: white;
        }

        .required-label::after {
            content: " *" !important;
            color: red !important;
        }

        a {
            white-space: nowrap;
        }

        /* Topbar active-student name/class block */
        .parent-name-block {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
            margin-left: .4rem;
        }

            .parent-name-block .parent-name-row {
                display: flex;
                align-items: center;
                gap: .25rem;
                font-weight: 700;
            }

            .parent-name-block .parent-class-text {
                font-size: .72rem;
                color: #8b93a1;
                font-weight: 500;
            }

        .dropdown-student-class {
            font-size: .8rem;
            color: #8b93a1;
        }

        .stu-switch-item {
            display: flex;
            align-items: center;
            gap: .9rem;
            padding: .8rem 1.25rem;
            cursor: pointer;
            border-bottom: 1px solid #eceef2;
            transition: background .12s ease;
        }

            .stu-switch-item:last-child {
                border-bottom: none;
            }

            .stu-switch-item:hover {
                background: #f7f9fc;
            }

            .stu-switch-item.active {
                background: #eef4fb;
            }

            .stu-switch-item .stu-avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                overflow: hidden;
                flex-shrink: 0;
                border: 1px solid #e5e8ee;
            }

                .stu-switch-item .stu-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .stu-switch-item .stu-name {
                font-weight: 600;
                color: #1e2433;
                margin: 0;
                font-size: .92rem;
            }

            .stu-switch-item .stu-class {
                color: #6b7280;
                margin: 0;
                font-size: .8rem;
            }

            .stu-switch-item .stu-check {
                margin-left: auto;
                color: #19476d;
                font-size: 1.1rem;
                display: none;
            }

            .stu-switch-item.active .stu-check {
                display: block;
            }
    </style>


</head>
<body data-menu-color="light" data-sidebar="default">
    <!-- Begin page -->
    <div id="app-layout">


        <!-- Topbar Start -->
        <div class="topbar-custom">
            <div class="container-fluid">
                <div class="d-flex justify-content-between">
                    <ul class="list-unstyled topnav-menu mb-0 d-flex align-items-center">
                        <li>
                            <button class="button-toggle-menu nav-link">
                                <i data-feather="menu" class="noti-icon"></i>
                            </button>
                        </li>
                        <li class="d-none d-lg-block">
                            <h5 class="mb-0"></h5>
                        </li>
                    </ul>

                    <ul class="list-unstyled topnav-menu mb-0 d-flex align-items-center">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">
                                <div class="avatar rounded-circle d-inline-block overflow-hidden" style="width: 40px; height: 40px; ">
                                    <img class="parent-avatar" src="/Upload/default-user.png" alt="Profile" style="width: 40px; height: 40px; vertical-align: top;" />
                                </div>

                                <div class="parent-name-block">
                                    <span class="parent-name-row">
                                        <span id="parent-name"></span>
                                        <i data-feather="chevron-down" class="text-primary" style="width:14px;height:14px;"></i>
                                    </span>
                                    <span class="parent-class-text" id="active-student-class"></span>
                                </div>

                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow p-3" aria-labelledby="userDropdown" style="width: 250px;">
                                <li class="text-center mb-2">
                                    <div class="avatar rounded-circle d-inline-block overflow-hidden" style="width: 40px; height: 40px;">
                                        <img class="parent-avatar" src="/Upload/default-user.png" alt="Profile" style="width: 40px; height: 40px; vertical-align: top;" />
                                    </div>
                                    <div class="fw-bold mt-2" id="dropdown-student-name"></div>
                                    <div class="dropdown-student-class" id="dropdown-student-class"></div>
                                    <div class="text-center mt-1">
                                        <a href="/Parent/Profile">User Profile</a>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <div class="d-flex justify-content-between me-1">
                                        <a id="switch-student-link" class="dropdown-item fw-bold w-50 text-center" href="javascript:void(0);">
                                            <i data-feather="repeat" class="text-primary" style=" height: 20px;"></i>Change
                                        </a>
                                    </div>
                                    <div class="mt-1 shadow-sm mx-1 rounded-2 bg-light">
                                        <a class="dropdown-item fw-bold w-100 text-center" href="#" id="logoutuser">
                                            <i data-feather="log-out" class="me-1 text-danger"></i>Logout
                                        </a>
                                    </div>
                                </li>
                            </ul>


                        </li>
                    </ul>

                </div>

            </div>

        </div>
        <!-- end Topbar -->
        <!-- Left Sidebar Start -->
        <div class="app-sidebar-menu">
            <div class="h-100" data-simplebar>

                <!--- Sidemenu -->
                <div id="sidebar-menu">

                    <div class="logo-box">
                        <a class='logo logo-light fs-3' href="/Parent/Dashboard">
                            CollegeERP
                        </a>
                        <a class='logo logo-dark fs-3' href='/Parent/Dashboard'>
                            CollegeERP
                        </a>
                    </div>

                    <ul id="side-menu">

                        <li class="menu-title">Main Menu</li>

                        <li>
                            <a href="/Parent/Dashboard">
                                <i data-feather="home"></i>
                                <span> Dashboard </span>
                            </a>
                        </li>
                        <li>
                            <a href="#sidebarAuth1" data-bs-toggle="collapse">
                                <i data-feather="briefcase"></i>
                                <span> Faculity Management </span>
                                <span class="menu-arrow"></span>
                            </a>
                            <div class="collapse" id="sidebarAuth1">
                                <ul class="nav-second-level">
                                    <li>
                                        <a class='tp-link' href="/Parent/Timetable">Time Table </a>
                                    </li>
                                    <li>
                                        <a class='tp-link' href="/Parent/Announcement">Announcement </a>
                                    </li>
                                    <li>
                                        <a class='tp-link' href="/Parent/Assignment">Assignment </a>
                                    </li>
                                    <li>
                                        <a class='tp-link' href="/Parent/Parentcommunication">Parent Communication </a>
                                    </li>
                                </ul>
