                            </a>
                        </li>
                        <li>
                            <a href="/Parent/Notice">
                                <i data-feather="edit-3"></i>
                                <span> Notice </span>
                            </a>
                        </li>
                        <li>
                            <a href="/Parent/Result">
                                <i data-feather="calendar"></i>
                                <span>Result</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Parent/Fees">
                                <i data-feather="edit-3"></i>
                                <span> Fees </span>
                            </a>
                        </li>
                        <li>
                            <a href="/Parent/Transport">
                                <i data-feather="edit-3"></i>
                                <span> Transport </span>
                            </a>
                        </li>
                        <li>
                            <a href="/Parent/Hostel">
