                </div>
            </div>
        </div>
        <!-- Left Sidebar End -->
        <!-- Student Switch Modal -->
        <div class="modal fade" id="studentSwitchModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
                <div class="modal-content" style="border:none; border-radius:10px; overflow:hidden;">
                    <div class="modal-header" style="background:#19476d; color:#fff;">
                        <h5 class="modal-title" style="font-weight:700;">Select Student</h5>
