    <!-- END wrapper -->
    <!-- Vendor -->
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/libs/waypoints/lib/jquery.waypoints.min.js"></script>
    <script src="~/assets/libs/jquery.counterup/jquery.counterup.min.js"></script>
    <script src="~/assets/libs/feather-icons/feather.min.js"></script>
    <script src="~/assets/js/sweetalert/sweetalert2@11.js"></script>
    <script src="~/assets/summernote/summernote.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/2.3.0/js/dataTables.min.js"></script>
    <!-- Apexcharts JS -->
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="~/assets/fontawsome/all.min.js"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <!-- for basic area chart -->
    <script src="~/Content/apexcharts.com/samples/assets/stock-prices.js"></script>

    <!-- Widgets Init Js -->
    <script src="~/assets/js/pages/crm-dashboard.init.js"></script>
    <script src="~/assets/libs/datatable/dataTables.min.js"></script>

    <!-- App js-->
    <script src="~/assets/js/app.js"></script>
    <script>
        $("#logoutuser").click(function () {
            Swal.fire({
                icon: "info",
                title: "Do you really want to Logout?",
                showCancelButton: true,
                confirmButtonText: "Logout"
            }).then((result) => {

                if (result.isConfirmed) {
                    location.href = "/Parent/Logout"
                }
            });
        })

        $(document).ready(function () {
            $("#datatable").DataTable()
        })

        $.ajax({
            url: '@Url.Action("GetparentDetails", "parent")',
            type: 'GET',
            success: function (data) {
                if (data) {
                    // Topbar: active student name + class
                    $('#parent-name').text(data.activeStudentName || 'Parent');
                    $('#active-student-class').text(data.activeStudentClass || '');

                    // Dropdown header: active student name + class
                    $('#dropdown-student-name').text(data.activeStudentName || 'Parent');
                    $('#dropdown-student-class').text(data.activeStudentClass || '');

                    feather.replace();

                    $('#parent-profile-link').attr('href', '/parent/parentProfile?id=' + data.parentId);

                    if (data.ProfileImage) {
                        $('.parent-avatar').attr('src', data.ProfileImage);
                    } else {
                        $('.parent-avatar').attr('src', '/Upload/default-user.png');
                    }

                    $('.parent-avatar').attr('title', (data.activeStudentName || 'Parent') + ' ^');
                }
            },
            error: function () {
                $('#parent-name').text("Error loading data.");
                $('.parent-avatar').attr('src', '/assets/images/user-default.png');
            }
        });

        $(".parent-avatar").on("error", function () {
            $('.parent-avatar').attr('src', '/assets/images/user-default.png');
        })

        // Open student switch modal & load children list
        $("#switch-student-link").on("click", function () {
            var studentModal = new bootstrap.Modal(document.getElementById('studentSwitchModal'));
            studentModal.show();
            loadStudentList();
        });

        function loadStudentList() {
            $("#studentSwitchList").html('<div class="text-center text-muted py-4" id="studentSwitchLoading">Loading...</div>');

            $.ajax({
                url: '@Url.Action("GetChildren", "Parent")',
                type: 'GET',
                success: function (res) {
                    if (!res || !res.data || res.data.length === 0) {
                        $("#studentSwitchList").html('<div class="text-center text-muted py-4">No students found.</div>');
                        return;
                    }

                    var html = '';
                    res.data.forEach(function (stu) {
                        var isActive = stu.isActive ? 'active' : '';
                        var photo = stu.photo ? stu.photo : '/Upload/default-user.png';

                        html += '' +
                            '<div class="stu-switch-item ' + isActive + '" data-student-id="' + stu.studentId + '">' +
                                '<div class="stu-avatar"><img src="' + photo + '" alt="' + stu.studentName + '" onerror="this.src=\'/Upload/default-user.png\'"></div>' +
                                '<div>' +
                                    '<p class="stu-name">' + stu.studentName + '</p>' +
                                    '<p class="stu-class">' + (stu.className || '') + '</p>' +
                                '</div>' +
                                '<i class="fa-solid fa-circle-check stu-check"></i>' +
                            '</div>';
                    });

                    $("#studentSwitchList").html(html);
                },
                error: function () {
                    $("#studentSwitchList").html('<div class="text-center text-danger py-4">Failed to load students.</div>');
                }
            });
        }

        // Handle student selection (event delegation, since list is loaded dynamically)
        $(document).on("click", ".stu-switch-item", function () {
            var studentId = $(this).data("student-id");
            var $item = $(this);

            $.ajax({
                url: '@Url.Action("SetActiveStudent", "Parent")',
                type: 'POST',
                data: { studentId: studentId },
                success: function (res) {
                    if (res && res.status) {
                        location.reload(); // reload page so all data reflects new student
                    } else {
                        Swal.fire('Error', 'Could not switch student. Try again.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Something went wrong.', 'error');
                }
            });
        });

    </script>
</body>
</html>