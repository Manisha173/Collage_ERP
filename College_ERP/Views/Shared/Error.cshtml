@{ 
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Page Not Found | College ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Fira+Sans:wght@@200;500&display=swap");

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #0f766e;
            --secondary: #134e4a;
            --accent: #115e59;
            --light: #042f2e;
            --dark: #042f2e;
            --success: #0d9488;
            --teal-50: #f0fdfa;
            --teal-100: #ccfbf1;
            --teal-200: #99f6e4;
            --teal-300: #5eead4;
            --teal-400: #2dd4bf;
            --teal-500: #14b8a6;
            --teal-600: #0d9488;
            --teal-700: #0f766e;
            --teal-800: #115e59;
            --teal-900: #134e4a;
            --teal-950: #042f2e;

            --fs-heading: 56px;
            --fs-text: 32px;
            --fs-button: 22px;
            --fs-icon: 30px;
            --pupil-size: 40px;
            --eye-size: 110px;
            --button-padding: 20px 40px;
        }

        @@media only screen and (max-width: 567px) {
            :root {
                --fs-heading: 36px;
                --fs-text: 24px;
                --fs-button: 18px;
                --fs-icon: 24px;
                --pupil-size: 28px;
                --eye-size: 70px;
                --button-padding: 14px 28px;
            }
        }

        body {
            display: flex;
            min-height: 100vh;
            background: linear-gradient(-45deg, var(--teal-950), var(--teal-900), var(--teal-800), var(--secondary));
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
            color: var(--teal-100);
            font-family: "Fira Sans", sans-serif;
            position: relative;
            overflow: hidden;
        }

        /* Background Animations */
       @@keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0px) rotate(0deg);
            }
            50% {
                transform: translateY(-20px) rotate(180deg);
            }
        }

        @@keyframes floatReverse {
            0%, 100% {
                transform: translateY(0px) rotate(0deg);
            }
            50% {
                transform: translateY(20px) rotate(-180deg);
            }
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 0.3;
            }
            50% {
                opacity: 0.7;
            }
        }

        /* Floating Background Elements */
        .bg-animation {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .floating-shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.1;
        }

        .shape-1 {
            width: 80px;
            height: 80px;
            background: var(--teal-400);
            top: 10%;
            left: 10%;
            animation: float 6s ease-in-out infinite;
        }

        .shape-2 {
            width: 60px;
            height: 60px;
            background: var(--teal-300);
            top: 20%;
            right: 15%;
            animation: floatReverse 8s ease-in-out infinite;
        }

        .shape-3 {
            width: 100px;
            height: 100px;
            background: var(--teal-500);
            bottom: 20%;
            left: 20%;
            animation: float 10s ease-in-out infinite;
        }

        .shape-4 {
            width: 40px;
            height: 40px;
            background: var(--teal-200);
            bottom: 30%;
            right: 10%;
            animation: floatReverse 7s ease-in-out infinite;
        }

        .shape-5 {
            width: 120px;
            height: 120px;
            background: var(--teal-600);
            top: 50%;
            left: 5%;
            animation: pulse 4s ease-in-out infinite;
        }

        .container {
            display: flex;
            flex-direction: column;
            align-items: center;
            row-gap: 40px;
            text-align: center;
            padding: 40px 20px;
            position: relative;
            z-index: 10;
        }

        .error-page {
            margin: auto;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            width: 100%;
        }

        .error-page__heading-title {
            text-transform: capitalize;
            font-size: var(--fs-heading);
            font-weight: 500;
            color: white;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 10px;
        }

        .error-page__heading-desciption {
            font-size: var(--fs-text);
            font-weight: 300;
            color: white;
/*            margin-bottom: 20px;*/
        }

        .error-page__button {
            color: var(--teal-100);
            text-decoration: none;
            border: 2px solid var(--primary);
            font-size: var(--fs-button);
            font-weight: 400;
            padding: var(--button-padding);
            border-radius: 25px;
            box-shadow: 0px 8px 0px -2px var(--primary);
            transition: all 0.3s ease-in-out;
            text-transform: capitalize;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(10px);
            display: inline-block;
        }

        .error-page__button:hover {
            box-shadow: 0px 4px 0px -2px var(--primary);
            background: var(--primary);
            color: white;
            transform: translateY(4px) scale(1.05);
        }

        .eyes {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        /* Black and White Googly Eyes */
        .eye {
            width: var(--eye-size);
            height: var(--eye-size);
            background-color: white;
            border: 4px solid black;
            border-radius: 50%;
            display: grid;
            place-items: center;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
            position: relative;
            cursor: pointer;
        }

        .eye__pupil {
            width: var(--pupil-size);
            height: var(--pupil-size);
            background-color: black;
            border-radius: 50%;
            transition: transform 0.1s ease-out;
            position: relative;
        }

        /* Interactive Eye Movement */
        .eye:hover .eye__pupil {
            animation: blink 0.5s ease-in-out;
        }

        @@keyframes blink {
            0%, 100% {
                transform: scaleY(1);
            }
            50% {
                transform: scaleY(0.1);
            }
        }

        /* College ERP Branding */
        .college-info {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 14px;
            text-align: center;
        }

        /* Additional animations for pupils when not interactive */
        @@keyframes movePupil {
            0%, 100% {
                transform: translate(0, 0);
            }
            25% {
                transform: translate(-12px, -8px);
            }
            50% {
                transform: translate(12px, 10px);
            }
            75% {
                transform: translate(-10px, 12px);
            }
        }

        .eye__pupil--animated {
            animation: movePupil 3s infinite ease-in-out;
        }

        .eye__pupil--right {
            animation-direction: reverse;
        }
    </style>
</head>
<body>
    <!-- Background Animation Elements -->
    <div class="bg-animation">
        <div class="floating-shape shape-1"></div>
        <div class="floating-shape shape-2"></div>
        <div class="floating-shape shape-3"></div>
        <div class="floating-shape shape-4"></div>
        <div class="floating-shape shape-5"></div>
    </div>

    <main class="error-page">
        <div class="container">
            <div class="eyes">
                <div class="eye" id="leftEye">
                    <div class="eye__pupil eye__pupil--animated" id="leftPupil"></div>
                </div>
                <div class="eye" id="rightEye">
                    <div class="eye__pupil eye__pupil--animated eye__pupil--right" id="rightPupil"></div>
                </div>
            </div>

            <div class="error-page__heading">
                <h1 class="error-page__heading-title">Looks like you're lost</h1>
                <p class="error-page__heading-desciption" style="margin-bottom:0px;">404 Error - Page Not Found</p>

            </div>

            <a class="error-page__button" role="button" id="backbtn" aria-label="back to home" title="back to home">
                Back to Home
            </a>
        </div>
    </main>
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Interactive googly eyes that follow mouse cursor
        document.addEventListener('mousemove', function (e) {
            const eyes = document.querySelectorAll('.eye');

            eyes.forEach(eye => {
                const pupil = eye.querySelector('.eye__pupil');
                const eyeRect = eye.getBoundingClientRect();
                const eyeCenterX = eyeRect.left + eyeRect.width / 2;
                const eyeCenterY = eyeRect.top + eyeRect.height / 2;

                const deltaX = e.clientX - eyeCenterX;
                const deltaY = e.clientY - eyeCenterY;
                const angle = Math.atan2(deltaY, deltaX);
                const distance = Math.min(15, Math.sqrt(deltaX * deltaX + deltaY * deltaY) / 8);

                const pupilX = Math.cos(angle) * distance;
                const pupilY = Math.sin(angle) * distance;

                pupil.style.transform = `translate(${pupilX}px, ${pupilY}px)`;
                pupil.classList.remove('eye__pupil--animated');
            });
        });

        // Reset to animated state when mouse leaves the page
        document.addEventListener('mouseleave', function () {
            const pupils = document.querySelectorAll('.eye__pupil');
            pupils.forEach(pupil => {
                pupil.style.transform = '';
                pupil.classList.add('eye__pupil--animated');
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#backbtn').on('click', function () {
                debugger;
                if (@User.IsInRole("admin").ToString().ToLower()) {
                    location.href = '/admin/dashboard';
                } else if (@User.IsInRole("warden").ToString().ToLower()) {
                    location.href = '/warden/dashboard';
                } else if (@User.IsInRole("librarian").ToString().ToLower()) {
                    location.href = '/librarian/dashboard';
                } else if (@User.IsInRole("security").ToString().ToLower()) {
                    location.href = '/security/dashboard';
                }else if (@User.IsInRole("superadmin").ToString().ToLower()) {
                    location.href = '/superadmin/dashboard';
                }else if (@User.IsInRole("teacher").ToString().ToLower()) {
                    location.href = '/teacher/dashboard';
                }
            });
        });
    </script>
</body>
</html>