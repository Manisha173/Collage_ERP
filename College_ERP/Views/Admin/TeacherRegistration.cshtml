                                            <input type="text" value="@(ViewBag?.teacher?.TwelfthPercent)" name="TwelfthPercent" class="form-control" placeholder="Enter Percentage" />
                                        </div>
                                        <div class="mb-3">
                                            <label>Marksheet</label>
