                                        </div>
                                        <div class="mb-3">
                                            <label>Stream</label>
                                            <input type="text" value="@(ViewBag?.teacher?.PostGraduationStream)" name="PostGraduationStream" class="form-control" placeholder="Enter Post Graduation Stream" />
                                        </div>
                                        <div class="mb-3">
                                            <label>Year</label>
                                            <input type="text" value="@(ViewBag?.teacher?.PostGraduationYear)" name="PostGraduationYear" class="form-control" placeholder="Enter Post Graduation Year" />
                                        </div>
                                        <div class="mb-3">
                                            <label>Percentage</label>
                                            <input type="text" value="@(ViewBag?.teacher?.PostGraduationPercent)" name="PostGraduationPercent" class="form-control" placeholder="Enter Percentage" />
