<script>
    document.getElementById('BankAccountNumber').addEventListener('input', function () {
        const input = this;
        const errorSpan = document.getElementById('BankAccountNumberError');

        if (input.validity.valid) {
            errorSpan.textContent = '';
        } else if (input.validity.valueMissing) {
            errorSpan.textContent = 'Account number is required.';
        } else if (input.validity.patternMismatch) {
            errorSpan.textContent = 'Account number must be 9 to 18 digits.';
        } else {
            errorSpan.textContent = 'Invalid input.';
        }
    });

    let isValid = true;
    $("#BankAccountNumber , #ReenterBankAccountNumber").on("blur", function () {
        //$("#ReenterBankAccountNumber").attr("required",true)
        if (Number($("#BankAccountNumber").val()) != Number($("#ReenterBankAccountNumber").val()) && $("#ReenterBankAccountNumber").val()!="")
        {
            isValid = false;
            Swal.fire({
                icon: 'info',
                title: 'Warning',
                text: "Account number did not match."
            });
        } else {
            isValid = true;
        }
    })

    $('#teacherForm').on('submit', function (e) {
        e.preventDefault(); 
        if (!isValid) {
            return
        }

        Swal.fire({
            title: "Please Wait..!",
            html: "your request are under process",
            didOpen: () => {
                Swal.showLoading();
            }
        })

        var formData = new FormData(this); 

        if ($("#ExperienceDocument").get(0).files.length > 0) {
            formData.append("ExperienceDocument", $("#ExperienceDocument").get(0).files[0])
        }
        if ($("#TenthMarksheet").get(0).files.length > 0) {
            formData.append("TenthMarksheet", $("#TenthMarksheet").get(0).files[0])
        }
        if ($("#GraduationMarksheet").get(0).files.length > 0) {
            formData.append("GraduationMarksheet", $("#GraduationMarksheet").get(0).files[0])
        }
        if ($("#TwelfthMarksheet").get(0).files.length > 0) {
            formData.append("TwelfthMarksheet", $("#TwelfthMarksheet").get(0).files[0])
        }
        if ($("#PostGraduationMarksheet").get(0).files.length > 0) {
            formData.append("PostGraduationMarksheet", $("#PostGraduationMarksheet").get(0).files[0])
        }
        if ($("#OtherDiplomaMarksheet").get(0).files.length > 0) {
            formData.append("OtherDiplomaMarksheet", $("#OtherDiplomaMarksheet").get(0).files[0])
        }
        if ($("#profileIamge").get(0).files.length > 0) {
            formData.append("profileImage", $("#profileIamge").get(0).files[0])
        }

        $.ajax({
            url: '/Admin/TeacherRegistration',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                console.log(res)
                if (res.success) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: res.message
                    }).then(() => {

                        if (res.type == "update" || res.type =="add") location.href = "/admin/TeacherRegistrationList"
                        $("#teacherForm")[0].reset()
                    })
                  
           
                } else {
                    console.log('Missing', res.invalidFields);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: res.message
                    });
                }
            },
            error: function (xhr) {

                let message = "Something went wrong";

                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;  
                }
                else if (xhr.responseText) {
                    try {
                        let parsed = JSON.parse(xhr.responseText);
                        if (parsed.message) {
                            message = parsed.message;   
                        }
                    } catch (e) {
                        message = xhr.responseText;
                    }
                }

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: message
                });
            }
        });
    });
    $(function () {
        $('.panval').on('input', function () {
            let value = $(this).val().toUpperCase();
            $(this).val(value);

            const panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;

            if (value.length < 10) {
                $('.panError').text('PAN must be 10 characters long.');
            } else if (!panRegex.test(value)) {
                $('.panError').text('PAN must be in format: 5 letters, 4 digits, 1 letter (e.g., ABCDE1234F)');
            } else {
                $('.panError').text('');
            }
        });
    });

</script>