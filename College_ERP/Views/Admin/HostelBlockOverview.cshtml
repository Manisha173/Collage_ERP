<script>
    function getWardenByBlock(blockId) {
        if (!blockId) return;

        const wardenDisplay = document.getElementById('wardenDisplay');
        const wardenName = document.getElementById('wardenName');
        const wardenSection = document.getElementById('wardenSection');

        wardenSection.style.display = 'block';
        // Show loading state
        wardenDisplay.className = 'warden-display empty';
        wardenName.innerHTML = 'Loading...';

        $.ajax({
            type: "GET",
            url: '/Admin/GetWardenByBlock',
            data: { blockId: blockId },
            success: function (response) {
                if (response.success && response.wardenName) {
                    wardenDisplay.className = 'warden-display';
                    wardenName.innerHTML = '<i class="fas fa-user-tie me-2"></i>' + response.wardenName;
                } else {
                    wardenDisplay.className = 'warden-display empty';
                    wardenName.innerHTML = '<i class="fas fa-user-slash me-2"></i>Not Assigned';
                }
            },
            error: function () {
                wardenDisplay.className = 'warden-display empty';
                wardenName.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Error retrieving warden';
            }
        });
    }

        $(document).ready(function () {
            $('#blockDropdown').on('change', function () {
                const blockId = $(this).val();

                if (blockId) {
                    $.ajax({
                        url: '/admin/GetBlockOverviewData',
                        type: 'GET',
                        data: { blockId: blockId },
                        success: function (res) {
                            $('#floorCount').text(res.totalFloors || '0');
                            $('#roomCount').text(res.totalRooms || '0');
                            $('#bedCount').text(res.totalBeds || '0');
                            $('#occupiedBedCount').text(res.occupiedBeds || '0');
                            $('#remainingBedCount').text(res.remainingBeds || '0');
                            $('#nonacCommonCount').text(res.nonACRoomNonAttachedBathroom || '0');
                            $('#acCommonCount').text(res.ACRoomNonAttachedBathroom || '0');
                            $('#nonacAttachedCount').text(res.nonACRoomAttachedBathroom || '0');
                            $('#acAttachedCount').text(res.ACRoomAttachedBathroom || '0');
                        },
                        error: function () {
                            Swal.fire("Error", "Could not fetch block data.", "error");
                        }
                    });
                }
            });
        });         
</script>



