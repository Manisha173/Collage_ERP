
@{
    ViewBag.Title = "WardenProfile";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<style>
    :root {
  --primary: #0f766e;
  --secondary: #134e4a;
  --accent: #115e59;
  --light: #042f2e;
  --dark: #042f2e;
  --success: #0d9488;
  --teal-50: #f0fdfa;
  --teal-100: #ccfbf1;
  --teal-200: #99f6e4;
  --teal-300: #5eead4;
  --teal-400: #2dd4bf;
  --teal-500: #14b8a6;
  --teal-600: #0d9488;
  --teal-700: #0f766e;
  --teal-800: #115e59;
  --teal-900: #134e4a;
  --teal-950: #042f2e;
}


.profile-container {
  max-width: 1200px;
  background-color: #fff;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(15, 118, 110, 0.15);
  padding: 40px;
  position: relative;
  overflow: hidden;
  background:white !important;
}

.profile-container::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
}

.profile-header {
  text-align: center;
  margin-bottom: 40px;
  padding-bottom: 20px;
  border-bottom: 1px solid #e9ecef;
}

.profile-header h2 {
  color: var(--secondary);
  font-weight: 700;
  margin-bottom: 10px;
}

.profile-header p {
  font-size: 1.1rem;
  color: #6c757d;
}

    .section-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: white;
        margin-bottom: 20px;
        padding: 15px 0;
        border-bottom: 3px solid var(--primary);
        background: linear-gradient(135deg, var(--primary), var(--teal-600));
        padding-left: 15px;
        border-radius: 5px;
    }
   

.profile-image-container {
  position: relative;
  display: inline-block;
  margin-bottom: 20px;
}

.profile-image {
  border: 4px solid var(--teal-100);
  box-shadow: 0 8px 25px rgba(15, 118, 110, 0.2);
  transition: transform 0.3s ease;
  object-fit: cover;
}

.profile-image:hover {
  transform: scale(1.05);
  border-color: var(--teal-200);
}

.profile-image-overlay {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background: var(--primary);
  color: white;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  box-shadow: 0 2px 10px rgba(15, 118, 110, 0.3);
}

.info-card {
  background: var(--teal-50);
  border-radius: 10px;
  padding: 15px;
  height: 100%;
  border-left: 4px solid var(--primary);
  transition: all 0.3s ease;
}



.info-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.info-label {
  font-weight: 600;
  color: var(--accent);
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.info-label i {
  color: var(--primary);
}

.info-value {
  color: var(--secondary);
  font-size: 1rem;
  font-weight: 500;
  word-break: break-word;
}

.document-link {
  color: var(--primary);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
}

.document-link:hover {
  color: var(--teal-600);
  text-decoration: underline;
  transform: translateX(5px);
}

.btn {
  border-radius: 25px;
  padding: 10px 25px;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
}

.btn-primary {
  background: linear-gradient(45deg, var(--primary), var(--secondary));
  color: white;
  box-shadow: 0 4px 15px rgba(15, 118, 110, 0.3);
}

.btn-primary:hover {
  background: linear-gradient(45deg, var(--teal-600), var(--accent));
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(15, 118, 110, 0.4);
}

.btn-outline-secondary {
  border: 2px solid var(--accent);
  color: var(--accent);
  background: transparent;
}

.btn-outline-secondary:hover {
  background: var(--accent);
  color: white;
  transform: translateY(-2px);
  border-color: var(--accent);
}

.image-error {
  background: linear-gradient(135deg, var(--teal-50), var(--teal-100));
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 3rem;
  border: 2px dashed var(--teal-200);
}

/* Icon colors */
.text-primary {
  color: var(--primary) !important;
}

.fas {
  color: var(--primary);
}

/* Responsive Design */
@@media (max-width: 768px) {
  .profile-container {
    margin: 20px;
    padding: 20px;
    border-radius: 15px;
  }

  .profile-image {
    width: 120px;
    height: 120px;
  }

    

  .info-card {
    margin-bottom: 15px;
  }

  .btn {
    width: 100%;
    margin-bottom: 10px;
  }
}

@@media (max-width: 576px) {
  .profile-header h2 {
    font-size: 1.5rem;
  }

  .profile-header p {
    font-size: 1rem;
  }

  .info-label {
    font-size: 0.8rem;
  }

  .info-value {
    font-size: 0.9rem;
  }
}

/* Animation for loading */
@@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.info-card {
  animation: fadeInUp 0.6s ease forwards;
}

.info-card:nth-child(1) {
  animation-delay: 0.1s;
}
.info-card:nth-child(2) {
  animation-delay: 0.2s;
}
.info-card:nth-child(3) {
  animation-delay: 0.3s;
}
.info-card:nth-child(4) {
  animation-delay: 0.4s;
}

/* Additional teal theme enhancements */
.section-title i {
  color: var(--primary);
}

.profile-header i {
  color: var(--primary);
}

/* Ripple effect for buttons */
.btn {
  position: relative;
  overflow: hidden;
}

.ripple {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0);
  animation: ripple-animation 0.6s linear;
  pointer-events: none;
}

@@keyframes ripple-animation {
  to {
    transform: scale(4);
    opacity: 0;
  }
}

/* Focus states with teal theme */
.btn:focus {
  box-shadow: 0 0 0 0.2rem rgba(15, 118, 110, 0.25);
}

.document-link:focus {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
  border-radius: 4px;
}

/* Enhanced hover states */
.profile-container:hover::before {
  background: linear-gradient(90deg, var(--teal-600), var(--teal-700));
}
    .section-title {
        padding: 6px 10px !important;
        font-size: 16px !important;
        font-weight: 600;
        line-height: 1.2;
        min-height: 36px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .section-title i {
            font-size: 14px !important;
            margin-right: 0 !important;
        }
    .compact-profile-header {
        padding: 9px 14px !important;
        border-radius: 8px !important;
    }

        .compact-profile-header h2 {
            font-size: 23px !important;
            line-height: 1.2 !important;
            margin-bottom: 3px !important;
        }

            .compact-profile-header h2 i {
                font-size: 17px !important;
            }

        .compact-profile-header p {
            font-size: 13px !important;
            line-height: 1.2 !important;
        }
</style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Warden Profile</title>
   
  

    <div class="content-page">
        <div class="container-fluid pt-4">
            <div class="profile-container">
                <!-- Profile Header -->
                <div class="profile-header compact-profile-header">
                    <h2 class="mb-1">
                        <i class="fas fa-user-shield me-1 text-primary"></i>
                        Warden Profile
                    </h2>

                    <p class="text-muted mb-0">
                        Personal, Academic & Professional Details
                    </p>
                </div>

                <!-- Personal Information Section -->
                <div class="section-title">
                    <i class="fas fa-user me-2"></i>
                    Personal Information
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="row g-4">
                            <!-- Profile Picture Column -->
                            <div class="col-md-3 text-center">
                                <div class="profile-image-container">
                                    <img src="@(string.IsNullOrEmpty(Model.ProfilePics)?"": Url.Content(Model.ProfilePics))"
                                         class="profile-image rounded-circle shadow-sm"
                                         width="170"
                                         height="170"
                                         alt="Profile Picture"
                                         onerror="handleImageError(this)" />
                                   
                                </div>
                            </div>

                            <!-- Information Column -->
                            <div class="col-md-9">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-user me-2"></i>Name:
                                                </span>
                                                <span class="info-value">@Model.Name</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-envelope me-2"></i>Email:
                                                </span>
                                                <span class="info-value">@Model.EmailId</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-phone me-2"></i>Mobile:
                                                </span>
                                                <span class="info-value">@Model.MobileNo</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-calendar me-2"></i>Date of Birth:
                                                </span>
                                                <span class="info-value">@(Model.DOBstring)</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-venus-mars me-2"></i>Gender:
                                                </span>
                                                <span class="info-value">@Model.Gender</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-map-marker-alt me-2"></i>State:
                                                </span>
                                                <span class="info-value">@Model.stateName</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-city me-2"></i>City:
                                                </span>
                                                <span class="info-value">@Model.cityName</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-building me-2"></i>Block Name:
                                                </span>
                                                <span class="info-value">@Model.BlockName1</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-home me-2"></i>Address:
                                                </span>
                                                <span class="info-value">@Model.Address</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="info-card">
                                            <div class="info-row">
                                                <span class="info-label">
                                                    <i class="fas fa-file-alt me-2"></i>Document:
                                                </span>
                                                <span class="info-value">
                                                    <a href="@(string.IsNullOrEmpty(Model.Document)?"":Model.Document)" class="document-link" title="View Document">
                                                        <i class="fas fa-eye me-1"></i>
                                                        View Document
                                                    </a>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

               
            </div>
        </div>
    </div>

   <script>
       // Handle image error
       function handleImageError(img) {
           img.style.display = "none"

           // Create a placeholder div
           const placeholder = document.createElement("div")
           placeholder.className = "profile-image rounded-circle shadow-sm image-error"
           placeholder.style.width = "170px"
           placeholder.style.height = "170px"
           placeholder.innerHTML = '<i class="fas fa-user"></i>'

           // Insert the placeholder after the image
           img.parentNode.insertBefore(placeholder, img.nextSibling)
       }

       // Add smooth scrolling and interactive effects
       document.addEventListener("DOMContentLoaded", () => {
           // Add hover effects to info cards
           const infoCards = document.querySelectorAll(".info-card")

           infoCards.forEach((card) => {
               card.addEventListener("mouseenter", function () {
                   this.style.transform = "translateY(-5px)"
               })

               card.addEventListener("mouseleave", function () {
                   this.style.transform = "translateY(0)"
               })
           })

           // Add click effect to buttons
           const buttons = document.querySelectorAll(".btn")

           buttons.forEach((button) => {
               button.addEventListener("click", function (e) {
                   // Create ripple effect
                   const ripple = document.createElement("span")
                   const rect = this.getBoundingClientRect()
                   const size = Math.max(rect.width, rect.height)
                   const x = e.clientX - rect.left - size / 2
                   const y = e.clientY - rect.top - size / 2

                   ripple.style.width = ripple.style.height = size + "px"
                   ripple.style.left = x + "px"
                   ripple.style.top = y + "px"
                   ripple.classList.add("ripple")

                   this.appendChild(ripple)

                   setTimeout(() => {
                       ripple.remove()
                   }, 600)
               })
           })

           // Add loading animation
           const profileContainer = document.querySelector(".profile-container")
           profileContainer.style.opacity = "0"
           profileContainer.style.transform = "translateY(50px)"

           setTimeout(() => {
               profileContainer.style.transition = "all 0.8s ease"
               profileContainer.style.opacity = "1"
               profileContainer.style.transform = "translateY(0)"
           }, 100)
       })

       // Print functionality
       document.querySelector(".btn-outline-secondary").addEventListener("click", () => {
           window.print()
       })

       // Edit functionality (placeholder)
       document.querySelector(".btn-primary").addEventListener("click", () => {
           alert("Edit functionality would be implemented here")
       })

   </script>


