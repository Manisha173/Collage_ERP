@{
    ViewBag.Title = "Student Profile";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<style>
    :root {
  --primary: #0f766e;
  --secondary: #134e4a;
  --accent: #115e59;
  --light: #042f2e;
  --dark: #042f2e;
  --success: #0d9488;
  --teal-50: #f0fdfa;
  --teal-100: #ccfbf1;
  --teal-200: #99f6e4;
  --teal-300: #5eead4;
  --teal-400: #2dd4bf;
  --teal-500: #14b8a6;
  --teal-600: #0d9488;
  --teal-700: #0f766e;
  --teal-800: #115e59;
  --teal-900: #134e4a;
  --teal-950: #042f2e;
}


/* Header Styles */
.profile-header {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white !important;
  padding: 2rem;
  border-radius: 15px;
  box-shadow: 0 8px 25px rgba(15, 118, 110, 0.2);
}

.page-title {
  font-weight: 700;
  margin: 0;
}

.action-buttons .btn {
  border-radius: 25px;
  padding: 8px 20px;
  font-weight: 500;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(45deg, var(--teal-400), var(--teal-500));
  border: none;
  color: white;
}

.btn-primary:hover {
  background: linear-gradient(45deg, var(--teal-500), var(--teal-600));
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(20, 184, 166, 0.3);
}

.btn-outline-primary {
  border: 2px solid var(--teal-400);
  color: var(--teal-400);
  background: transparent;
}

.btn-outline-primary:hover {
  background: var(--teal-400);
  color: white;
  transform: translateY(-2px);
}

/* Main Profile Card */
.main-profile-card {
  background: white;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(15, 118, 110, 0.1);
  overflow: hidden;
  position: relative;
}

.main-profile-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: linear-gradient(90deg, var(--primary), var(--teal-400), var(--secondary));
}

/* Student Overview */
.student-overview {
  background: linear-gradient(135deg, var(--teal-50), white);
  padding: 2.5rem;
  border-bottom: 1px solid var(--teal-100);
}

.profile-image-container {
  position: relative;
  display: inline-block;
  margin-bottom: 1.5rem;
}

.profile-image {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  border: 4px solid var(--teal-200);
  box-shadow: 0 8px 25px rgba(15, 118, 110, 0.2);
  object-fit: cover;
  transition: all 0.3s ease;
}

.profile-image:hover {
  transform: scale(1.05);
  border-color: var(--teal-300);
}

.profile-badge {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background: var(--primary);
  color: white;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  box-shadow: 0 4px 15px rgba(15, 118, 110, 0.3);
}

.student-basic-info {
  margin-top: 1rem;
}

.student-name {
  color: var(--secondary);
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.class-info {
  color: var(--accent);
  font-weight: 500;
  margin-bottom: 1rem;
}

.student-id .badge {
  background: var(--primary) !important;
  font-size: 0.9rem;
  padding: 0.5rem 1rem;
}

/* Quick Stats */
.quick-stats {
  margin-top: 1rem;
}

.stat-card {
  background: white;
  border-radius: 15px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  box-shadow: 0 4px 15px rgba(15, 118, 110, 0.1);
  transition: all 0.3s ease;
  height: 100%;
}

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(15, 118, 110, 0.15);
}

.stat-icon {
  background: linear-gradient(135deg, var(--teal-100), var(--teal-200));
  color: var(--primary);
  width: 50px;
  height: 50px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
}

.stat-info h6 {
  color: var(--accent);
  font-weight: 600;
  margin-bottom: 0.25rem;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stat-info p {
  color: var(--secondary);
  font-weight: 500;
  margin: 0;
  font-size: 1rem;
}

/* Profile Sections */
.profile-sections {
  padding: 0;
}

.info-section {
  border-bottom: 1px solid var(--teal-100);
}

.info-section:last-child {
  border-bottom: none;
}

    .section-header {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color:white !important;
        border-radius:15px;
        padding: 1.5rem 2.5rem;
        border-bottom: 1px solid var(--teal-100);
    }

.section-header h4 {
  font-weight: 700;
  margin: 0;
  font-size: 1.3rem;
}



.section-content {
  padding: 2rem 2.5rem;
}

/* Info Items */
.info-item {
  background: var(--teal-50);
  border-radius: 10px;
  padding: 1rem;
  border-left: 4px solid var(--primary);
  transition: all 0.3s ease;
  height: 100%;
}

.info-item:hover {
  background: var(--teal-100);
  transform: translateX(5px);
  border-left-color: var(--teal-600);
}

.info-item label {
  display: block;
  color: var(--accent);
  font-weight: 600;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.5rem;
}

.info-item span {
  color: var(--secondary);
  font-weight: 500;
  font-size: 1rem;
  display: block;
}

/* Parent Cards */
.parent-card {
  background: white;
  border-radius: 15px;
  box-shadow: 0 6px 20px rgba(15, 118, 110, 0.1);
  overflow: hidden;
  transition: all 0.3s ease;
  height: 100%;
}

.parent-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(15, 118, 110, 0.15);
}

.parent-header {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.parent-header i {
  font-size: 1.5rem;
}

.parent-header h5 {
  margin: 0;
  font-weight: 600;
}

.parent-info {
  padding: 1.5rem;
}

.parent-info .info-item {
  background: var(--teal-50);
  margin-bottom: 1rem;
  border-left: 3px solid var(--teal-300);
}

.parent-info .info-item:last-child {
  margin-bottom: 0;
}



.performance-bar {
  background: var(--teal-100);
  height: 30px;
  border-radius: 15px;
  position: relative;
  overflow: hidden;
}

.performance-fill {
  background: linear-gradient(90deg, var(--teal-400), var(--teal-500));
  height: 100%;
  border-radius: 15px;
  transition: width 1s ease;
  position: relative;
}

.performance-text {
  position: absolute;
  top: 50%;
  right: 15px;
  transform: translateY(-50%);
  color: white;
  font-weight: 600;
  font-size: 0.9rem;
}

/* Document Cards */
.document-card {
  background: white;
  border-radius: 15px;
  box-shadow: 0 6px 20px rgba(15, 118, 110, 0.1);
  overflow: hidden;
  transition: all 0.3s ease;
  height: 100%;
}

.document-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(15, 118, 110, 0.15);
}

.document-header {
  background: linear-gradient(135deg, var(--teal-100), var(--teal-200));
  color: var(--primary);
  padding: 1rem;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.document-header i {
  font-size: 1.2rem;
}

.document-header h6 {
  margin: 0;
  font-weight: 600;
}

.document-content {
  padding: 1.5rem;
  text-align: center;
}

.document-image {
  width: 120px;
  height: 120px;
  border-radius: 10px;
  object-fit: cover;
  border: 2px solid var(--teal-200);
}

.document-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
}

.document-placeholder i {
  font-size: 3rem;
  color: var(--primary);
}

.document-placeholder p {
  color: var(--accent);
  font-weight: 500;
  margin: 0;
}

/* Error States */
.image-error {
  background: linear-gradient(135deg, var(--teal-50), var(--teal-100));
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 2rem;
  border: 2px dashed var(--teal-200);
  border-radius: 50%;
}

.document-error {
  background: linear-gradient(135deg, var(--teal-50), var(--teal-100));
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 2rem;
  border: 2px dashed var(--teal-200);
  border-radius: 10px;
  width: 120px;
  height: 120px;
}

/* Responsive Design */
@@media (max-width: 768px) {
  .profile-header {
    padding: 1.5rem;
  }

  .profile-header .d-flex {
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .action-buttons {
    width: 100%;
  }

  .action-buttons .btn {
    width: 48%;
  }

  .student-overview {
    padding: 1.5rem;
  }

  .section-content {
    padding: 1.5rem;
  }

  .stat-card {
    margin-bottom: 1rem;
  }

  .parent-card {
    margin-bottom: 1.5rem;
  }
}

@@media (max-width: 576px) {
  .profile-image {
    width: 120px;
    height: 120px;
  }

  .stat-card {
    padding: 1rem;
  }

  .stat-icon {
    width: 40px;
    height: 40px;
    font-size: 1rem;
  }

  .action-buttons .btn {
    width: 100%;
    margin-bottom: 0.5rem;
  }
}

/* Animation */
@@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.info-section {
  animation: fadeInUp 0.6s ease forwards;
}

.info-section:nth-child(1) {
  animation-delay: 0.1s;
}
.info-section:nth-child(2) {
  animation-delay: 0.2s;
}
.info-section:nth-child(3) {
  animation-delay: 0.3s;
}
.info-section:nth-child(4) {
  animation-delay: 0.4s;
}

</style>
    <div class="content-page">
        <div class="container-fluid py-4">
            <!-- Header Section -->
            <div class="profile-header mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="page-title mb-1 text-light h2" style="color:white;">
                            <i class="fas fa-user-graduate me-2"></i>
                            Student Profile
                        </h2>
                        <p class="mb-0 text-light">Complete academic and personal information</p>
                    </div>
                    <div class="action-buttons">
                        <a href="@Url.Action("StudentRegistration", "admin", new { id = Model.StudentId })" class="btn btn-primary me-2">
                            <i class="bi bi-pencil-square me-1"></i> Edit
                        </a>
                        <a href="@Url.Action("StudentRegistrationList", "admin")" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Profile Card -->
            <div class="row">
                <div class="col-lg-12">
                    <div class="main-profile-card">
                        <!-- Student Overview Section -->
                        <div class="student-overview">
                            <div class="row align-items-center">
                                <div class="col-md-3 text-center">
                                    <div class="profile-image-container">
                                        <img src="@Url.Content(Model.StudentPhotos)"
                                             class="profile-image"
                                             alt="Student Photo"
                                             onerror="handleImageError(this, 'student')" />
                                        <div class="profile-badge">
                                            <i class="fas fa-graduation-cap"></i>
                                        </div>
                                    </div>
                                    <div class="student-basic-info">
                                        <h4 class="student-name">@Model.StudentName</h4>
                                        <p class="class-info">@Model.ClassName - @Model.SectionName</p>
                                        
                                    </div>
                                </div>

                                <div class="col-md-9">
                                    <div class="quick-stats">
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <div class="stat-card">
                                                    <div class="stat-icon">
                                                        <i class="fas fa-calendar-alt"></i>
                                                    </div>
                                                    <div class="stat-info">
                                                        <h6>Admission Date</h6>
                                                        <p>@Model.DateOfAdmission.ToString("dd/MM/yyyy")</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="stat-card">
                                                    <div class="stat-icon">
                                                        <i class="fas fa-birthday-cake"></i>
                                                    </div>
                                                    <div class="stat-info">
                                                        <h6>Date of Birth</h6>
                                                        <p>@Model.DOB.ToString("dd/MM/yyyy")</p>
                                                    </div>
                                                </div>
                                            </div>
                                           
                                            <div class="col-md-4">
                                                <div class="stat-card">
                                                    <div class="stat-icon">
                                                        <i class="fas fa-phone"></i>
                                                    </div>
                                                    <div class="stat-info">
                                                        <h6>Contact</h6>
                                                        <p>@Model.MobileNo</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Detailed Information Sections -->
                        <div class="profile-sections">
                            <!-- Personal Information -->
                            <div class="info-section">
                                <div class="section-header">
                                    <h4><i class="fas fa-user me-2"></i>Personal Information</h4>
                                </div>
                                <div class="section-content">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Admission Number</label>
                                                <span>@Model.AdmissionNo</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Email Address</label>
                                                <span>@Model.StudentEmail</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Gender</label>
                                                <span> @Model.Gender</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Religion</label>
                                                <span>@Model.Religion</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Caste</label>
                                                <span>@Model.Caste</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Mother Tongue</label>
                                                <span>@Model.MotherTongue</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Nationality</label>
                                                <span>@Model.Nationality</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Aadhar Number</label>
                                                <span>@Model.AadharNo</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Place of Birth</label>
                                                <span> @Model.PlaceOfBirth</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>State</label>
                                                <span>@Model.StateName</span>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="info-item">
                                                <label>Hobbies</label>
                                                <span>@(string.IsNullOrEmpty(Model.Hobbies)?"N/A": Model.Hobbies)</span>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="info-item">
                                                <label>Current Address</label>
                                                <span>@Model.CurrentAddress</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Parent Information -->
                            <div class="info-section">
                                <div class="section-header">
                                    <h4><i class="fas fa-users me-2"></i>Parent Information</h4>
                                </div>
                                <div class="section-content">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="parent-card father-card">
                                                <div class="parent-header">
                                                    <i class="fas fa-male"></i>
                                                    <h5>Father Details</h5>
                                                </div>
                                                <div class="parent-info">
                                                    <div class="info-item">
                                                        <label>Name</label>
                                                        <span>@Model.FatherName</span>
                                                    </div>
                                                    <div class="info-item">
                                                        <label>Qualification</label>
                                                        <span>@Model.FatherQualification</span>
                                                    </div>
                                                    <div class="info-item">
                                                        <label>Occupation</label>
                                                        <span>@Model.FatherOccupation</span>
                                                    </div>
                                                    <div class="info-item">
                                                        <label>Office Phone</label>
                                                        <span>@Model.FatherOfficeMobileNo</span>
                                                    </div>
                                                    <div class="info-item">
                                                        <label>Office Address</label>
                                                        <span>@Model.FatherOfficeAddress</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="parent-card mother-card">
                                                <div class="parent-header">
                                                    <i class="fas fa-female"></i>
                                                    <h5>Mother Details</h5>
                                                </div>
                                                <div class="parent-info">
                                                    <div class="info-item">
                                                        <label>Name</label>
                                                        <span> @Model.MotherName</span>
                                                    </div>
                                                    <div class="info-item">
                                                        <label>Qualification</label>
                                                        <span>@Model.MotherQualification</span>
                                                    </div>
                                                    <div class="info-item">
                                                        <label>Occupation</label>
                                                        <span>@Model.MotherOccupation</span>
                                                    </div>
                                                    <div class="info-item">
                                                        <label>Office Phone</label>
                                                        <span>@Model.MotherOfficeMobileNo</span>
                                                    </div>
                                                    <div class="info-item">
                                                        <label>Office Address</label>
                                                        <span>@Model.MotherOfficeAddress</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Academic Details -->
                            <div class="info-section">
                                <div class="section-header">
                                    <h4><i class="fas fa-graduation-cap me-2"></i>Academic Details</h4>
                                </div>
                                <div class="section-content">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Last School Attended</label>
                                                <span> @Model.LastSchoolAttended</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Year of Passing</label>
                                                <span>@Model.YearOfPassing</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Total Marks</label>
                                                <span>@Model.TotalMarks</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label>Obtained Marks</label>
                                                <span>@Model.ObtainedMarks</span>
                                            </div>
                                        </div>
                                     
                                    </div>
                                </div>
                            </div>

                            <!-- Documents Section -->
                            <div class="info-section">
                                <div class="section-header">
                                    <h4><i class="fas fa-folder-open me-2"></i>Documents</h4>
                                </div>
                                <div class="section-content">
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <div class="document-card">
                                                <div class="document-header">
                                                    <i class="fas fa-male"></i>
                                                    <h6>Father's Photo</h6>
                                                </div>
                                                <div class="document-content">
                                                    <img src="@Url.Content(Model.FatherPhotos)" 
                                                         class="document-image"
                                                         alt="Father's Photo"
                                                         onerror="handleImageError(this, 'document')" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="document-card">
                                                <div class="document-header">
                                                    <i class="fas fa-female"></i>
                                                    <h6>Mother's Photo</h6>
                                                </div>
                                                <div class="document-content">
                                                    <img src="@Url.Content(Model.MotherPhotos)"
                                                         class="document-image"
                                                         alt="Mother's Photo"
                                                         onerror="handleImageError(this, 'document')" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="document-card">
                                                <div class="document-header">
                                                    <i class="fas fa-id-card"></i>
                                                    <h6>Aadhar Document</h6>
                                                </div>
                                                <div class="document-content">
                                                    <div class="document-placeholder">
                                                        <i class="fas fa-file-alt"></i>
                                                        <p>Identity Document</p>
                                                        <a href="@Url.Content( Model.StudentAadharPhotos)" target="_blank" class="btn btn-outline-primary btn-sm">
                                                           View Document
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<script>
    // Handle image error
    function handleImageError(img) {
        img.style.display = "none"

        // Create a placeholder div
        const placeholder = document.createElement("div")
        placeholder.className = "profile-image rounded-circle shadow-sm image-error"
        placeholder.style.width = "170px"
        placeholder.style.height = "170px"
        placeholder.innerHTML = '<i class="fas fa-user"></i>'

        // Insert the placeholder after the image
        img.parentNode.insertBefore(placeholder, img.nextSibling)
    }

    // Add smooth scrolling and interactive effects
    document.addEventListener("DOMContentLoaded", () => {
        // Add hover effects to info cards
        const infoCards = document.querySelectorAll(".info-card")

        infoCards.forEach((card) => {
            card.addEventListener("mouseenter", function () {
                this.style.transform = "translateY(-5px)"
            })

            card.addEventListener("mouseleave", function () {
                this.style.transform = "translateY(0)"
            })
        })

        // Add click effect to buttons
        const buttons = document.querySelectorAll(".btn")

        buttons.forEach((button) => {
            button.addEventListener("click", function (e) {
                // Create ripple effect
                const ripple = document.createElement("span")
                const rect = this.getBoundingClientRect()
                const size = Math.max(rect.width, rect.height)
                const x = e.clientX - rect.left - size / 2
                const y = e.clientY - rect.top - size / 2

                ripple.style.width = ripple.style.height = size + "px"
                ripple.style.left = x + "px"
                ripple.style.top = y + "px"
                ripple.classList.add("ripple")

                this.appendChild(ripple)

                setTimeout(() => {
                    ripple.remove()
                }, 600)
            })
        })

        // Add loading animation
        const profileContainer = document.querySelector(".profile-container")
        profileContainer.style.opacity = "0"
        profileContainer.style.transform = "translateY(50px)"

        setTimeout(() => {
            profileContainer.style.transition = "all 0.8s ease"
            profileContainer.style.opacity = "1"
            profileContainer.style.transform = "translateY(0)"
        }, 100)
    })

    // Print functionality
    document.querySelector(".btn-outline-secondary").addEventListener("click", () => {
        window.print()
    })

    // Edit functionality (placeholder)
    document.querySelector(".btn-primary").addEventListener("click", () => {
        alert("Edit functionality would be implemented here")
    })

</script>
 

