</script>
<script>
    document.getElementById("academicYearSelect").addEventListener("change", function () {

        let academicYear = this.value;

        if (academicYear) {
            let year = academicYear.split('-')[0]; // 2026

            window.location.href = "/Admin/AddBlock?academicYear=" + year;
        }
    });
</script>












