<script>
    function filterDeweyValue() {
        const inputs = document.getElementsByClassName('deweyDecimalClass');
        for (let input of inputs) {
            const value = input.value;
            const match = value.match(/^(\d{3})/);
            if (match) {
                input.value = match[1];
            }
        }
    }
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var today = new Date().toISOString().split('T')[0];
        document.getElementById("purchasingDate").setAttribute('max', today);
    });
    function initializeDataTable() {
        debugger
        let table = $('#bookTable').DataTable({
            ordering: false,
            autoWidth: false,
            pageLength: 10,
            lengthMenu: [[10, 20, 50, 100], [10, 20, 50, 100]],
            dom: '<"top"lBf>rt<"bottom"ip><"clear">', // l = length, B = buttons, f = filter (search)
            buttons: [
                {
                    extend: 'excel',
                    text: 'Export Excel',
                    exportOptions: {
                        columns: function (idx, data, node) {
                            return ![8].includes(idx);
                        } // exclude last column
                    }
                },
                {
                    extend: 'pdfHtml5',
                    text: 'Export PDF',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    exportOptions: {
                        columns: function (idx, data, node) {
                            return ![8].includes(idx);
                        } // exclude last column
                    },
                    customize: function (doc) {
                        doc.defaultStyle.fontSize = 6;
                        doc.styles.tableHeader.fontSize = 7;
                        doc.content[1].table.widths =
                            Array(doc.content[1].table.body[0].length + 1).join('*').split('');
                    }
                }
            ]
        });
        return table;
    }
    $(document).ready(function () {
        initializeDataTable();
        $('#categoryModalCloseBtn').on('click', function () {
            $('#addBookCategoryForm')[0].reset();
            $('#exampleModal').modal('hide');
            $('#BookModal').modal('show');

        })

        $('#CloseModalAddBook').on('click', function () {
            $('.addBookForm').each(function () {
                this.reset();
            });
            $('#BookModal').modal('hide')
        })
        $('#CloseModalUpdateBook').on('click', function () {
            $('.addBookForm').each(function () {
                this.reset();
            });
            $('#UpdateBookModal').modal('hide')
        })

        $("#addBookCategoryForm").on('submit', function (e) {
            e.preventDefault();
            Swal.fire({
                title: 'Please Wait!',
                text: 'Processing Your Request...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });
            let formdata = new FormData(this);
            $.ajax({
                url: '/admin/AddBookCategory', type: 'post', data: formdata, contentType: false, processData: false,
                success: function (res) {
                    if (res.status) {
                        Swal.fire({
                            title: 'Success', text: res.message, icon: 'success',
                            didClose: () => { location.reload(true); }
                        });
                    }
                    else {
                        Swal.fire({ title: 'Error', text: res.message, icon: 'error' });
                    }
                },
                error: function (xhr) {
                    Swal.fire({
                        title: 'Error',
                        text: 'Server Error. Try Again Later!', icon: 'error'
                    });
                }
            });
        });

        $('.isbnCheck').on('blur', function () {
            debugger
            var isbnValue = $(this).val();
            var actiontype = $(this).data('actiontype');

            $.ajax({
                url: '/admin/checkisbn',
                type: 'get',
                data: { isbn: isbnValue, actiontype: actiontype },
                success: function (response) {
                    console.log('Server response:', response);
                    if (response) {
                        $('.isISBN').val(true);
                        $('.checkISBN').text('This ISBN number already exist');
                        $('.addBookBtn').prop('disabled', true);
                    }
                    else {
                        $('.isISBN').val(false);
                        $('.checkISBN').text('');
                        $('.addBookBtn').prop('disabled', false);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                }
            });
        });

        $('.issnPrintCheck').on('blur', function () {
            debugger
            var issnPrint = $(this).val();
            var actiontype = $(this).data('actiontype');

            $.ajax({
                url: '/admin/CheckISSN',
                type: 'get',
                data: { issn: issnPrint, actiontype: actiontype },
                success: function (response) {
                    console.log('Server response:', response);
                    if (response) {
                        $('.isISSN').val(true);
                        $('.checkISSN').text('This ISSN print already exist');
                        $('.addBookBtn').prop('disabled', true);
                    }
                    else {
                        $('.isISSN').val(false);
                        $('.checkISSN').text('');
                        $('.addBookBtn').prop('disabled', false);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                }
            });
        });
        $('.accessionNumberCheck').on('blur', function () {
            debugger
            var accession = $(this).val();
            var actiontype = $(this).data('actiontype');

            $.ajax({
                url: '/admin/CheckAccession',
                type: 'get',
                data: { accession: accession, actiontype: actiontype },
                success: function (response) {
                    console.log('Server response:', response);
                    if (response) {
                        $('.isAccession').val(true);
                        $('.checkAccession').text('This Accession number already exist');
                        $('.addBookBtn').prop('disabled', true);
                    }
                    else {
                        $('.isAccession').val(false);
                        $('.checkAccession').text('');
                        $('.addBookBtn').prop('disabled', false);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                }
            });
        });

        $('.addBookForm').on('submit', function (e) {
            e.preventDefault();
            Swal.fire({
                title: 'Please Wait!',
                text: 'Processing your request...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            var formData = new FormData(this);
            $.ajax({
                url: '/admin/AddBook',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.status) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            didClose: () => { location.reload(true); }
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong. Please try again.'
                    });
                }
            });
        });



        $('#category').on('change', function () {
            let filterval = $(this).val();
            let filterType = "category";
            GetFilteredBooks(filterval, filterType);
        })
        let debounceTimer;

        $('#isbnno').on('input', function () {
            clearTimeout(debounceTimer);
            debugger
            debounceTimer = setTimeout(() => {
                let filterval = $(this).val();
                let filterType = "isbn";
                GetFilteredBooks(filterval, filterType);
            }, 1000);
        });
        $('#issnno').on('input', function () {
            clearTimeout(debounceTimer);

            debounceTimer = setTimeout(() => {
                let filterval = $(this).val();
                let filterType = "issn";
                GetFilteredBooks(filterval, filterType);
            }, 1000);
        });
        function GetFilteredBooks(filterval, filterType) {
            debugger
            $.ajax({
                url: '/admin/FilterForBook', type: 'get', data: { filter: filterval, filterType: filterType },
                success: function (res) {
                    let $tbody = $('#BookTableBody');
                    $tbody.empty();
                    if (res && res.length > 0) {
                        let count = 1;
                        res.forEach(book => {
                            let row = `
    <tr>
        <td>${count}</td>
       <td><a href="/admin/ShowBookDetailsPage?id=${book.id}" title="Show Details">${book.title}</a></td>
        <td>${book.subTitle}</td>
        <td>${book.categoryName}</td>
        <td>${book.author}</td>
        <td>${book.isbn}</td>
        <td>${book.issnPrint}</td>
        <td>${book.accessionNumber}</td>
        <td>${book.numberOfCopies - book.bookCount}</td>
       <td class="text-center">
            <a role="button" title="Update" data-id="${book.id}" class="btn btn-sm updateBook p-0"> <i  class="text-warning fa-solid fa-pen-to-square" style="width:22px; height:22px;"></i></a>
            </td>
        </tr>`;
                            count++;
                            $tbody.append(row);
                        });
                    } else {
                        $tbody.html(`
<tr>
        <td colspan="8" style="text-align:center;">No records found</td>
</tr>`);
                    }
                },
                error: function (xhr) {
                    console.log(xhr);
                    Swal.fire('Error', 'Server Issue Try Again Later', 'error');
                }
            })
        }
    });
    $(document).on('click', '.updateBook', function () {
        debugger
        Swal.fire({
            title: 'Please wait!',
            text: 'Processing your request...',
            allowEscapeKey: false,
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });
        var id = $(this).data('id');

        $.ajax({
            url: '/admin/GetBookById',
            type: 'get',
            data: { id: id },
            success: function (res) {
                console.log('Data', res);
                if (res && res.length > 0) {
                    const book = res[0];
                    $('#id').val(book.id);
                    $('#titleup').val(book.title);
                    $('#subTitleup').val(book.subTitle);
                    $('#authorup').val(book.author);
                    $('#volumeup').val(book.volume);
                    $('#editionup').val(book.edition);
                    $('#isbnup').val(book.isbn);
                    $('#publicationup').val(book.publication);
                    $('#issnPrintup').val(book.issnPrint);
                    $('#placeOfPublicationup').val(book.placeOfPublication);
                    $('#deweyDecimalClassup').val(book.deweyDecimalClass);
                    $('#yearOfPublicationup').val(book.yearOfPublication);
                    $('#printingDateup').val(book.printingDate);
                    $('#numberOfCopiesup').val(book.numberOfCopies);
                    $('#isIssuableup').val(String(book.isIssuable));
                    $('#numberOfPagesup').val(book.numberOfPages);
                    $('#purchasingDateup').val(book.purchasingDate);
                    $('#sourceup').val(book.source);
                    $('#priceup').val(book.price);
                    $('#supplierup').val(book.supplier);
                    $('#accessionNumberup').val(book.accessionNumber);
                    $('#bookLocationup').val(book.bookLocation);
                    $('#categoryNameup').val(book.categoryId);
                    $('#subjectup').val(book.subject);
                    $('#bookLanguagesup').val(book.bookLanguages);
                    $('#bookRemarksup').val(book.bookRemarks);
                    $('#bookContentup').val(book.bookContent);
                    Swal.close();
                    $('#UpdateBookModal').modal('show');
                }
                else {
                    Swal.fire('Error', 'Failed to fetch data', 'error');
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr);
                Swal.fire('Error', 'Server error! Please Try Again', 'error');
            }
        });
    });
</script>
