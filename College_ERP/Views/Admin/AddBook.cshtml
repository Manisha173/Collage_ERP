                        <div class="col-sm-4 mb-2">
                            <label for="numberOfPagesup" class="form-label">Number of Pages</label>
                            <input type="number" class="form-control" name="numberOfPages" id="numberOfPagesup" placeholder="Enter number of pages" required>
