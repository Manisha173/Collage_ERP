                            <datalist id="deweyOptions">
                                <option value="000 – General Works">
                                <option value="100 – Philosophy & Psychology">
                                <option value="200 – Religion">
                                <option value="300 – Social Sciences">
                                <option value="400 – Language">
                                <option value="500 – Natural Sciences & Mathematics">
                                <option value="600 – Technology (Applied Sciences)">
