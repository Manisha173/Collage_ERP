                        <div class="col-sm-4 mb-2">
                            <label for="supplierup" class="form-label">Supplier</label>
                            <input type="text" class="form-control" name="supplier" id="supplierup" placeholder="Enter supplier name" required>
                        </div>
                        <div class="col-sm-4 mb-2">
                            <label for="accessionNumberup" class="form-label">Accession No.</label>
                            <input type="text" class="form-control accessionNumberCheck" data-actiontype="Update" name="accessionNumber" id="accessionNumberup" placeholder="Enter accession number" required>
                            <input type="hidden" name="IsAccession" class="isAccession" />
                            <span class="text-danger checkAccession" style="font-size:14px;"></span>
                        </div>
                        <div class="col-sm-4 mb-2">
                            <label for="bookLocationup" class="form-label">Book Location</label>
                            <input type="text" class="form-control" name="bookLocation" id="bookLocationup" placeholder="Enter book location" required>
                        </div>
                        <div class="col-sm-4 mb-2">
                            <label for="categoryNameup" class="form-label">Category</label>
                            <div class="input-group">
                                <select id="categoryNameup" name="categoryId" class="form-select" required>
                                    <option value="">--Select Category--</option>
                                    @if (ViewData["categories"] != null)
                                    {
                                        foreach (var category in categories)
                                        {
                                            <option value="@category.id">@category.categoryName</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#exampleModal" type="button" id="addCategoryBtn">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-4 mb-2">
                            <label for="subjectup" class="form-label">Subject</label>
                            <input type="text" class="form-control" name="subject" id="subjectup" placeholder="Enter subject" required>
                        </div>
                        <div class="col-sm-4 mb-2">
                            <label for="bookLanguagesup" class="form-label">Book Languages</label>
                            <input type="text" class="form-control" name="bookLanguages" id="bookLanguagesup" placeholder="Enter book language(s)" required>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label for="bookRemarksup" class="form-label">Book Remarks</label>
                            <textarea class="form-control" name="bookRemarks" id="bookRemarksup" placeholder="Enter remarks about the book" required></textarea>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label for="bookContentup" class="form-label">Book Content</label>
                            <textarea class="form-control" name="bookContent" id="bookContentup" placeholder="Enter content/summary of the book" required></textarea>
                        </div>
                    </div>

                    <div class="mt-2 text-center">
                        <button type="submit" class="btn btn-primary addBookBtn">Update</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

