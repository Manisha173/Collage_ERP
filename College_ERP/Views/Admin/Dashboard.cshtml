<style>
    .swal2-popup .swal-pro-loader {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 20px;
    }

    .loader {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

        .loader span {
            width: 15px;
            height: 15px;
            background: #3498db;
            border-radius: 50%;
            animation: bounce 0.6s infinite alternate;
        }

            .loader span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .loader span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes bounce {
        to {
            opacity: 0.3;
            transform: translateY(-16px) scale(0.8);
        }
    }

    .loader-text {
        margin-top: 20px;
        color: #444;
        font-size: 15px;
        font-weight: 500;
        font-family: 'Segoe UI', sans-serif;
        animation: fadein 1s ease-in-out infinite;
    }

    @@keyframes fadein {
        0%, 100% {
            opacity: 0.2;
        }

        50% {
            opacity: 1;
        }
    }
</style>
<script>
    function showAdvancedSwalLoader() {
        Swal.fire({
            title: 'Loading Data',
            html: `
                <div class="swal-pro-loader">
                    <div class="loader">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <div class="loader-text">Please wait...</div>
                </div>
            `,
            showConfirmButton: false,
            allowOutsideClick: false,
            allowEscapeKey: false,
            backdrop: `rgba(0, 0, 0, 0.6)`
        });
    }
</script>

<script>
    $(document).ready(function () {
        loadDashboardCounts();
    });



    $('#academicYearSelect').change(function () {
        showAdvancedSwalLoader();
        loadDashboardCounts();
    });

    function loadDashboardCounts() {
        let academicYear = $('#academicYearSelect').val();
        let year = academicYear ? parseInt(academicYear.split('-')[0]) : null;

        $.ajax({
            url: '/Admin/GetDashboardCounts',
            type: 'GET',
            data: { year: year },
            success: function (data) {
                if (data) {
                    $('#totalteacher').text(data.totalteacher || 0);
                    $('#totalbus').text(data.totalbus || 0);
                    $('#totalhostelblocks').text(data.totalhostelblocks || 0);
                    $('#totaladmittedstudent').text(data.totaladmittedstudent || 0);
                    $('#totalsecurity').text(data.totalsecurity || 0);
                    $('#totalbooks').text(data.totalbooks || 0);
                    $('#totalleaverequest').text(data.totalleaverequest || 0);
                    $('#totalassignedtasks').text(data.totalassignedtasks || 0);
                }
                Swal.close();
            },
            error: function (err) {
                console.error("Error loading dashboard counts:", err);
            }
        });

    }
</script>

    <script>
        document.getElementById("teacherCardLink").addEventListener("click", function () {

