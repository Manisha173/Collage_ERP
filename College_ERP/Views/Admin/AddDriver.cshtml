<style>
    /* Remove default DataTables button style */
    .dt-button {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 8px !important;
        color: inherit !important;
    }

        .dt-button:hover {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

        .dt-button:focus,
        .dt-button:active {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
        }

    /* Button container */
    .dt-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 7px;
    }

    /* Icon button */
    .icon-btn {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 5px 10px !important;
        min-width: auto !important;
        cursor: pointer;
    }

        /* Hover effect */
        .icon-btn:hover {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            transform: scale(1.15);
            transition: 0.2s ease;
        }

        /* Remove focus outline */
        .icon-btn:focus,
        .icon-btn:active {
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
        }
</style>

