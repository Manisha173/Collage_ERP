                                        <th class="text-center">DL</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (data != null)
                                    {
                                        int count = 1;
                                        foreach (var item in data)
                                        {
                                            <tr>
                                                <td>@count</td>
                                                <td>@item.EmployeeId</td>
                                                <td>
                                                    <a href="/admin/DriverProfile?id=@item.Id" title="Show Profile">@item.Name</a>
                                                </td>
                                                <td>@item.FatherName</td>
                                                <td>@item.ContactNo</td>
                                                <td>@item.DLNo</td>
                                                <td>@item.AdharCardNo</td>
                                                <td>@item.Address</td>
                                                <td>@item.Salary</td>
                                                <td>@item.username</td>
                                                <td>@item.password</td>
                                                <td class="text-center"><a target="_blank" href="@item.DriverFileName">View</a></td>
                                                <td class="text-center"><a target="_blank" href="@item.DLFileName">View</a></td>
                                                <td class="text-center"><a target="_blank" href="@item.AdharCardFileName">View</a></td>
                                                <td class="text-center">
                                                    <a role="button" title="Update" data-id="@item.Id" class="btn btn-sm editDriver p-0"> <i data-feather="edit" class="text-warning" style="width:22px; height:22px;"></i></a>
                                                    <a role="button" class="btn btn-sm deletemat p-0" data-id="@item.Id" title="Delete"><i data-feather="trash-2" class="text-danger" style="width:22px; height:22px;"></i></a>

                                                </td>
                                            </tr>
                                            count++;
                                        }
                                    }
