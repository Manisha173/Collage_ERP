<script>


    $(document).ready(function () {

        $('#Class').on('change', function () {
            let classIds = "@(Model != null ? Model.SectionId : 0)";
        var classId = $(this).val();
        var sectionDropdown = $('#Section');
        sectionDropdown.empty().append('<option value="">----Loading----</option>');

        if (classId !== "") {
            $.ajax({
            url: '@Url.Action("GetSectionsByClass", "Admin")',
                type: 'GET',
                data: { classId: classId },
                success: function (sections) {
                    sectionDropdown.empty().append('<option value="">----Select Section----</option>');
                    $.each(sections, function (i, section) {
                        let selectedEle = section.SectionId == classIds ? 'selected' : ""
                        sectionDropdown.append(`<option value="${section.SectionId}" ${selectedEle}>${section.SectionName} </option>`);
                    });
                },
                error: function () {
                    alert('Error fetching sections.');
                    sectionDropdown.empty().append('<option value="">----Select Section----</option>');
                }
            });
        } else {
            sectionDropdown.empty().append('<option value="">----Select Section----</option>');
        }
    });
    //City Binding

    let selectedCityId = "@(Model != null ? Model.CityId.ToString() : "0")";

    $("#StateId").on("change", function () {
        $("#CityId").html(`<option selected value="">--select city--</option>`);
        let id = $(this).val();

        if (id !== "") {
            $.ajax({
                url: '/Admin/GetCityById',
                type: 'get',
                data: { id: id },
                success: function (response) {
                    if (response && response.length > 0) {
                        $.each(response, function (index, item) {
                            let selected = item.city_Id == selectedCityId ? 'selected' : '';
                            $("#CityId").append(`<option value='${item.city_Id}' ${selected}>${item.City_Name}</option>`);
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong while fetching cities'
                    });
                }
            });
        }
    });
});

    // Auto calculate percentage
    function calculatePercentage() {
        var obtained = parseFloat($('#ObtainedMarks').val());
        var total = parseFloat($('#TotalMarks').val());

        console.log('Marks Obtained:', obtained);
        console.log('Total Marks:', total);

        if (!isNaN(obtained) && !isNaN(total) && total > 0) {
            var percentage = (obtained / total) * 100;
            $('#Percentage').val(percentage.toFixed(2));
            console.log('Calculated Percentage:', percentage.toFixed(2));
        } else {
            $('#Percentage').val('');
            console.log('Invalid data for percentage calculation.');
        }
    }

    $(document).ready(function () {
        // Trigger calculation when page loads if values are pre-filled
        calculatePercentage();

        $('#ObtainedMarks, #TotalMarks').on('input', function () {
            calculatePercentage();
        });
    });



    $(document).ready(function () {
        $('#MarksObtained, #TotalMarks').on('input', function () {
            calculatePercentage();
        });
    });

    //insert
    $('#studentForm').on('submit', function (e) {
        e.preventDefault();
        Swal.fire({
            title: "Please Wait!",
            html: "We are processing your request",
            allowOutsideClick:false,
            didOpen: () => {
                Swal.showLoading();
            }
        })
        var formData = new FormData($('#studentForm')[0]);


        var studentId = $('#StudentId').val();
        console.log(studentId)
        var isUpdate = studentId && parseInt(studentId) > 0;

        $.ajax({
            url: isUpdate ? '/Admin/UpdateStudent' : '/Admin/StudentRegistration',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: res.message,
                        didClose: () => {

                            location.href = '/admin/StudentRegistrationList';
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: res.message
                    });
                }
            },
            error: function (xhr) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong: ' + xhr.responseText
                });
            }
        });
    });




      // GetById



