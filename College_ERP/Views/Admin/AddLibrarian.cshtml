<script>
    $(document).ready(function () {
        $('#CloseAddLibrarianModal').on('click', function () {
            $('.AddLibrarianForm')[0].reset();
            $('#AddLibrarianModal').modal('hide');
        })
        $('#CloseUpdateLibrarianModal').on('click', function () {
            $('.AddLibrarianForm')[0].reset();
            $('#UpdateLibrarianModal').modal('hide');
        })

        async function GetCityByState(id, action) {
            await $.ajax({
                url: '/Admin/GetCityById',
                type: 'get',
                data: { id: id },
                success: function (response) {
                    console.log(response[0].City_Name)
                    let cities = action == "update" ? $("#upCityId") : $("#CityId");
                    cities.empty();
                    let citiesBind = '<option value="">--Select City--</option>';
                    $.each(response, function (index, item) {
                        citiesBind += (`<option value="${item.city_Id}">${item.City_Name}</option>`);
                    });
                    cities.append(citiesBind);
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'error',
                        text: 'Something went wrong with the request'
                    });
                }
            });
        }
        $(".Statechange").on("change", async function () {
            debugger
            let id = $(this).val();
            let action = $(this).attr("data-action")
            await GetCityByState(id, action);
        });
        let emailCheckup;
        let mobileCheckup;

        $('.AddLibrarianForm').submit(function (e) {
            e.preventDefault();
            let actionType = $(this).data('action');
            let emailup = $('#upEmail').val();
            let mobileup = $('#upMobileNo').val();

            const proceedWithSubmission = (userAction) => {
                Swal.fire({
                    title: 'Please Wait!',
                    text: 'Processing Your Request...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                var data = new FormData(this);
                data.append("UserAction", userAction);
                var fileUpload = document.getElementById("Document");
                if (fileUpload?.files?.length > 0) {
                    for (var i = 0; i < fileUpload.files.length; i++) {
                        data.append("Document", fileUpload.files[i]);
                    }
                }

                var profileUpload = document.getElementById("profile");
                if (profileUpload?.files?.length > 0) {
                    for (var i = 0; i < profileUpload.files.length; i++) {
                        data.append("Profile", profileUpload.files[i]);
                    }
                }

                var upprofileUpload = document.getElementById("upprofile");
                if (upprofileUpload?.files?.length > 0) {
                    for (var i = 0; i < upprofileUpload.files.length; i++) {
                        data.append("Profile", upprofileUpload.files[i]);
                    }
                }

                var upfileUpload = document.getElementById("upDocument");
                if (upfileUpload?.files?.length > 0) {
                    for (var i = 0; i < upfileUpload.files.length; i++) {
                        data.append("Document", upfileUpload.files[i]);
                    }
                }

                $.ajax({
                    type: 'POST',
                    url: '/admin/AddLibrarian',
                    data: data,
                    contentType: false,
                    processData: false,
                    success: function (res) {
                        if (res.status) {
                            Swal.fire({
                                title: 'Success',
                                text: res.message,
                                icon: 'success',
                                didClose: () => { location.reload(true); }
                            });
                        } else {
                            Swal.fire({ title: 'Error', text: res.message, icon: 'error' });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Error',
                            text: 'Server Error. Try Again Later!',
                            icon: 'error'
                        });
                    }
                });
            };
            debugger
            let eventFn;
            if (actionType == "Update" && emailCheckup != emailup && mobileCheckup == mobileup) {
                Swal.fire({
                    title: 'Choose an action',
                    html: `
        <div style="text-align: left; padding: 10px;">
            <p style="margin-bottom: 15px;">You changed the email but not the mobile number.</p>

            <div style="border: 1px solid #d32f2f; border-radius: 6px; padding: 10px; margin-bottom: 10px; background-color: #fdecea;">
                <strong style="color: #d32f2f;">Add:</strong>
                <span style="color: #d32f2f;"> This will add a new Librarian but you also need to change the mobile number.</span>
            </div>

            <div style="border: 1px solid #f57c00; border-radius: 6px; padding: 10px; background-color: #fff3e0;">
                <strong style="color: #f57c00;">Update:</strong>
                <span style="color: #f57c00;"> This will update the Librarian details with the new email.</span>
            </div>
        </div>
    `,
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: 'Add',
                    denyButtonText: 'Update',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#d32f2f',
                    denyButtonColor: '#f57c00',
                    cancelButtonColor: '#9e9e9e'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Warning',
                            text: `Please change the mobile number. It's compulsory to add a new librarian.`,
                            icon: 'warning',
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#d32f2f'
                        });
                        debugger
                    } else if (result.isDenied) {
                        eventFn = 'update'
                        proceedWithSubmission(eventFn);
                    } else {
                        console.log('Action cancelled');
                    }
                });



            } else {
                eventFn = 'add'
                proceedWithSubmission(eventFn);
            }
        });

        $(".updateLibrarian").on('click', function () {
            let id = $(this).data('id')
            $.ajax({
                url: '/admin/EditLibrarian', type: 'get', data: { id, id },
                success: function (res) {
                    console.log(res);
                    if (res) {

                        function convertMSDateToInputDate(msDate) {
                            const timestamp = parseInt(msDate.replace(/\/Date\((\d+)\)\//, '$1'));
                            const date = new Date(timestamp);
                            const formattedDate = date.toISOString().split('T')[0];
                            return formattedDate;
                        }

                        $('#id').val(res[0].Id);
                        debugger
                        $('#upEmployeeId').val(res[0].EmployeeId);
                        $("#upName").val(res[0].Name);
                        $("#upEmail").val(res[0].Email);
                        emailCheckup = res[0].Email;
                        $("#upDOB").val(convertMSDateToInputDate(res[0].DOB));
                        $("#upMobileNo").val(res[0].MobileNo);
                        mobileCheckup = res[0].MobileNo;
                        $("#upStateId").val(res[0].StateId);
                        GetCityByState(res[0].StateId, "update").then(() => {
                            $("#upCityId").val(res[0].CityId);
                        });
                        $('#upgender').val(res[0].Gender);
                        $("#upAdharNo").val(res[0].AdharNo);
                        $("#upAddress").val(res[0].Address);
                        $('#UpdateLibrarianModal').modal('show');
                    }
                },
                error: function (xhr) {
                    console.log(xhr);
                }
            });
        });
    });
</script>

<script>
    $(function () {
        $('.mobileval').on('input', function () {
            let m = $(this).val().replace(/\D/g, '').slice(0, 10);
            $(this).val(m);
            $('.mobileError').text(
                m.length < 10 ? 'Mobile number must be 10 digits.' :
                    !/^[6-9]/.test(m) ? 'Mobile number must start with 6, 7, 8, or 9.' : ''
            );
        });
    });
    $(function () {
        $('.adharval').on('input', function () {
            let a = $(this).val().replace(/\D/g, '').slice(0, 12);
            $(this).val(a);
            $('.adharError').text(
                a.length < 12 ? 'Aadhaar number must be 12 digits.' : ''
            );
        });
    });
</script>
<script>

    // Handle image error
    function handleImageError(img) {
        img.style.display = "none"

        const placeholder = document.createElement("div")
        placeholder.className = "profile-image image-error"
        placeholder.innerHTML = '<i class="fas fa-user-graduate"></i>'

        img.parentNode.insertBefore(placeholder, img.nextSibling)
    }

    // Add interactive effects
    document.addEventListener("DOMContentLoaded", () => {
        // Animate performance bars
        const performanceBars = document.querySelectorAll(".meter-fill")
        performanceBars.forEach((bar) => {
            const width = bar.style.width
            bar.style.width = "0%"
            setTimeout(() => {
                bar.style.width = width
            }, 500)
        })

        // Add hover effects to cards
        const cards = document.querySelectorAll(".stat-card, .professional-card, .performance-card")
        cards.forEach((card) => {
            card.addEventListener("mouseenter", function () {
                this.style.transform = "translateY(-8px)"
            })

            card.addEventListener("mouseleave", function () {
                this.style.transform = "translateY(0)"
            })
        })

        // Add click effects to buttons
        const buttons = document.querySelectorAll(".btn")
        buttons.forEach((button) => {
            button.addEventListener("click", function (e) {
                // Create ripple effect
                const ripple = document.createElement("span")
                const rect = this.getBoundingClientRect()
                const size = Math.max(rect.width, rect.height)
                const x = e.clientX - rect.left - size / 2
                const y = e.clientY - rect.top - size / 2

                ripple.style.width = ripple.style.height = size + "px"
                ripple.style.left = x + "px"
                ripple.style.top = y + "px"
                ripple.style.position = "absolute"
                ripple.style.borderRadius = "50%"
                ripple.style.background = "rgba(255, 255, 255, 0.3)"
                ripple.style.transform = "scale(0)"
                ripple.style.animation = "ripple 0.6s linear"
                ripple.style.pointerEvents = "none"

                this.style.position = "relative"
                this.style.overflow = "hidden"
                this.appendChild(ripple)

                setTimeout(() => {
                    ripple.remove()
                }, 600)
            })
        })

        // Add loading animation to main card
        const mainCard = document.querySelector(".main-profile-card")
        mainCard.style.opacity = "0"
        mainCard.style.transform = "translateY(50px)"

        setTimeout(() => {
            mainCard.style.transition = "all 0.8s ease"
            mainCard.style.opacity = "1"
            mainCard.style.transform = "translateY(0)"
        }, 200)

        // Status indicator animation
        const statusIndicator = document.querySelector(".status-indicator")
        if (statusIndicator) {
            setInterval(() => {
                statusIndicator.style.transform = "scale(1.05)"
                setTimeout(() => {
                    statusIndicator.style.transform = "scale(1)"
                }, 200)
            }, 3000)
        }

        // Achievement items hover effect
        const achievementItems = document.querySelectorAll(".achievement-item")
        achievementItems.forEach((item) => {
            item.addEventListener("mouseenter", function () {
                this.style.transform = "translateX(15px)"
                this.style.background = "var(--teal-100)"
            })

            item.addEventListener("mouseleave", function () {
                this.style.transform = "translateX(0)"
                this.style.background = "var(--teal-50)"
            })
        })


    })

    // Add CSS for ripple animation
    const style = document.createElement("style")
    style.textContent = `
  @@keyframes ripple {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }
`
    document.head.appendChild(style)

    // Print functionality
    function printProfile() {
        window.print()
    }

</script>