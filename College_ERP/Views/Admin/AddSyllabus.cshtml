                                <option value="">--Select Subject--</option>
                            </select>
                        </div>

                        <div class="col-sm-4 mb-2">
                            <input type="hidden" id="setacademiyear" name="academicYear" />
                            <label class="form-label" for="upacademicYear">Academic year</label>
                            <select class="form-control" id="upacademicYear" disabled>
                                <option selected disabled value="">--Select Academic Year--</option>
                                @{
                                    for (int i = 0; i <= 10; i++)
                                    {
                                        <option @(Request.QueryString["year"] == (DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i + 1)).Year) ? "selected" : "") value="@(DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i+1)).Year)">@(DateTime.Now.AddYears(-i).Year + "-" + DateTime.Now.AddYears((-i+1)).Year)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-sm-4 mb-2">
                            <label for="upattachment" class="form-label">Attachment</label>
                            <input type="file" id="upattachment" class="form-control" />
