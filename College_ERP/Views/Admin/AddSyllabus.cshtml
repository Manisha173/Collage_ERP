                    </div>
                    <div class="mt-2 text-center">
                        <button type="submit" class="btn btn-primary">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function (){
        const educationOptions = {
            school: [
                { value: "secondary", text: "Secondary (Class Nursery – 10)" },
                { value: "senior_secondary", text: "Senior Secondary (Class 11 – 12)" }
            ],
            college: [
                { value: "diploma", text: "Diploma" },
                { value: "ug", text: "Undergraduate (UG)" },
                { value: "pg", text: "Postgraduate (PG)" },
                { value: "phd", text: "Doctorate (Ph.D.)" }
            ]
        };
        $('#institutionType').on('change', function () {
            $('#streamWrapper').hide();
            $('#optsubject').hide();
            const selectedType = $(this).val();
            const $educationLevel = $('#educationLevel');
            $educationLevel.empty();
            $.get('/Admin/GetEducationLevelByInstitution?institution=' + selectedType, function (data) {
                if (data && data.length > 0) {
                    $.each(data, function (index, item) {
                        $educationLevel.append($('<option>', {
                            value: item,
                            text: item
                        }));
                    });
                }
            });
            $educationLevel.empty().append('<option selected disabled>--Select Education Level--</option>');

            //if (educationOptions[selectedType]) {
            //    $.each(educationOptions[selectedType], function (index, item) {
            //        $educationLevel.append($('<option>', {
            //            value: item.value,
            //            text: item.text
            //        }));
            //    });
            //}
            if (selectedType === "college") {
                $('#streamWrapper').show();
            }
        });
        let streamFlag = false;

        $('#educationLevel').on('change', function () {
            debugger
            const selectedLevel = $(this).val();

            $('#streamWrapper').hide();
            $('#optsubject').hide();

            if (selectedLevel !== 'secondary') {
                $('#streamWrapper').show();
                $('#optsubject').show();
                streamFlag = true;

            }

            const $classdropdown = $('#classId');
            $classdropdown.empty();
            $classdropdown.html(`<option value="0" disabled selected>-- Select Class --</option>`);
            $.get('/admin/GetClassByEducationLevel?educationlevel=' + selectedLevel, function (data) {
                if (data && data.length > 0) {
                    $.each(data, function (index, item) {
                        $classdropdown.append($('<option>', {
                            value: item.ClassId,
                            text: item.ClassName
                        }));
                    });
                }
            });
        });
        $('#classId').on('change', function () {
            debugger
            if (streamFlag) {
                let id = $(this).val();
                const $streamdrp = $('#streamInput');
                $streamdrp.empty();
                $streamdrp.html(`<option value="0" disabled selected>-- Select Stream --</option>`);
                $.get('/admin/GetStreamByClassId?classid=' + id, function (data) {
                    if (data && data.length > 0) {
                        $.each(data, function (index, item) {
                            $streamdrp.append($('<option>', {
                                value: item.Classstreamid,
                                text: item.ClassStream
                            }));
                        });
                    }
                });
            }
        });
        $('#closebtnaddmodal').on('click', function () {
            $('#subjectContainer').empty();
            $('#exampleModal').modal('hide');
        });
    });
   
    
</script>
<script>

    $(document).ready(function () {

        $('#CloseModalAddSyllabus').on('click', function () {
            $('.AddSyllabusForm')[0].reset();
            $('#AddSyllabusModal').modal('hide');
        });
        $('#CloseModalUpdateSyllabus').on('click', function () {
            $('.AddSyllabusForm')[0].reset();
            $('#UpdateSyllabusModal').modal('hide');
        });
        async function setsubjectacctoclass(id) {
            await $.ajax({
                url: '/admin/GetSubjectandSectionByClassId', type: 'get', data: { id: id },
                success: function (res) {
                    console.log(res.subject);
                    if (res && res.subject && res.subject.length > 0) {
                        let $subjectDropdown = $('.subject-dropdown');
                        $subjectDropdown.empty();

                        $subjectDropdown.append('<option value="">--Select Subject--</option>');

                        $.each(res.subject, function (index, subject) {
                            $subjectDropdown.append(`<option value="${subject.SubjectId}">${subject.Subject}</option>`);
                        });
                    } else {
                        $('#subjectId').empty().append('<option value="">No subjects available</option>');
                    }
                },
                error: function (xhr) {
                    console.log(xhr);
                }
            });
        }
        $('#classId').change(async function () {
            let id = $(this).val();
            await setsubjectacctoclass(id);
        });

        $('.AddSyllabusForm').on('submit', function (e) {
            debugger;
            e.preventDefault();

            Swal.fire({
                title: 'Please Wait!',
                allowOutsideClick: false,
                allowEscapeKey: false,
                text: 'Processing your request...',
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            var data = new FormData(this);
            var fileUpload = document.getElementById("attachment");
            if (fileUpload.files.length > 0) {
                for (var i = 0; i < fileUpload.files.length; i++) {
                    data.append("attachment", fileUpload.files[i]);
                }
            }

            var upfileUpload = document.getElementById("upattachment");
            if (upfileUpload.files.length > 0) {
                for (var i = 0; i < upfileUpload.files.length; i++) {
                    data.append("attachment", upfileUpload.files[i]);
                }
            }
            $.ajax({
                url: '/admin/AddSyllabus',
                type: 'post',
                data: data,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.status) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: response.message,
                            didClose: () => { location.reload(true); }
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message
                        });
                    }
                },
                error: function (xhr) {
                    console.log(xhr);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong. Please try again.'
                    });
                }
            });
        });

        $(".deleteSyllabus").on('click', function () {
            let id = $(this).data('id');
            Swal.fire({
                title: 'Are you sure?',
                text: 'Do you really want to delete this item?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Delete',
                cancelButtonText: 'Cancel',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'mx-2 btn btn-danger',
                    cancelButton: 'mx-2 btn btn-light'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Please Wait!',
                        text: 'Processing Your Request...',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/admin/DeleteSyllabus',
                        type: 'get',
                        data: { id: id },
                        success: function (res) {
                            console.log(res);
                            if (res.status) {
                                Swal.fire({
                                    title: 'Success',
                                    text: res.message,
                                    icon: 'success',
                                    didClose: () => {
                                        location.reload(true);
                                    }
                                });
                            } else {
                                Swal.fire({
                                    title: 'Error',
                                    text: res.message,
                                    icon: 'warning'
                                });
                            }
                        },
                        error: function (xhr) {
                            Swal.fire({
                                title: 'Error',
                                text: 'Server Error. Try Again Later!',
                                icon: 'error'
                            });
                            console.log(xhr);
                        }
                    });
                } else {
                    Swal.fire('Cancelled', 'Your item is safe.', 'info');
                }
            });
        });

        $('.updateSyllabus').on('click', function () {
            debugger
            Swal.fire({
                title: 'Please Wait!',
                text: 'Processing Your Request...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });
            let id = $(this).data('id');

            $.ajax({
                url: '/admin/GetSyllabusById',
                type: 'get',
                data: { id, id },
                success: function (res) {
                    console.log(res);
                    Swal.close();
                    if (res) {
                        $('#id').val(res[0].id)
                        $('#upclassId').val(res[0].classId)
                        $('#setclassid').val(res[0].classId)
                        setsubjectacctoclass(res[0].classId).then(() => {
                            $('#upsubjectId').val(res[0].subjectId);
                        });
                        $('#upacademicYear').val(res[0].academicYear);
                        $('#setacademiyear').val(res[0].academicYear);
                        $('#upinstitutionType').val(res[0].institutionType);
                        $('#upeducationLevel').val(res[0].educationLevel);
                        $('#UpdateSyllabusModal').modal('show');
                    }
                    else {
                        Swal.fire({ title: 'Error', text: 'Some error occured', icon: 'error' });
                    }
                },
                error: function (xhr) {
                    Swal.fire({
                        title: 'Error',
                        text: 'Server Error. Try Again Later!', icon: 'error'
                    });
                }
            });
        });
    });
</script>

