    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom-0">
                <h1 class="modal-title fs-5" id="UpdateSyllabusModalLabel">Update Syllabus</h1>
                <button type="button" class="btn-close" id="CloseModalUpdateSyllabus"></button>
            </div>
            <div class="modal-body">
                <form class="AddSyllabusForm">
                    <input type="hidden" name="id" id="id" />
                    <div class="row">
                        <!-- Institution Type -->
                        <!--<div class="col-sm-4 mb-2">
