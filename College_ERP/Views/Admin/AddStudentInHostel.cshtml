<script>
    $(document).ready(function () {

        $('.blockdropdown').change(async function () {
            debugger
            Swal.fire({
                title: 'Please wait!',
                text: 'Floor Loading...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });
            let id = $(this).val();
            let res = await fetch(`/admin/GetFloorByBlockForAddStudent?id=${id}`);
            if (res.ok) {
                let data = await res.json();

                let floorDropdown = $('.floordropdown');
                floorDropdown.empty();
                floorDropdown.append('<option selected disabled>--Select floor--</option>');
                console.log(data);
                let floor = parseInt(data);
                debugger
                $.each(data, function (index, item) {
                    floorDropdown.append(`<option value="${item}">${item == 0 ? "Ground" : item}</option>`);
                });
                Swal.close();
            } else {
                console.error(`HTTP error! Status: ${res}`);
            }

        });

        $('.showHistory').on('click', async function () {
            Swal.fire({
                title: 'Please wait!',
                text: 'Processing your request...',
                allowEscapeKey: false,
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });
            let id = $(this).data('stid');

            try {
                const response = await fetch(`/warden/StudentFeeHistory?studentidhostelid=${id}`);
                const data = await response.json();

                let tbody = $('#feeHistoryBody'); // <-- Directly using tbody ID
                tbody.empty();

                if (Array.isArray(data) && data.length > 0) {
                    data.forEach((item, index) => {
                        let slipLink = item.FeeSlipPath
                            ? `<a href="${item.FeeSlipPath}"  target="_blank">View Slip</a>`
                            : 'N/A';

                        let row = `
            <tr>
                <td>${index + 1}</td>
                <td>${item.StudentName || ''}</td>
               <td>${item.RemainingFee ? '₹ ' + Number(item.RemainingFee).toLocaleString('en-IN') : 'N/A'}</td>
                <td>${item.TotalFee ? '₹ ' + Number(item.TotalFee).toLocaleString('en-IN') : ''}</td>
                <td>${item.FeesSubmitted ? '₹ ' + Number(item.FeesSubmitted).toLocaleString('en-IN') : ''}</td>
                <td>${item.transactionid || 'N/A'}</td>
                <td>${item.DueDateString || 'N/A'}</td>
                <td>${slipLink}</td>
            </tr>
        `;
                        tbody.append(row);
                    });
                    
                    $('#showHistoryModal').modal('show');
                } else {
                    tbody.append(`<tr><td colspan="9">No fee history found.</td></tr>`);
                }

            } catch (error) {
                console.error('Error fetching fee history:', error);
                Swal.fire('Error', 'Something went wrong while fetching data.', 'error');
            } finally {
                Swal.close();
            }
        });
    });
</script>












