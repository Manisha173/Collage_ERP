                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Issuable Status:</div>
                                <div class="info-value-isolated">
                                    @if (Model[0].isIssuable)
                                    {
                                        <span class="status-badge-isolated status-available-isolated">
                                            <i class="fas fa-check-circle" style="margin-right: 0.25rem !important;"></i>Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge-isolated status-unavailable-isolated">
                                            <i class="fas fa-times-circle" style="margin-right: 0.25rem !important;"></i>Not Available
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Number of Pages:</div>
                                <div class="info-value-isolated">@Model[0].numberOfPages</div>
                            </div>
                        </div>
                    </div>

                    <!-- Purchase & Financial Information -->
                    <div class="section-header-isolated">
                        <i class="fas fa-shopping-cart"></i>Purchase & Financial Information
                    </div>
                    <div class="row-isolated">
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Purchase Date:</div>
                                <div class="info-value-isolated">@Model[0].purchasingDate</div>
                            </div>
                        </div>
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Source:</div>
                                <div class="info-value-isolated">@Model[0].source</div>
                            </div>
                        </div>
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Price:</div>
                                <div class="info-value-isolated">
                                    <span class="price-highlight-isolated">₹@Model[0].price</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Supplier:</div>
                                <div class="info-value-isolated">@Model[0].supplier</div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    <div class="section-header-isolated">
                        <i class="fas fa-tags"></i>Additional Information
                    </div>
                    <div class="row-isolated">
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Languages:</div>
                                <div class="info-value-isolated">@Model[0].bookLanguages</div>
                            </div>
                        </div>
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Accession Number:</div>
                                <div class="info-value-isolated">@Model[0].accessionNumber</div>
                            </div>
                        </div>
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Location:</div>
                                <div class="info-value-isolated">@Model[0].bookLocation</div>
                            </div>
                        </div>
                        <div class="col-isolated">
                            <div class="info-row-isolated">
                                <div class="info-label-isolated">Subject:</div>
                                <div class="info-value-isolated">@Model[0].subject</div>
                            </div>
                        </div>
                    </div>

                    <!-- Full Width Sections -->
                    <div class="section-header-isolated">
                        <i class="fas fa-comment-alt"></i>Remarks & Content
                    </div>

                    @if (!string.IsNullOrEmpty(Model[0].bookRemarks))
                    {
                        <div class="full-width-section-isolated">
                            <div class="full-width-label-isolated">Remarks:</div>
                            <div class="full-width-value-isolated">@Model[0].bookRemarks</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model[0].bookContent))
                    {
                        <div class="full-width-section-isolated">
                            <div class="full-width-label-isolated">Content Description:</div>
                            <div class="full-width-value-isolated">@Model[0].bookContent</div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>