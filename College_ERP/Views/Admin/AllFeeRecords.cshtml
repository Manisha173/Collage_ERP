    $(document).ready(function () {
        initializeDataTable()

        $('.btn-close').on('click', function () {
            $('#alertmsgfee').css('display', 'none');
            $('#feeRecordsForm')[0].reset();
            $('#busFeeForm')[0].reset();
        });

        $('.paymentmode').change(function () {
            if ($(this).val() == "online") {
                $('.transactid').removeClass('d-none');
            } else if ($(this).val() == 'offline') {
                $('.transactid').addClass('d-none');
            }
        });

    });
    //date restriction
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('PaymentDate').setAttribute('max', today);
    //select section
    $('#ClassId').on('change', function () {
        debugger
        var classId = $(this).val();
        var sectionDropdown = $('#SectionId');
        sectionDropdown.empty().append('<option value="">Loading......</option>');

        if (classId !== "") {
            $.ajax({
                url: '@Url.Action("GetSectionsByClass", "Admin")',
                type: 'GET',
                data: { classId: classId },
                success: function (sections) {
                    sectionDropdown.empty().append('<option value="">Select Section</option>');
                    $.each(sections, function (i, section) {
                        sectionDropdown.append(`<option value="${section.SectionId}">${section.SectionName}</option>`);
                    });
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Error fetching sections!',
                    });
                    sectionDropdown.empty().append('<option value="">Select Section</option>');
                }

            });
        } else {
            sectionDropdown.empty().append('<option value="">Select Section</option>');
        }
    });
    //load students
    async function fetchAndBindStudents(classId, sectionId, academicYear) {
        Swal.fire({
            title: 'Loading Student...',
            text: 'Please wait while we fetch the details.',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading()
            }
        });

        if (!classId || !sectionId || !academicYear || academicYear === "Select academic year") {
            $('#StudentId').html('<option selected value="0">Select Student</option>');
            Swal.close();
            return;
        }

        try {
            const students = await $.ajax({
                url: '/Admin/GetStudentsByClassSection',
                type: 'GET',
                data: {
                    classId: classId,
                    sectionId: sectionId,
                    academicYear: academicYear
                }
            });

            const $studentList = $('#StudentId');
            $studentList.empty().append('<option selected value="0">Select Student</option>');

            if (students.length > 0) {
                $.each(students, function (i, student) {
                    $studentList.append(`<option value="${student.StudentId}">${student.StudentName}</option>`);
                });
            } else {
                $studentList.append('<option disabled>No students found</option>');
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: 'Failed to fetch student list.'
            });
            return;
        }

        Swal.close();
    }

    $('#ClassId, #SectionId, #AcademicYear').on('change', async function () {
        debugger;

        const classId = $('#ClassId').val();
        const sectionId = $('#SectionId').val();
        const academicYear = $('#AcademicYear').val();
        await fetchAndBindStudents(classId, sectionId, academicYear);
    });

    $('#btnSubmit').on('click', function (e) {
        debugger
        e.preventDefault();
        const stId = $('#StudentId').val();
        if (!stId || stId === "0") {
            Swal.fire({
                icon: 'warning',
                title: 'No Student Selected',
                text: 'Please select a student before proceeding.',
                confirmButtonText: 'OK'
            });
            return;
        }
        var form = $('#feeRecordsForm')[0];
        var formData = new FormData(form);
        var feeId = $('#FeeId').val();
        formData.set('FeeId', feeId);

        // Check button text to determine action
        var buttonText = $('#btnSubmit').text().trim();
        var isUpdate = (buttonText === 'Update Fee Record');

        Swal.fire({
            title: 'Please wait...',
            text: isUpdate ? 'Updating fee statement...' : 'Saving fee statement...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => Swal.showLoading()
        });
        const studentId = $('#StudentId').val();
        if (!studentId || studentId === "0") {
            Swal.fire({
                icon: 'warning',
                title: 'No Student Selected',
                text: 'Please select a student before proceeding.',
                confirmButtonText: 'OK'
            });
            return;
        }

        $.ajax({
            url: isUpdate ? '/Admin/UpdateFeeRecord' : '/Admin/AllFeeRecords',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                Swal.close();
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: res.message,
                        didClose: () => location.href = '/admin/AllFeeRecords'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: res.message
                    });
                }
            },
            error: function (xhr) {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong: ' + xhr.responseText
                });
            }
        });
    });

    //get by id
    function editFeeRecord(feeId) {
        Swal.fire({
            title: 'Please wait...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => Swal.showLoading()
        });
        $.ajax({
            url: '/Admin/GetAllFeeRecordById',
            type: 'GET',
            data: { id: feeId },
            success: function (data) {
                    $('#FeeId').val(data.FeeId);
                    $('#AcademicYear').val(data.AcademicYear);
                    $('#Amount').val(data.Amount);

                    $('#BillingPeriod').val(data.BillingPeriod);
                    $('#FeesPaid').val(data.FeesPaid);
                    $('#RemainingFees').val(data.RemainingFees);
                    $('#BillingMonth').val(data.BillingMonth);
                    $('#PaymentMode').val(data.PaymentMode);
                    const rawDate = data.PaymentDate;
                    const timestamp = parseInt(rawDate.replace(/\/Date\((\d+)\)\//, '$1'));
                    const date = new Date(timestamp);
                    const formattedDate = date.toISOString().split('T')[0];
                    $('#PaymentDate').val(formattedDate);
                    if (data.PaymentMode === "online") {
                        $('#transactionid').val(data.transactionid);
                        $('.transactid').removeClass('d-none');
                    }


                    $('#ClassId').val(data.ClassId).trigger('change');

                    // Wait for section and student dropdowns to be populated
                    $.ajax({
                        url: '@Url.Action("GetSectionsByClass", "Admin")',
                        type: 'GET',
                        data: { classId: data.ClassId },
                        success: function (sections) {
                            const sectionDropdown = $('#SectionId');
                            sectionDropdown.empty().append('<option value="">----Select Section----</option>');
                            $.each(sections, function (i, section) {
                                sectionDropdown.append(`<option value="${section.SectionId}">${section.SectionName}</option>`);
                            });

                            $('#SectionId').val(data.SectionId).trigger('change');

                            fetchAndBindStudents(data.ClassId, data.SectionId, data.AcademicYear).then(() => {
                                $('#StudentId').val(data.StudentId);
                            });
                        },
                        error: function () {
                            Swal.fire("Error", "Failed to fetch section list", "error");
                        }
                    });

                $('#btnSubmit').text('Update Fee Record');

                    $('#staticBackdrop').modal('show');
            },
            error: function () {
                Swal.fire("Error", "Failed to fetch fee record", "error");
            }
        });
    }
