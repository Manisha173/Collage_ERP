    $(document).ready(function () {
        let totalAmount = 0;
        $('#FeesPaid').on('input', function () {
            debugger;
            totalAmount = parseFloat($('#HiddenRemainingFees').val()) > 0 ? parseFloat($('#HiddenRemainingFees').val()) : parseFloat($('#Amount').val());
            let tootalamount = totalAmount;
            let paid = parseFloat($(this).val()) || 0;

            if (paid > totalAmount) {
                Swal.fire("Warning", "Paid amount cannot exceed the total or remaining fee.", "warning");
                $(this).val('');
                $('#RemainingFees').val(tootalamount);
                return;
            }

            let remaining = totalAmount - paid;
            $('#RemainingFees').val(remaining >= 0 ? remaining.toFixed(2) : 0);
        });

    });
    $(document).ready(function () {
        function handleBillingPeriodUI() {
            var period = $('#BillingPeriod').val().toLowerCase();

            if (period === 'yearly') {
                $('.fees-extra').removeClass('d-none');
                $('#monthDropdownContainer').addClass('d-none');
                $('#BillingMonth').val('');
            } else if (period === 'monthly') {
                $('.fees-extra').addClass('d-none');
                //$('#FeesPaid, #RemainingFees').val('');
                $('#FeePaid').val($('#Amount'));
                $('#monthDropdownContainer').removeClass('d-none');
            } else {
                $('.fees-extra').addClass('d-none');
                $('#monthDropdownContainer').addClass('d-none');
                $('#BillingMonth').val('');
            }
        }

        // Re-check when class changes and billing period is set dynamically
        $("#ClassId").on("change", function () {
            let id = $(this).val();
            $.get("/admin/GetTotalFeeByClassId", { id: id }).done((res) => {
                $("#Amount").val(res.Amount);
                $("#BillingPeriod").val(res.BillingPeriod);
                handleBillingPeriodUI();
            }).fail(() => {
                Swal.fire("Error", res.message, "error")
            });
        });

        $('#BillingPeriod').on('input', handleBillingPeriodUI);

        $('#StudentId').on('change', function () {
            let studentId = $(this).val();

            if (studentId) {
                $.ajax({
                    type: 'POST',
                    url: '/admin/GetStudentRemainingFee',
                    data: { studentId: studentId },
                    success: function (res) {
                        if (res.success) {
                            $('#RemainingFees').val(res.remainingFee ?? 0);
                            if (parseFloat(res.remainingFee || 0) === 0) {
                                $('#alertmsgfee').css('display', 'block');
                                $('#btnSubmit').prop('disabled', true);
                                $('#FeesPaid').prop('readonly', true);
                            } else {
                                $('#FeesPaid').prop('readonly', false);
                                $('#btnSubmit').prop('disabled', false);
                                $('#alertmsgfee').css('display', 'none');
                            }

                            $('#HiddenRemainingFees').val(res.remainingFee ?? 0);
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Oops!',
                            text: 'Something went wrong.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });

                    }
                });
            } else {
                $('#FeesPaid').val('');
                $('#RemainingFee').val('');
            }
        });
    });

