<script>
    $(document).ready(function () {
        const specializationSelect = new TomSelect("#specializationInput", {
            plugins: ['remove_button'],
            create: true,
            maxItems: null,
            placeholder: "Add Specialization (if any)"
        });

        // Stream
        new TomSelect("#streamInput", {
            plugins: ['remove_button'],
            create: true,
            onItemAdd: function () {
                this.setTextboxValue('');
                this.refreshOptions();
            },
            render: {
                option: function (data, escape) {
                    return '<div class="d-flex"><span>' + escape(data.value) + '</span></div>';
                },
                item: function (data, escape) {
                    return '<div>' + escape(data.value) + '</div>';
                }
            }
        });

        // Diploma
        //new TomSelect("#diplomaType", {
        //    plugins: ['remove_button'],
        //    create: true,
        //    onItemAdd: function () {
        //        this.setTextboxValue('');
        //        this.refreshOptions();
        //    },
        //    render: {
        //        option: function (data, escape) {
        //            return '<div class="d-flex"><span>' + escape(data.value) + '</span></div>';
        //        },
        //        item: function (data, escape) {
        //            return '<div>' + escape(data.value) + '</div>';
        //        }
        //    }
        //});

        // Class (multi-select)
        $('.multiClassSelector').select2({
            dropdownParent: $('#exampleModal'),
            placeholder: 'Select Class'
        });

        const educationOptions = {
            school: [
                { value: "secondary", text: "Secondary (Class Nursery – 10)" },
                { value: "senior_secondary", text: "Senior Secondary (Class 11 – 12)" }
            ],
            college: [
                { value: "diploma", text: "Diploma" },
                { value: "ug", text: "Undergraduate (UG)" },
                { value: "pg", text: "Postgraduate (PG)" },
                { value: "phd", text: "Doctorate (Ph.D.)" }
            ]
        };

        const classOptions = [
            "Nursery", "LKG", "UKG",
            "Class 1", "Class 2", "Class 3", "Class 4", "Class 5",
            "Class 6", "Class 7", "Class 8", "Class 9", "Class 10"
        ];

        // Institution Type Change
        $('#institutionType').on('change', function () {
            const selectedType = $(this).val();
            const $educationLevel = $('#educationLevel');

            $educationLevel.empty().append('<option selected disabled>--Select Education Level--</option>');

            // Hide all dependent fields
            $('#classWrapper').hide();
            $('#multiClassWrapper').hide();
            $('#streamWrapper').hide();
            $('#diplomaTypeWrapper').hide();
            $('#ugTypeWrapper').hide();

            if (educationOptions[selectedType]) {
                $.each(educationOptions[selectedType], function (index, item) {
                    $educationLevel.append($('<option>', {
                        value: item.value,
                        text: item.text
                    }));
                });
            }
        });

        // Education Level Change
        $('#educationLevel').on('change', function () {
            const selectedLevel = $(this).val();
            const $classInput = $('#classInput');

            // Reset and hide all
            $('#classWrapper').hide();
            $('#multiClassWrapper').hide();
            $('#streamWrapper').hide();
            $('#diplomaTypeWrapper').hide();
            $('#ugTypeWrapper').hide();
            $('#pgTypeWrapper').hide();
            $('#phdTypeWrapper').hide();
            $('#diplomaTypeWrapper').hide();
            $('#specializationWrapper').hide();
            specializationSelect.clear();
            $classInput.off('input');

            if (selectedLevel === 'secondary') {
                $('#classWrapper').show();
                $classInput.empty();

                $.each(classOptions, function (index, cls) {
                    $classInput.append($('<option>').val(cls).text(cls));
                });

            } else if (selectedLevel === 'senior_secondary') {
                debugger
                const select = document.getElementById('multiClassSelect');
                for (let i = 0; i < select.options.length; i++) {
                    select.options[i].selected = true;
                }
                $('#multiClassSelect').trigger('change');
                $('#multiClassWrapper').show();
                $('#streamWrapper').show();

            } else if (selectedLevel === 'ug') {
                $('#ugTypeWrapper').show();
                $('#specializationWrapper').show();
            } else if (selectedLevel === 'pg') {
                $('#pgTypeWrapper').show();
                $('#specializationWrapper').show();
            } else if (selectedLevel === 'diploma') {
                $('#diplomaTypeWrapper').show();
                $('#specializationWrapper').show();
            } else if (selectedLevel === 'phd') {
                $('#phdTypeWrapper').show();
                $('#specializationWrapper').show();
            }
        });
    });
</script>


<script>
    $(document).ready(function () {

        var table = $('#classtable').DataTable();
        $('#institutionfilter').change(function () {
            let fav = $(this).val();
            if (fav === "school") {
                $('#educationfiltercl').hide();
                $('#educationfiltersc').show();
            } else if (fav === "college") {
                $('#educationfiltersc').hide();
                $('#educationfiltercl').show();
            } else {
                $('#educationfiltercl').hide();
                $('#educationfiltersc').hide();
                $('#educationfiltersc').val('');
                $('#educationfiltercl').val('');
                table.columns().every(function () {
                    this.search('');
                });
            }
            table.column(1).search(fav).draw();
        })

        $('#educationfiltersc').change(function () {
            let fav = $(this).val();
            if (fav) {
                table.column(2).search('^' + fav + '$', true, false).draw(); // exact match
            } else {
                table.column(2).search('').draw(); // clear filter
            }
        });
        $('#educationfiltercl').change(function () {
            let fav = $(this).val();
            table.column(2).search(fav).draw();
        })

        $('.showstream').on('click', function () {
            let classid = $(this).data('classid');
            Swal.fire({
                title: 'Please wait...',
                text: 'Processing your request...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.get('/Admin/GetStreamByClassId?classid=' + classid, function (data) {
                if (data && data.length > 0) {
                    let html = '';
                    let sr = 1;
                    data.forEach(function (item) {
                        html += `<tr>
                                    <td>${sr++}</td>
                                    <td>${item.ClassName}</td>
                                    <td>${item.ClassStream}</td>
                                </tr>`;
                    });

                    $('#streambody').html(html);
                    Swal.close();
                    $('#StreamModal').modal('show');
                } else {
                    Swal.fire('No data found', '', 'info');
                }
            });
        });
    });
</script>




<script>
    $(document).ready(function () {

        $('#classForm').submit(function (e) {
            e.preventDefault();
            debugger
            Swal.fire({
                title: 'Please wait...',
                text: 'Processing your request...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            function getFirstFilledValue(selectors) {
                for (let selector of selectors) {
                    let val = $(selector).val();

                    // If multi-select (array with values)
                    if (Array.isArray(val) && val.length > 0) {
                        return val; // full array
                    }

                    // If single value field (string) and not empty
                    if (typeof val === 'string' && val.trim().length > 0) {
                        return val; // clean string
                    }
                }
                return null;
            }

            const formData = {
                InstitutionType: $('#institutionType').val(),
                EducationLevel: $('#educationLevel').val(),
                Class: getFirstFilledValue([
                    '#classInput',
                    '#multiClassSelect',
                    '#diplomaType',
                    '#ugType',
                    '#pgType',
                    '#phdType'
                ]),
                Stream: getFirstFilledValue([
                    '#specializationInput',
                    '#streamInput'
                ])
            };

            $.ajax({
                url: '/Admin/AddClass',
                type: 'POST',
                data: JSON.stringify(formData),
                contentType: 'application/json',
                beforeSend: function () {
                    Swal.fire({
                        title: 'Please wait...',
                        text: 'Submitting class information',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function (response) {
                    if (response.success) {
                        Swal.fire('Success!', response.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Server error occurred.', 'error');
                }
            });
        });

    });


    function resetForm() {
        $('#ClassForm')[0].reset();
        $('#ClassId').val('');
        $('#btnSubmit').text('Add Class');
    }
    //delete class
    function deleteClass(ClassId) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This class will be deleted!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {

                // Show loading spinner
                Swal.fire({
                    title: 'Deleting...',
                    text: 'Please wait',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Perform deletion
                $.post('/admin/deleteclass', { ClassId: ClassId }, function (res) {
                    if (res.success) {
                        Swal.fire('Deleted!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                }).fail(function () {
                    Swal.fire('Error', 'Server error occurred.', 'error');
                });
            }
        });
    }


    function editClass(id) {
        Swal.fire({
            title: 'Please wait...',
            text: 'Processing your request...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        $.get('/Admin/GetClassById?id=' + id, function (data) {
            if (data) {
                $('#EditClassId').val(data.ClassId);
                $('#EditClassName').val(data.ClassName);
                $('#EditDescription').val(data.ClassDescription);

                Swal.close();
                $('#editClassModal').modal('show');
            }
        });
    }

