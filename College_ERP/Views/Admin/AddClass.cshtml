                        <input type="text" id="EditClassName" name="ClassName" class="form-control" />

                    </div>

                    @*<div class="col-md-6 mb-3">
                            <label> Description</label>
                            <textarea type="text" id="EditDescription" name="ClassDescription" class="form-control"></textarea>
                        </div>*@

