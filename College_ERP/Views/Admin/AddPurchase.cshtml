    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5 d-flex justify-content-between" id="exampleModalLabel">
                        <span>Add Purchase Material</span><!-- Button trigger modal -->

                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="purchasematerialform">
                        <div class="row px-5">
                            <div class="col-sm-3">
                                <label class="form-label pt-1"><strong>Category Name</strong></label>
                            </div>
                            <div class="col-md-9">
                                <select data-action="add" id="categoryName" name="categoryName" class="catename form-select" required>
                                    <option value="">Select Category</option>
                                    @if (ViewData["categories"] != null)
                                    {
                                        foreach (var category in categories)
                                        {
                                            <option value="@category.CategoryId">@category.CategoryName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Material Name</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <select name="materialName" id="materialName" class="mtname form-select" required>
                                    <option value="">--Select Material--</option>

                                </select>
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Supplier Name</strong></label>
                            </div>
                            <div class="col-sm-9">
                                
                                <input type="text" id="supplierName" name="supplierName" class="form-control" required placeholder="Enter Supplier Name" />                              
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Purchase Price</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="number" id="price" name="purchasePrice" class="form-control" required placeholder="Enter Price" />
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Quantity</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="text" id="stquantity" name="quantity" class="form-control" required placeholder="Enter Quantity" />
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                          
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Puchase Medium</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <select type="text" id="purchaseMedium" name="purchaseMedium" class="form-select" required>
                                    <option value="">Select purchase Medium</option>
                                    <option value="online">Online</option>
                                    <option value="offline">Offline</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Bill No</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="text" id="billNO" name="billNo" class="form-control" required placeholder="Enter Bill No" />
                                <span id="BillNoError" style="color:red;"></span>
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Bill Slip</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="file" id="billSlip" name="billSlip" class="form-control" required placeholder="Enter Bill Slip" />
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <button type="submit" id="btnSubmit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

   
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title mb-3 d-flex justify-content-between">
                            <span>Purchase List</span> 
                            <div class="w-25">
                                <select id="catfilter" class="form-select">
                                    <option selected value="">--Search By Category--</option>
                                    @if (ViewData["categories"] != null)
                                    {
                                        foreach (var category in categories)
                                        {
                                            <option value="@category.CategoryName">@category.CategoryName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                Add Purchase Material
                            </button>
                        </h4>
                        <div class="table-responsive">
                            <table id="purchaseTable" class="table table-bordered  w-100">
                                <thead>
                                    <tr>
                                        <th>SR</th>
                                        <th>Category Name</th>
                                        <th>Material Name</th>
                                        <th>Supplier Name</th>
                                        <th>Purchase Medium</th>
                                        <th>Purchase Price</th>
                                        <th>Bill No</th>
                                        <th>Quantity</th>
                                        <th class="text-center">Bill Slip</th>
                                        <th>Created At</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (data != null)
                                    {
                                        int count = 1;
                                        foreach (var item in data)
                                        {
                                            <tr>
                                                <td>@count</td>
                                                <td data-ctid="@item.categoryId">@item.categoryName</td>
                                                <td data-matid="@item.materialId">@item.materialName</td>
                                                <td>@item.supplierName</td>
                                                <td>@item.purchaseMedium</td>
                                                <td>₹ @item.purchasePrice.ToString("N2")</td>
                                                <td>@item.billNo</td>
                                                <td>@item.quantity</td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(item.billSlipName))
                                                    {
                                                        <a href="@item.billSlipName" title="Bill Slip" target="_blank">View</a>
                                                    }
else
                    {
                        <span>N/A</span>
                    }
                                                </td>
                                                <td>@item.createdAt.ToString("dd-MMM-yyyy")</td>
                                                <td class="text-center">
                                                    <a role="button" title="Update" data-id="@item.purchaseId" class="btn btn-sm updateMat p-0"> <i data-feather="edit" class="text-warning" style="width:22px; height:22px;"></i></a>
                                                    <a role="button" class="btn btn-sm deletemat p-0" data-id="@item.purchaseId" title="Delete"><i data-feather="trash-2" class="text-danger" style="width:22px; height:22px;"></i></a>

                                                </td>
                                            </tr>
                                            count++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
            </div>
        </div>
    </div>
    <!--Modal to Update Stock Material-->
    <div class="modal fade" tabindex="-1" id="updateModal" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title">Update Purchase Material</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="purchasematerialform">
                        <input type="hidden" value="0" name="purchaseId" id="purchaseId" />
                        <div class="row px-5">
                            <div class="col-sm-3">
                                <label class="form-label pt-1"><strong>Category Name</strong></label>
                            </div>
                            <div class="col-md-9">
                                <select data-action="update" id="mdcategoryName" name="categoryName" class="catename form-select" required>
                                    <option value="">Select Category</option>
                                    @if (ViewData["categories"] != null)
                                    {
                                        foreach (var category in categories)
                                        {
                                            <option value="@category.CategoryId">@category.CategoryName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Material Name</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <select id="updatematerialname" name="materialName" class="form-select" required>
                                    <option value="">Select Material</option>

                                </select>
                            </div>
                        </div>
                        
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Supplier Name</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="text" id="ssupplierName" name="supplierName" class="form-control" required placeholder="Enter Supplier Name" />
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Purchase Price</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="number" id="prprice" name="purchasePrice" class="form-control" required placeholder="Enter Price" />
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Quantity</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="text" id="prquantity" name="quantity" class="form-control" required placeholder="Enter Quantity" />
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Puchase Medium</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <select type="text" id="prpurchaseMedium" name="purchaseMedium" class="form-select" required>
                                    <option value="">--Select purchase Medium--</option>
                                    <option value="online">Online</option>
                                    <option value="offline">Offline</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Bill No</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="text" id="prbillNO" name="billNo" class="form-control" required placeholder="Enter Bill No" />
                                <span id="PRBillNoError" style="color:red;"></span>
                            </div>
                        </div>
                        <div class="row mt-3 px-5">
                            <div class="col-md-3">
                                <label class="form-label pt-1"><strong>Bill Slip</strong></label>
                            </div>
                            <div class="col-sm-9">
                                <input type="file" id="billSlip" name="billSlip" class="form-control" />
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <button type="submit" id="btnSubmit" class="btn btn-primary">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

