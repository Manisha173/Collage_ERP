    function initializeDataTable() {
        debugger;

        // Export columns
        const exportColumns = [0, 1, 2, 3, 4, 5, 6, 7, 9];

        // PDF column widths
        const pdfColumnWidths = ['*', '*', '*', '*', '*', '*', '*', '*', '*'];

        let table = $('#purchaseTable').DataTable({
            ordering: false,
            autoWidth: false,
            pageLength: 10,
            lengthMenu: [[10, 20, 50, 100], [10, 20, 50, 100]],
            dom: '<"top"lBf>rt<"bottom"ip><"clear">',
            buttons: [
                {
                    extend: 'excel',
                    text: '<i class="fa-solid fa-file-excel" style="color:#287f71;font-size:25px;"></i>',
                    className: 'icon-btn',
                    titleAttr: 'Export Excel',
                    exportOptions: {
                        columns: exportColumns
                    }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fa-solid fa-file-pdf" style="color:#dc3545;font-size:25px;"></i>',
                    className: 'icon-btn',
                    titleAttr: 'Export PDF',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    exportOptions: {
                        columns: exportColumns
                    },
                    customize: function (doc) {

                        // Default font settings
                        doc.defaultStyle.fontSize = 6;
                        doc.defaultStyle.alignment = 'center';

                        // Header settings
                        doc.styles.tableHeader.fontSize = 7;
                        doc.styles.tableHeader.bold = true;
                        doc.styles.tableHeader.alignment = 'center';

                        // Set column widths
                        doc.content[1].table.widths = pdfColumnWidths;

                        // Center align all table cells
                        var body = doc.content[1].table.body;

                        for (var i = 0; i < body.length; i++) {
                            for (var j = 0; j < body[i].length; j++) {
                                body[i][j].alignment = 'center';
                                body[i][j].margin = [2, 4, 2, 4];
                            }
                        }
                    }
                }
            ]
        });

        return table;
    }

    $(document).ready(function () {
        var ttbl = initializeDataTable();

        $('#catfilter').on('change', function () {
            debugger
            var filval = $(this).val();
            ttbl.column(1).search(filval).draw();
        });
    })

    async function getmaterialbycatId(id, action) {
        await $.ajax({
            url: '/admin/GetMaterial', type: 'get', data: { id: id },
            success: function (res) {
                if (res) {
                    console.log(res);
                    let mattag = action == "update" ? $("#updatematerialname") : $("#materialName")
                    mattag.empty();
                    let materialop = '<option value="">--Select Material--</option>';
                    $.each(res, function (index, item) {
                        materialop += '<option value="' + item.materialId + '">' + item.materialName + '</option>';
                    });
                    mattag.append(materialop);
                } else {
                    Swal.fire({ title: 'Warning', text: 'No Material Found Related to this category!', icon: 'warning' });
                }
            },
            error: function (xhr) {
                Swal.fire({ title: 'Error', text: 'Server Error', icon: 'error' });
            }
        });
    }
    $(".catename").change(async function () {
        let id = $(this).val();
        let action = $(this).attr("data-action")
        await getmaterialbycatId(id, action)
    });

    $(".purchasematerialform").on('submit', function (e) {
        e.preventDefault();
        Swal.fire({
            title: 'Please Wait!',
            text: 'Processing Your Request...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => { Swal.showLoading(); }
        });
        debugger
        let formdata = new FormData(this);
        if ($("#billSlip").get(0).files.length > 0) {
            let file = $("#billSlip").get(0).files[0];
            formdata.append("billSlip", file);
        }

        $.ajax({
            url: '/admin/AddPurchase', type: 'post', data: formdata, contentType: false, processData: false,
            success: function (res) {
                if (res.status) {
                    Swal.fire({
                        title: 'Success', text: res.message, icon: 'success',
                        didClose: () => { location.reload(true); }
                    });
                }
                else {
                    Swal.fire({ title: 'Error', text: res.message, icon: 'error' });
                }
            },
            error: function (xhr) {
                Swal.fire({
                    title: 'Error',
                    text: 'Server Error. Try Again Later!', icon: 'error'
                });
                console.log(xhr)
            }
        });
    })
    $(".deletemat").on('click', function () {
        let id = $(this).data('id');

        Swal.fire({
            title: 'Are you sure?',
            text: 'Do you really want to delete this item?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete',
            cancelButtonText: 'Cancel',
            reverseButtons: true,
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'mx-2 btn btn-danger',
                cancelButton: 'mx-2 btn btn-light'
            },
            buttonsStyling: false
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Please Wait!',
                    text: 'Processing Your Request...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/admin/DeletePurchase',
                    type: 'get',
                    data: { id: id },
                    success: function (res) {
                        console.log(res);
                        if (res.status) {
                            Swal.fire({
                                title: 'Success',
                                text: res.message,
                                icon: 'success',
                                didClose: () => {
                                    location.reload(true);
                                }
                            });
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: res.message,
                                icon: 'warning'
                            });
                        }
                    },
                    error: function (xhr) {
                        Swal.fire({
                            title: 'Error',
                            text: 'Server Error. Try Again Later!',
                            icon: 'error'
                        });
                        console.log(xhr);
                    }
                });
            } else {
                Swal.fire('Cancelled', 'Your item is safe.', 'info');
            }
        });
    });

    $(".updateMat").on('click', function () {
        debugger;

        let row = $(this).closest('tr');
        let tds = row.find('td');
        let matid = $(tds[2]).data('matid');

        let id = $(this).data('id');

        let catid = $(tds[1]).data('ctid');
        let quantity = $(tds[7]).text().trim()
        let price = $(tds[5]).text()
        let nprice = parseFloat(price.replace(/[^\d.]/g, ""));
        let billNo = $(tds[6]).text()
        let purchaseMedium = $(tds[4]).text().trim();
        let supplierName = $(tds[3]).text().trim();
        console.log(quantity)

        $("#purchaseId").val(id);
        $("#prquantity").val(quantity);
        $("#prprice").val(nprice);
        $("#ssupplierName").val(supplierName);
        $("#prpurchaseMedium").val(purchaseMedium);
        $("#prbillNO").val(billNo);

        $("#mdcategoryName").val(catid)
        getmaterialbycatId(catid, "update").then(() => {
            $("#updatematerialname").val(matid)
        })
        $("#updateModal").modal('show');
    });
</script>