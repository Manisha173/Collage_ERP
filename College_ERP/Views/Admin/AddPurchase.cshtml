
@{
    ViewBag.Title = "AddPurchase";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    var categories = ViewData["categories"] as List<College_ERP.Models.Admin.InventoryCategory>;
    var data = ViewData["purchaseList"] as List<College_ERP.Models.Admin.PurchaseMaterial>;
}
<style>
    .dt-button {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 8px !important;
        color: inherit !important;
    }

        .dt-button:hover {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

        .dt-button:focus,
        .dt-button:active {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
        }

    .dt-buttons {
        display: flex;
        gap: -6px;
        align-items: center;
    }



    .icon-btn {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 5px 10px !important;
        min-width: auto !important;
        cursor: pointer;
    }

        .icon-btn:hover {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            transform: scale(1.15);
            transition: 0.2s ease;
        }

        .icon-btn:focus,
        .icon-btn:active {
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
        }

    .dt-buttons {
        display: flex;
        align-items: center;
        gap: -6px;
        position: initial;
        margin-top: 7px;
    }
</style>
<div class="content-page">
    <div class="content">
