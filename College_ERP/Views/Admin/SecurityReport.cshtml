
@{
    ViewBag.Title = "SecurityReport";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
    var data = ViewData["securityList"] as List<College_ERP.Models.Admin.Security>;
}
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.2/css/buttons.dataTables.css" />
<style>
    .dt-button {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 8px !important;
        color: inherit !important;
    }

        .dt-button:hover {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

        .dt-button:focus,
        .dt-button:active {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
        }

    .dt-buttons {
        display: flex;
        gap: -6px;
        align-items: center;
    }



    .icon-btn {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 5px 10px !important;
        min-width: auto !important;
        cursor: pointer;
    }

        .icon-btn:hover {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            transform: scale(1.15);
            transition: 0.2s ease;
        }

        .icon-btn:focus,
        .icon-btn:active {
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
        }

    .dt-buttons {
        display: flex;
        align-items: center;
        gap: -6px;
        position: initial;
        margin-top: 7px;
    }
</style>
<div class="content-page">
    <div class="content">
        <!-- container-fluid -->
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">

                        <div class="card-header d-flex border-bottom-0 pb-0">
                            <h5 class="card-title mb-0 d-flex justify-content-between">
                                <span>Security List</span> <!-- Button trigger modal -->
                            </h5>
                        </div><!-- end card header -->

                        <div class="card-body table-responsive">

                            <table id="securityTable" class="table table-bordered dt-responsive table-responsive nowrap">
                                <thead>
                                    <tr>
                                        <th>SR</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Mobile</th>
                                        <th>State</th>
                                        <th>Block / Gate No</th>
                                        <th>Show Visitors</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (data != null)
                                    {
                                        int count = 1;
                                        foreach (var item in data)
                                        {
                                            <tr>
                                                <td>@count</td>
                                                <td><a target="_blank" href="/admin/SecurityProfile?id=@item.Id" title="Show Profile">@item.Name</a></td>
                                                <td>@item.Email</td>
                                                <td>@item.MobileNo</td>
                                                <td>@item.State</td>
                                                <td>@(!string.IsNullOrEmpty(item.BlockName) ? item.BlockName:$"Gate No {item.GateNo}")</td>
                                                <td>
                                                    <a href="/admin/VisitorList?id=@item.Id" title="Show Visitor">View</a>
                                                </td>
                                            </tr>
                                            count++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<script defer src="https://cdn.datatables.net/buttons/3.2.2/js/dataTables.buttons.js"></script>
<script defer src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.dataTables.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script defer src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.html5.min.js"></script>

<script>
    function initializeDataTable() {
        debugger;

        // Export columns except column index 6
        const exportColumns = [0, 1, 2, 3, 4, 5];

        // PDF column widths
        const pdfColumnWidths = ['*', '*', '*', '*', '*', '*'];


        let table = $('#securityTable').DataTable({

            ordering: false,
            autoWidth: false,

            pageLength: 10,

            lengthMenu: [
                [10, 20, 50, 100],
                [10, 20, 50, 100]
            ],

            dom: '<"top"lBf>rt<"bottom"ip><"clear">',


            buttons: [

                {
                    extend: 'excel',

                    text: '<i class="fa-solid fa-file-excel" style="color:#287f71;font-size:25px;"></i>',

                    className: 'icon-btn',

                    titleAttr: 'Export Excel',

                    exportOptions: {
                        columns: exportColumns
                    }
                },


                {
                    extend: 'pdfHtml5',

                    text: '<i class="fa-solid fa-file-pdf" style="color:#dc3545;font-size:25px;"></i>',

                    className: 'icon-btn',

                    titleAttr: 'Export PDF',

                    orientation: 'landscape',

                    pageSize: 'A4',

                    exportOptions: {
                        columns: exportColumns
                    },


                    customize: function (doc) {

                        doc.defaultStyle.fontSize = 6;
                        doc.defaultStyle.alignment = 'center';


                        doc.styles.tableHeader.fontSize = 7;
                        doc.styles.tableHeader.bold = true;
                        doc.styles.tableHeader.alignment = 'center';


                        doc.content[1].table.widths = pdfColumnWidths;


                        var body = doc.content[1].table.body;


                        for (var i = 0; i < body.length; i++) {

                            for (var j = 0; j < body[i].length; j++) {

                                body[i][j].alignment = 'center';
                                body[i][j].margin = [2, 4, 2, 4];

                            }
                        }
                    }
                }
            ]
        });


        return table;
    }
        $(document).ready(function () {
            initializeDataTable()
        })
</script>