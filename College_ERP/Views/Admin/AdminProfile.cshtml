
@{
    ViewBag.Title = "AdminProfile";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<style>
    :root {
  --primary: #0f766e;
  --secondary: #134e4a;
  --accent: #115e59;
  --light: #042f2e;
  --dark: #042f2e;
  --success: #0d9488;
  --teal-50: #f0fdfa;
  --teal-100: #ccfbf1;
  --teal-200: #99f6e4;
  --teal-300: #5eead4;
  --teal-400: #2dd4bf;
  --teal-500: #14b8a6;
  --teal-600: #0d9488;
  --teal-700: #0f766e;
  --teal-800: #115e59;
  --teal-900: #134e4a;
  --teal-950: #042f2e;
}
 

/* Header Styles */
.profile-header {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  padding: 2rem;
  border-radius: 15px;
  box-shadow: 0 8px 25px rgba(15, 118, 110, 0.2);
}

.page-title {
  font-weight: 700;
  margin: 0;
}

.action-buttons .btn {
  border-radius: 25px;
  padding: 8px 20px;
  font-weight: 500;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(45deg, var(--teal-400), var(--teal-500));
  border: none;
  color: white;
}

.btn-primary:hover {
  background: linear-gradient(45deg, var(--teal-500), var(--teal-600));
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(20, 184, 166, 0.3);
}

.btn-outline-primary {
  border: 2px solid var(--teal-400);
  color: var(--teal-400);
  background: transparent;
}

.btn-outline-primary:hover {
  background: var(--teal-400);
  color: white;
  transform: translateY(-2px);
}

.btn-outline-success {
  border: 2px solid var(--success);
  color: var(--success);
  background: transparent;
}

.btn-outline-success:hover {
  background: var(--success);
  color: white;
  transform: translateY(-2px);
}

/* Main Profile Card */
.main-profile-card {
  background: white;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(15, 118, 110, 0.1);
  overflow: hidden;
  position: relative;
}

.main-profile-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: linear-gradient(90deg, var(--primary), var(--teal-400), var(--secondary));
}

/* Admin Overview */
.admin-overview {
  background: linear-gradient(135deg, var(--teal-50), white);
  padding: 2.5rem;
  border-bottom: 1px solid var(--teal-100);
}

.profile-image-container {
  position: relative;
  display: inline-block;
  margin-bottom: 1.5rem;
}

.profile-image {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  border: 4px solid var(--teal-200);
  box-shadow: 0 8px 25px rgba(15, 118, 110, 0.2);
  object-fit: cover;
  transition: all 0.3s ease;
}

.profile-image:hover {
  transform: scale(1.05);
  border-color: var(--teal-300);
}

.profile-badge {
  position: absolute;
  bottom: 15px;
  right: 15px;
  background: linear-gradient(135deg, #ffd700, #ffed4e);
  color: var(--secondary);
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
}

.admin-status {
  position: absolute;
  top: 10px;
  right: 10px;
  background: var(--success);
  color: white;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 5px;
}

.admin-status.active {
  background: var(--success);
  animation: pulse 2s infinite;
}

.admin-status i {
  font-size: 8px;
}

@@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(13, 148, 136, 0.7);
  }
  70% {
    box-shadow: 0 0 0 10px rgba(13, 148, 136, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(13, 148, 136, 0);
  }
}

.admin-basic-info {
  margin-top: 1rem;
}

.admin-name {
  color: var(--secondary);
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.admin-role {
  color: var(--accent);
  font-weight: 500;
  margin-bottom: 1rem;
}

.admin-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center;
}

.admin-badges .badge {
  font-size: 0.8rem;
  padding: 0.5rem 1rem;
  border-radius: 20px;
}

.bg-success {
  background: var(--success) !important;
}

.bg-primary {
  background: var(--primary) !important;
}

/* Quick Stats */
.quick-stats {
  margin-top: 1rem;
}

.stat-card {
  background: white;
  border-radius: 15px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  box-shadow: 0 4px 15px rgba(15, 118, 110, 0.1);
  transition: all 0.3s ease;
  height: 100%;
}

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(15, 118, 110, 0.15);
}

.stat-icon {
  background: linear-gradient(135deg, var(--teal-100), var(--teal-200));
  color: var(--primary);
  width: 50px;
  height: 50px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
}

.stat-info h6 {
  color: var(--accent);
  font-weight: 600;
  margin-bottom: 0.25rem;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stat-info p {
  color: var(--secondary);
  font-weight: 500;
  margin: 0;
  font-size: 1rem;
}

/* Profile Sections */
.profile-sections {
  padding: 0;
}

.info-section {
  border-bottom: 1px solid var(--teal-100);
}

.info-section:last-child {
  border-bottom: none;
}

.section-header {
  background: linear-gradient(90deg, var(--teal-50), transparent);
  padding: 1.5rem 2.5rem;
  border-bottom: 1px solid var(--teal-100);
}

.section-header h4 {
  color: var(--secondary);
  font-weight: 700;
  margin: 0;
  font-size: 1.3rem;
}

.section-header i {
  color: var(--primary);
}

.section-content {
  padding: 2rem 2.5rem;
}

/* Info Items */
.info-item {
  background: var(--teal-50);
  border-radius: 10px;
  padding: 1rem;
  border-left: 4px solid var(--primary);
  transition: all 0.3s ease;
  height: 100%;
}

.info-item:hover {
  background: var(--teal-100);
  transform: translateX(5px);
  border-left-color: var(--teal-600);
}

.info-item label {
  display: block;
  color: var(--accent);
  font-weight: 600;
  font-size: 0.85rem;
  margin-bottom: 0.5rem;
}

.info-item label i {
  color: var(--primary);
}

.info-item span {
  color: var(--secondary);
  font-weight: 500;
  font-size: 1rem;
  display: block;
}

.info-item .highlight {
  color: var(--primary);
  font-weight: 700;
  background: var(--teal-100);
  padding: 2px 8px;
  border-radius: 5px;
}

.document-link {
  color: var(--primary);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
}

.document-link:hover {
  color: var(--teal-600);
  text-decoration: underline;
  transform: translateX(5px);
}

/* Company Cards */
.company-card, .authorized-card {
  background: white;
  border-radius: 15px;
  box-shadow: 0 6px 20px rgba(15, 118, 110, 0.1);
  overflow: hidden;
  transition: all 0.3s ease;
  height: 100%;
}

.company-card:hover, .authorized-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(15, 118, 110, 0.15);
}

.company-card .card-header, .authorized-card .card-header {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.company-logo-container {
  position: relative;
}

.company-logo {
  width: 60px;
  height: 60px;
  border-radius: 10px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  object-fit: cover;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.company-info {
  flex: 1;
}

.company-info h5, .authorized-card .card-header h5 {
  margin: 0;
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.company-info p {
  margin: 0;
  opacity: 0.9;
  font-size: 0.9rem;
}

.authorized-card .card-header i {
  font-size: 1.5rem;
}

.card-content {
  padding: 1.5rem;
}

.card-content .info-item {
  background: var(--teal-50);
  margin-bottom: 1rem;
  border-left: 3px solid var(--teal-300);
}

.card-content .info-item:last-child {
  margin-bottom: 0;
}

/* Error States */
.image-error {
  background: linear-gradient(135deg, var(--teal-50), var(--teal-100));
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 3rem;
  border: 2px dashed var(--teal-200);
  border-radius: 50%;
  width: 200px;
  height: 200px;
}

.logo-error {
  background: linear-gradient(135deg, var(--teal-50), var(--teal-100));
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 1.5rem;
  border: 2px dashed var(--teal-200);
  border-radius: 10px;
  width: 60px;
  height: 60px;
}

/* Responsive Design */
@@media (max-width: 768px) {
  .profile-header {
    padding: 1.5rem;
  }

  .profile-header .d-flex {
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .action-buttons {
    width: 100%;
  }

  .action-buttons .btn {
    width: 32%;
    margin-bottom: 0.5rem;
  }

  .admin-overview {
    padding: 1.5rem;
  }

  .section-content {
    padding: 1.5rem;
  }

  .profile-image {
    width: 150px;
    height: 150px;
  }

  .stat-card {
    margin-bottom: 1rem;
  }

  .company-card, .authorized-card {
    margin-bottom: 1.5rem;
  }
}

@@media (max-width: 576px) {
  .profile-image {
    width: 120px;
    height: 120px;
  }

  .stat-card {
    padding: 1rem;
  }

  .stat-icon {
    width: 40px;
    height: 40px;
    font-size: 1rem;
  }

  .action-buttons .btn {
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .admin-badges {
    flex-direction: column;
    align-items: center;
  }
}

/* Animation */
@@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.info-section {
  animation: fadeInUp 0.6s ease forwards;
}

.info-section:nth-child(1) {
  animation-delay: 0.1s;
}
.info-section:nth-child(2) {
  animation-delay: 0.2s;
}

</style>


    <div class="content-page">
