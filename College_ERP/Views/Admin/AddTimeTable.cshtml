        function parseTimeRange(range) {
            const [from] = range.split("-");
            return parseTime(from);
        }

        function parseTime(timeStr) {
            const [time, modifier] = timeStr.split(" ");
            let [hours, minutes] = time.split(":").map(Number);

            if (modifier === "PM" && hours !== 12) hours += 12;
            if (modifier === "AM" && hours === 12) hours = 0;

            return hours * 60 + minutes; // Total minutes since midnight
        }


        function setTimeTable(data) {
            debugger
            const timetable = data;

            // Step 1: Extract all unique times
            const timeSlots = [...new Set(
                timetable.flatMap(day => day.ttdata.map(entry => `${entry.from}-${entry.to}`))
            )]
                .sort((a, b) => parseTimeRange(a) - parseTimeRange(b));


            // Step 2: Extract all unique days
            const days = timetable.map(d => d.day);

            // Step 3: Build a lookup map: { [time][day] = "Subject (Teacher)" }
            const lookup = {};
            timetable.forEach(entry => {
                const day = entry.day;
                entry.ttdata.forEach(slot => {
                    if (!lookup[`${slot.from}-${slot.to}`]) lookup[`${slot.from}-${slot.to}`] = {};
                    lookup[`${slot.from}-${slot.to}`][day] = `<span class="updateTimeTable" data-id="${slot.tid}">${slot.subjectName} </span>`;
                });
            });

            // Step 4: Build the header row (days)
            const dayRow = document.getElementById("day-row");
            $("#day-row").empty()
            const th = document.createElement("th");
            th.textContent = "Day/Time";
            dayRow.appendChild(th);
            days.forEach(day => {
                const th = document.createElement("th");
                th.textContent = day;
                dayRow.appendChild(th);
            });

            // Step 5: Build the body rows (time slots)
            const tbody = document.getElementById("timetable-body");
            $("#timetable-body").empty()
            timeSlots.forEach(time => {

                const tr = document.createElement("tr");
                const timeCell = document.createElement("td");
                timeCell.textContent = time;
                tr.appendChild(timeCell);

                days.forEach(day => {
                    console.log(time, "time")
                    const cell = document.createElement("td");
                    cell.innerHTML = lookup[time]?.[day] || "--";
                    tr.appendChild(cell);
                });

                tbody.appendChild(tr);
            });

        }

