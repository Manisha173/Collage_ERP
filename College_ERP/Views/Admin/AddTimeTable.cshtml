        function getsubjectsbyclassid(id, val, count, callback) {
            $.ajax({
                url: '/admin/GetSubjectandSectionByClassId',
                type: 'get',
                data: { id: id },
                success: function (data) {
                    if (data && data.subject) {
                        let el = `<select name="ttdata[${count}].subjectId" class="form-select" required>
                            <option value="">--Select Subject--</option>`;
                        data.subject.forEach(function (subject) {
                            el += `<option value="${subject.SubjectId}" ${val === subject.SubjectId ? "selected" : ""}>${subject.Subject}</option>`;
                        });
                        el += `</select>`;

                        // Call the callback with the result
                        callback(el);
                    } else {
                        callback('<select class="form-select"><option value="">No subjects found</option></select>');
                    }
                },
                error: function (xhr) {
                    console.log(xhr);
                    callback('<select class="form-select"><option value="">Error loading subjects</option></select>');
                }
            });
        }

