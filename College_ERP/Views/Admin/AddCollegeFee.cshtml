    function editCollegeFee(id) {
        $.get('/Admin/GetCollegeFeeById?id=' + id, function (data) {
            if (data) {
                $("#EditFeeId").val(data.FeeId);
                $("#EditClassId").val(data.ClassName);
                $("#EditBillingPeriod").val(data.BillingPeriod);
                $("#EditAdmissionFee").val(data.AdmissionFee);
                $("#EditBuildingFee").val(data.BuildingFee);
                $("#EditTutionFee").val(data.TutionFee);
                $("#EditSportsFee").val(data.SportsFee);
                $("#EditLibraryFee").val(data.LibraryFee);
                $("#EditActivityFee").val(data.ActivityFee);
                $("#EditAnnualCharge").val(data.AnnualCharge);
                $("#EditElectricianFee").val(data.ElectricianFee);
                $("#EditTotalFee").val(data.TotalFee);


                $('#editCollegeFeeModal').modal('show');
            }
        });
    }

    $('#editCollegeFeeForm').on('submit', function (e) {
        e.preventDefault();

        var formData = new FormData(this);
        //loader
        Swal.fire({
            title: 'Updating College Fee...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '/Admin/UpdateCollegeFee',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                Swal.close(); // Hide loader
                if (res.success) {
                    $('#editCollegeFeeModal').modal('hide');
                    Swal.fire('Updated!', 'College Fee updated successfully.', 'success').then(() => {
                        location.reload();
                    });
                } else {
                    Swal.close(); // Hide loader
                    Swal.fire('Error', 'Something went wrong.', 'error');
                }
            }
        });
    });

