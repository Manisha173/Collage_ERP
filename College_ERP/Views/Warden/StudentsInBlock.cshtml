                data: { studentid: stdid },
                success: function (data) {
                    console.log("Room Details :", data);
                    if (data) {
                        $('#floor').val(data[0].floor).trigger('change');
                        fetchRoomsByBlockId(data[0].floor)
                        setTimeout(() => {
                            $('#RoomNo').val(data[0].roomNo);
                        }, 1000)
                        $('#hiddenStudentId').val(data[0].studentid);
                        $('#studentidch').val(data[0].studentid);
                        $('#StudentId').val(data[0].studentName);
                        $('#StudentIdbr').val(data[0].studentName);
                        $('#FeeType').val(data[0].feeType);
                        $('#FeeSlip').val(data[0].feeSlip);
                        $('#TransactionId').val(data[0].transactionid);
                        $('#RemainingFees').val(data[0].remainingFee);
                        submittedFeeOfStudent = data[0].feeSubmitted;
                        if (!data[0].dueDate) {
                            $('#duedatecontainer').hide();
                        } else {
                            $('#DueDate').val(data[0].dueDate);
                        }
                        $('#FeesSubmitted').val(data[0].feeSubmitted);
                        $('#hiddenBlockId').val(data[0].BlockId);
                        
                        Swal.close();
                        $('#reallocateRoomModal').modal('show');
                    } else {
                        Swal.fire('Error', 'Failed to load', 'error');
                    }
                },
                error: function (xhr, status, error) {
                    //Swal.fire({
                    //    title: 'Error',
                    //    text: 'Server error occured',
                    //    icon: 'error'
                    //});
                    Swal.close();
                    $('#reallocateRoomModal').modal('show');
                    console.log(xhr);
                }
            });
        });
        $('#FeesSubmitted').on('input', function () {
            let remfee = $('#RemainingFees').val();
            if (remfee > 0) {
                $('#duedatecontainer').show();
            } else {
                $('#duedatecontainer').hide();
            }
        })
    });
</script>