@{
    ViewBag.Title = "MealSchedule";
    Layout = "~/Views/Shared/_wardenLayout.cshtml";
}

<style>
    .ts-dropdown .optgroup-header {
        font-weight: bold;
        padding: 5px 10px;
        margin: 5px 0;
        border-radius: 4px;
    }

    .ts-dropdown .option {
        padding-left: 20px !important;
    }
</style>

<div class="content-page">
    <div class="content">
        <div class="container-fluid">

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title d-flex justify-content-between">
                        <span>Meal Schedule List</span>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                            Add MealSchedule
                        </button>
                    </h4>
                    <table id="datatable" class="table table-bordered dt-responsive nowrap w-100">
                        <thead>
                            <tr>
                                <th>SR</th>
                                <th>Day</th>
                                <th>Created Date</th>
                                <th style="width:150px !important;">Actions</th>
                            </tr>
                        </thead>

                        @{
                            var meals = Model as List<College_ERP.Models.Warden.MealViewModel>;
                            int sr = 1;
                            var distinctDays = meals.GroupBy(x => x.Day).Select(g => g.First()).ToList();
                        }

                        <tbody>
                            @foreach (var item in distinctDays)
                            {
                                <tr>
                                    <td>@sr</td>
                                    <td>
                                        <a href="javascript:void(0);" onclick="viewMealDetails('@item.Day')">
                                            @item.Day
                                        </a>
                                    </td>
                                    <td>@item.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                    <td>
                                        <button class="btn btn-sm p-0" onclick="editMeal('@item.Day')">
                                            <i data-feather="edit" class="text-warning cursor-pointer" style="width:22px; height:22px;"></i>
                                        </button>
                                        <button class="btn btn-sm p-0" onclick="deleteClass(@item.MealId)"><i data-feather="trash-2" class="text-danger cursor-pointer" style="width:22px; height:22px;"></i></button>


                                    </td>
                                </tr>
                                sr++;
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

        <!-- Modal for Menu -->
        <div class="modal fade" id="mealDetailsModal" tabindex="-1" aria-labelledby="mealDetailsLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">

                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="mealDetailsLabel">Meal Details</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body" id="mealDetailsBody">
                    </div>

                </div>
            </div>
        </div>
        <!--<div class="modal fade" id="mealDetailsModal" tabindex="-1" aria-labelledby="mealDetailsLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-light">
                    <h5 class="modal-title" id="mealDetailsLabel">Meal Details</h5>
                    <button type="button" class="btn-close text-light" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="mealDetailsBody">-->
        <!-- Content will be loaded via AJAX -->
        <!--</div>
            </div>
        </div>
    </div>-->
        <!-- Modal for Adding Meal Schedule -->
        <div class="modal fade" id="exampleModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-light">
                        <h5 class="modal-title">Add Meal Schedule</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body modal-dialog-scrollable">
                        <form id="mealForm" method="post">
                            <div id="mealRowsContainer">
                                <!-- Initial Meal Row -->
                                <div class="meal-row border rounded p-3 mb-3">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <label>Day</label>
                                            <select class="form-select DaySelect">
                                                <option selected disabled>---Select Day---</option>
                                                <option value="Sunday">Sunday</option>
                                                <option value="Monday">Monday</option>
                                                <option value="Tuesday">Tuesday</option>
                                                <option value="Wednesday">Wednesday</option>
                                                <option value="Thursday">Thursday</option>
                                                <option value="Friday">Friday</option>
                                                <option value="Saturday">Saturday</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label>Start Time</label>
                                            <input type="time" class="form-control StartTime" />
                                        </div>
                                        <div class="col-md-4">
                                            <label>End Time</label>
                                            <input type="time" class="form-control EndTime" />
                                        </div>
                                        <div class="col-md-12">
                                            <label>Meal</label>
                                            <select id="select-tags" multiple data-placeholder="Select Meals" class="form-control MealSelect">
                                                <optgroup label="Dessert">
                                                    <option value="Gulab Jamun">Gulab Jamun</option>
                                                    <option value="Kheer">Kheer</option>
                                                    <option value="Rasgulla">Rasgulla</option>
                                                </optgroup>
                                                <optgroup label="Breakfast">
                                                    <option value="Poha">Poha</option>
                                                    <option value="Paratha & Curd">Paratha & Curd</option>
                                                    <option value="Bread Butter / Jam">Bread Butter / Jam</option>
                                                </optgroup>
                                                <optgroup label="Dinner">
                                                    <option value="Roti">Roti</option>
                                                    <option value="Rice">Rice</option>
                                                    <option value="Dal">Dal</option>
                                                </optgroup>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-end mb-3">
                                <button type="button" id="btnAddMealRow" class="btn btn-primary">
                                    <i data-feather="plus-circle"></i> Add More
                                </button>
                            </div>

                            <div class="text-center">
                                <!-- *** FIXED: Removed 'mealbtn' class to prevent conflict *** -->
                                <button type="submit" id="btnSaveMeal" class="btn btn-primary">Submit Meal Schedule</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script src="~/assets/tom-select/tom-select.complete.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    $(document).on('click', '.remove-meal-row', function () {
        $(this).closest('.meal-row').remove();
    });

    $(document).ready(function () {

        $("#exampleModal").on("hide.bs.modal", function () {
            $("#mealForm")[0].reset()
        })

        new TomSelect("#select-tags", {
            plugins: ['remove_button'],
            create: true,
            onItemAdd: function () {
                this.setTextboxValue('');
                this.refreshOptions();
            },
            render: {
                option: function (data, escape) {
                    return '<div class="d-flex"><span>' + escape(data.value) + '</span></div>';
                },
                item: function (data, escape) {
                    return '<div>' + escape(data.value) + '</div>';
                }
            }
        });


        $('#btnAddMealRow').on('click', function () {
            // Validate the last meal row
            var $lastRow = $('.meal-row').last();
            var day = $lastRow.find('.DaySelect').val();
            var startTime = $lastRow.find('.StartTime').val();
            var endTime = $lastRow.find('.EndTime').val();
            var mealsSelected = $lastRow.find('.MealSelect').val();

            if (!day || !startTime || !endTime || !mealsSelected || mealsSelected.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Incomplete Entry',
                    text: 'Please complete the current meal row before adding a new one.'
                });
                return;
            }

            // Clone and reset the row

            var $original = $('.meal-row').first();
            var $clone = $original.clone();

            var selectedDay = $original.find('select.DaySelect').val();
            $clone.find('select.DaySelect').val(selectedDay).prop('disabled', true);

            $clone.find('input.mealId').val('');
            $clone.find('input.StartTime').val('');
            $clone.find('input.EndTime').val('');
            $clone.find('.MealSelect').val('');

            // Replace MealSelect
            var newMealSelect = $(`
            <label class="">Meal</label>
       <select class="form-control MealSelect" multiple data-placeholder="Select Meals">
            <optgroup label="Dessert">
                <option value="Gulab Jamun">Gulab Jamun</option>
                <option value="Kheer">Kheer</option>
                <option value="Rasgulla">Rasgulla</option>
            </optgroup>
            <optgroup label="Breakfast">
                <option value="Poha">Poha</option>
                <option value="Paratha & Curd">Paratha & Curd</option>
                <option value="Bread Butter / Jam">Bread Butter / Jam</option>
            </optgroup>
            <optgroup label="Dinner">
                <option value="Roti">Roti</option>
                <option value="Rice">Rice</option>
                <option value="Dal">Dal</option>
            </optgroup>
        </select>
    `);

            $clone.find('.ts-wrapper').remove();
            $clone.find('.MealSelect').parent().empty().append(newMealSelect);


            $clone.append(`
    <button type="button" class="btn btn-sm position-absolute top-0 end-0 m-2 remove-meal-row">
        <i class='fa-regular fa-trash-can' style="width: 16px; height: 16px; color:red;"></i>
    </button>
`);
            $clone.addClass('position-relative');

            $('#mealRowsContainer').append($clone);

            feather.replace();

            $clone.find('.MealSelect').each(function () {
                new TomSelect(this, {
                    plugins: ['remove_button'],
                    create: true,
                    onItemAdd: function () {
                        this.setTextboxValue('');
                        this.refreshOptions();
                    },
                    render: {
                        option: function (data, escape) {
                            return '<div class="d-flex"><span>' + escape(data.value) + '</span></div>';
                        },
                        item: function (data, escape) {
                            return '<div>' + escape(data.value) + '</div>';
                        }
                    }
                });
            });
        });

    });

    //show menu
    function viewMealDetails(day) {
        $.ajax({
            url: '/Warden/GetMealDetailsByDay',
            type: 'GET',
            data: { day: day },
            success: function (response) {

                console.log(response);

                if (response.success) {

                    var html = '';
                    html += '<h5 class="fw-bold mb-3">Day: ' + day + '</h5>';

                    response.data.forEach(function (meal) {

                        html += '<div class="meal-block mb-3 border-bottom pb-2">';
                        html += '<h6><strong>Meal Time:</strong> ' + meal.StartTime + ' - ' + meal.EndTime + '</h6>';

                        if (meal.Menus && meal.Menus.length > 0) {
                            html += '<ul>';

                            meal.Menus.forEach(function (menu) {
                                html += '<li>' + menu.Menu + '</li>';
                            });

                            html += '</ul>';
                        }
                        else {
                            html += '<p>No menu available.</p>';
                        }

                        html += '</div>';
                    });

                    $('#mealDetailsBody').html(html);

                    // Bootstrap 5 Modal
                    var modal = new bootstrap.Modal(document.getElementById('mealDetailsModal'));
                    modal.show();

                } else {
                    Swal.fire("Error", response.message, "error");
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                Swal.fire("Error", "Some error occurred.", "error");
            }
        });
    }
