
@{
    ViewBag.Title = "SecurityProfile";
    Layout = "~/Views/Shared/_securityLayout.cshtml";
}

@model List<College_ERP.Models.Admin.Security>
@{
    ViewBag.Title = "SecurityProfile";
    Layout = "~/Views/Shared/_securityLayout.cshtml";
}

<style>
    :root {
        --primary: #0f766e;
        --secondary: #134e4a;
        --accent: #115e59;
        --light: #042f2e;
        --dark: #042f2e;
        --success: #0d9488;
        --teal-50: #f0fdfa;
        --teal-100: #ccfbf1;
        --teal-200: #99f6e4;
        --teal-300: #5eead4;
        --teal-400: #2dd4bf;
        --teal-500: #14b8a6;
        --teal-600: #0d9488;
        --teal-700: #0f766e;
        --teal-800: #115e59;
        --teal-900: #134e4a;
        --teal-950: #042f2e;
    }


    /* Header Styles */
    .profile-header {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
        padding: 2rem;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(15, 118, 110, 0.2);
    }

    .page-title {
        font-weight: 700;
        margin: 0;
    }

    .action-buttons .btn {
        border-radius: 25px;
        padding: 8px 20px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: linear-gradient(45deg, var(--teal-400), var(--teal-500));
        border: none;
        color: white;
    }

        .btn-primary:hover {
            background: linear-gradient(45deg, var(--teal-500), var(--teal-600));
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(20, 184, 166, 0.3);
        }

    .btn-outline-primary {
        border: 2px solid var(--teal-400);
        color: var(--teal-400);
        background: transparent;
    }

        .btn-outline-primary:hover {
            background: var(--teal-400);
            color: white;
            transform: translateY(-2px);
        }

    .btn-outline-success {
        border: 2px solid var(--success);
        color: var(--success);
        background: transparent;
    }

        .btn-outline-success:hover {
            background: var(--success);
            color: white;
            transform: translateY(-2px);
        }

    /* Main Profile Card */
    .main-profile-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 118, 110, 0.1);
        overflow: hidden;
        position: relative;
    }

        .main-profile-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--primary), var(--teal-400), var(--secondary));
        }

    /* Security Overview */
    .security-overview {
        background: linear-gradient(135deg, var(--teal-50), white);
        padding: 2.5rem;
        border-bottom: 1px solid var(--teal-100);
    }

    .profile-image-container {
        position: relative;
        display: inline-block;
        margin-bottom: 1.5rem;
    }

    .profile-image {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        border: 4px solid var(--teal-200);
        box-shadow: 0 8px 25px rgba(15, 118, 110, 0.2);
        object-fit: cover;
        transition: all 0.3s ease;
    }

        .profile-image:hover {
            transform: scale(1.05);
            border-color: var(--teal-300);
        }

    .profile-badge {
        position: absolute;
        bottom: 15px;
        right: 15px;
        background: var(--primary);
        color: white;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        box-shadow: 0 4px 15px rgba(15, 118, 110, 0.3);
    }

    .security-status {
        position: absolute;
        top: 10px;
        right: 10px;
        background: var(--success);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .security-status.active {
            background: var(--success);
            animation: pulse 2s infinite;
        }

        .security-status i {
            font-size: 8px;
        }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(13, 148, 136, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(13, 148, 136, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(13, 148, 136, 0);
        }
    }

    .security-basic-info {
        margin-top: 1rem;
    }

    .security-name {
        color: var(--secondary);
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .security-id {
        color: var(--accent);
        font-weight: 500;
        margin-bottom: 1rem;
    }

    .security-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
    }

        .security-badges .badge {
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
            border-radius: 20px;
        }

    .bg-success {
        background: var(--success) !important;
    }

    .bg-primary {
        background: var(--primary) !important;
    }

    /* Quick Stats */
    .quick-stats {
        margin-top: 1rem;
    }

    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 4px 15px rgba(15, 118, 110, 0.1);
        transition: all 0.3s ease;
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(15, 118, 110, 0.15);
        }

    .stat-icon {
        background: linear-gradient(135deg, var(--teal-100), var(--teal-200));
        color: var(--primary);
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .stat-info h6 {
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 0.25rem;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-info p {
        color: var(--secondary);
        font-weight: 500;
        margin: 0;
        font-size: 1rem;
    }

    /* Profile Sections */
    .profile-sections {
        padding: 0;
    }

    .info-section {
        border-bottom: 1px solid var(--teal-100);
    }

        .info-section:last-child {
            border-bottom: none;
        }

    .section-header {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white !important;
        padding: 1.5rem 2.5rem;
        border-bottom: 1px solid var(--teal-100);
        border-radius: 15px;
    }

        .section-header h4 {
            font-weight: 700;
            margin: 0;
            font-size: 1.3rem;
        }



    .section-content {
        padding: 2rem 2.5rem;
    }

    /* Info Items */
    .info-item {
        background: var(--teal-50);
        border-radius: 10px;
        padding: 1rem;
        border-left: 4px solid var(--primary);
        transition: all 0.3s ease;
        height: 100%;
    }

        .info-item:hover {
            background: var(--teal-100);
            transform: translateX(5px);
            border-left-color: var(--teal-600);
        }

        .info-item label {
            display: block;
            color: var(--accent);
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
        }

            .info-item label i {
                color: var(--primary);
            }

        .info-item span {
            color: var(--secondary);
            font-weight: 500;
            font-size: 1rem;
            display: block;
        }

        .info-item .highlight {
            color: var(--primary);
            font-weight: 700;
            background: var(--teal-100);
            padding: 2px 8px;
            border-radius: 5px;
        }

    /* Assignment Cards */
    .assignment-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 6px 20px rgba(15, 118, 110, 0.1);
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
    }

        .assignment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(15, 118, 110, 0.15);
        }

        .assignment-card .card-header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

            .assignment-card .card-header i {
                font-size: 1.5rem;
            }

            .assignment-card .card-header h5 {
                margin: 0;
                font-weight: 600;
            }

        .assignment-card .card-content {
            padding: 1.5rem;
        }

        .assignment-card .info-item {
            background: var(--teal-50);
            margin-bottom: 1rem;
            border-left: 3px solid var(--teal-300);
        }

            .assignment-card .info-item:last-child {
                margin-bottom: 0;
            }

    /* Clearance Cards */
    .clearance-card {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 6px 20px rgba(15, 118, 110, 0.1);
        transition: all 0.3s ease;
        height: 100%;
    }

        .clearance-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(15, 118, 110, 0.15);
        }

    .clearance-icon {
        background: linear-gradient(135deg, var(--teal-100), var(--teal-200));
        color: var(--primary);
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin: 0 auto 1rem;
    }

    .clearance-info h6 {
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.9rem;
    }

    .clearance-info h4 {
        color: var(--secondary);
        font-weight: 700;
        margin-bottom: 0.5rem;
        font-size: 2rem;
    }

    .clearance-info p {
        margin: 0;
        font-size: 0.9rem;
    }

    /* Certifications List */
    .certifications-list {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(15, 118, 110, 0.1);
    }

        .certifications-list h6 {
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 1rem;
        }

    .cert-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--teal-50);
        border-radius: 10px;
        border-left: 4px solid var(--primary);
        transition: all 0.3s ease;
    }

        .cert-item:hover {
            background: var(--teal-100);
            transform: translateX(5px);
        }

        .cert-item i {
            font-size: 1.5rem;
        }

    .cert-details {
        flex: 1;
    }

        .cert-details strong {
            color: var(--secondary);
            display: block;
            font-weight: 600;
        }

        .cert-details small {
            color: var(--accent);
            font-size: 0.8rem;
        }

    .cert-status {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

        .cert-status.active {
            background: var(--success);
            color: white;
        }

    /* Performance Cards */
    .performance-card {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(15, 118, 110, 0.1);
        margin-bottom: 1rem;
    }

        .performance-card h6 {
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 1rem;
        }

    .performance-meter {
        position: relative;
    }

    .meter-bar {
        background: var(--teal-100);
        height: 25px;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .meter-fill {
        height: 100%;
        border-radius: 12px;
        transition: width 1s ease;
        position: relative;
    }

        .meter-fill.excellent {
            background: linear-gradient(90deg, var(--success), var(--teal-500));
        }

        .meter-fill.good {
            background: linear-gradient(90deg, var(--teal-400), var(--teal-600));
        }

    .meter-text {
        color: var(--secondary);
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* Achievements */
    .achievements {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(15, 118, 110, 0.1);
    }

        .achievements h6 {
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 1rem;
        }

    .achievement-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .achievement-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--teal-50);
        border-radius: 8px;
        border-left: 4px solid var(--primary);
        transition: all 0.3s ease;
    }

        .achievement-item:hover {
            background: var(--teal-100);
            transform: translateX(10px);
        }

        .achievement-item i {
            font-size: 1.2rem;
        }

        .achievement-item span {
            color: var(--secondary);
            font-weight: 500;
        }

    /* Error States */
    .image-error {
        background: linear-gradient(135deg, var(--teal-50), var(--teal-100));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        font-size: 3rem;
        border: 2px dashed var(--teal-200);
        border-radius: 50%;
        width: 180px;
        height: 180px;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .profile-header {
            padding: 1.5rem;
        }

            .profile-header .d-flex {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }

        .action-buttons {
            width: 100%;
        }

            .action-buttons .btn {
                width: 32%;
                margin-bottom: 0.5rem;
            }

        .security-overview {
            padding: 1.5rem;
        }

        .section-content {
            padding: 1.5rem;
        }

        .profile-image {
            width: 150px;
            height: 150px;
        }

        .stat-card {
            margin-bottom: 1rem;
        }

        .assignment-card {
            margin-bottom: 1.5rem;
        }

        .clearance-card {
            margin-bottom: 1.5rem;
        }
    }

    @@media (max-width: 576px) {
        .profile-image {
            width: 120px;
            height: 120px;
        }

        .stat-card {
            padding: 1rem;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }

        .action-buttons .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }

        .security-badges {
            flex-direction: column;
            align-items: center;
        }
    }

    /* Animation */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .info-section {
        animation: fadeInUp 0.6s ease forwards;
    }

        .info-section:nth-child(1) {
            animation-delay: 0.1s;
        }

        .info-section:nth-child(2) {
            animation-delay: 0.2s;
        }

        .info-section:nth-child(3) {
            animation-delay: 0.3s;
        }

        .info-section:nth-child(4) {
            animation-delay: 0.4s;
        }
</style>
<div class="content-page">
    <div class="container-fluid py-4">
        <!-- Header Section -->
        <div class="profile-header mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="page-title mb-1">
                        <i class="fas fa-shield-alt me-2"></i>
                        Security Profile
                    </h2>
                    <p class="text-light mb-0">Personal, Professional & Security Details</p>
                </div>
               
            </div>
        </div>

        <!-- Main Profile Card -->
        <div class="row">
            <div class="col-lg-12">
                <div class="main-profile-card">
                    <!-- Security Overview Section -->
                    <div class="security-overview">
                        <div class="row align-items-center">
                            <div class="col-md-3 text-center">
                                <div class="profile-image-container">
                                    <img src="@Model[0].ImageName"
                                         class="profile-image"
                                         alt="Security Personnel Photo"
                                         onerror="handleImageError(this)" />
                                    <div class="profile-badge">
                                        <i class="fas fa-shield-alt"></i>
                                    </div>
                                    <div class="security-status active">
                                        <i class="fas fa-circle"></i>
                                        <span>On Duty</span>
                                    </div>
                                </div>

                            </div>

                            <div class="col-md-9">
                                <div class="quick-stats">
                                    <div class="row ms-2">
                                        <div class="security-basic-info mt-0">
                                            <h4 class="security-name">@Model[0].Name</h4>
                                            <p class="security-id">Employee ID:@Model[0].EmployeeId </p>

                                        </div>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="stat-card">
                                                <div class="stat-icon">
                                                    <i class="fas fa-door-open"></i>
                                                </div>
                                                <div class="stat-info">
                                                    <h6>Gate Assignment</h6>
                                                    <p>@(!string.IsNullOrEmpty(Model[0].GateNo) ? Model[0].GateNo:"N/A")</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="stat-card">
                                                <div class="stat-icon">
                                                    <i class="fas fa-building"></i>
                                                </div>
                                                <div class="stat-info">
                                                    <h6>Block Assignment</h6>
                                                    <p>@(!string.IsNullOrEmpty(Model[0].BlockName)? Model[0].BlockName:"N/A")</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="stat-card">
                                                <div class="stat-icon">
                                                    <i class="fas fa-phone"></i>
                                                </div>
                                                <div class="stat-info">
                                                    <h6>Contact</h6>
                                                    <p>@Model[0].MobileNo</p>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Detailed Information Sections -->
                    <div class="profile-sections">
                        <!-- Personal Information -->
                        <div class="info-section">
                            <div class="section-header">
                                <h4><i class="fas fa-user me-2"></i>Personal Information</h4>
                            </div>
                            <div class="section-content">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-user me-2"></i>Full Name</label>
                                            <span>@Model[0].Name</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-envelope me-2"></i>Email Address</label>
                                            <span>@Model[0].Email</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-phone me-2"></i>Mobile Number</label>
                                            <span>@Model[0].MobileNo</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-calendar me-2"></i>Date of Birth</label>
                                            <span>@(Model[0].DOB.ToString("dd-MMM-yyyy"))</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-venus-mars me-2"></i>Gender</label>
                                            <span>@Model[0].Gender</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-id-card me-2"></i>Aadhar Number</label>
                                            <span>@Model[0].AdharNo</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-map-marker-alt me-2"></i>State</label>
                                            <span>@Model[0].State</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-city me-2"></i>City</label>
                                            <span>@Model[0].City</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-tags me-2"></i>Category</label>
                                            <span>@Model[0].Category</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-item">
                                            <label><i class="fas fa-building me-2"></i>Block Assignment</label>
                                            <span>@(!string.IsNullOrEmpty(Model[0].BlockName)? Model[0].BlockName:"N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="info-item">
                                            <label><i class="fas fa-home me-2"></i>Address</label>
                                            <span>@Model[0].Address</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Handle image error
    function handleImageError(img) {
        img.style.display = "none"

        const placeholder = document.createElement("div")
        placeholder.className = "profile-image image-error"
        placeholder.innerHTML = '<i class="fas fa-user-shield"></i>'

        img.parentNode.insertBefore(placeholder, img.nextSibling)
    }

    // Add interactive effects
    document.addEventListener("DOMContentLoaded", () => {
        // Animate performance bars
        const performanceBars = document.querySelectorAll(".meter-fill")
        performanceBars.forEach((bar) => {
            const width = bar.style.width
            bar.style.width = "0%"
            setTimeout(() => {
                bar.style.width = width
            }, 500)
        })

        // Add hover effects to cards
        const cards = document.querySelectorAll(".stat-card, .assignment-card, .clearance-card, .performance-card")
        cards.forEach((card) => {
            card.addEventListener("mouseenter", function () {
                this.style.transform = "translateY(-8px)"
            })

            card.addEventListener("mouseleave", function () {
                this.style.transform = "translateY(0)"
            })
        })

        // Add click effects to buttons
        const buttons = document.querySelectorAll(".btn")
        buttons.forEach((button) => {
            button.addEventListener("click", function (e) {
                // Create ripple effect
                const ripple = document.createElement("span")
                const rect = this.getBoundingClientRect()
                const size = Math.max(rect.width, rect.height)
                const x = e.clientX - rect.left - size / 2
                const y = e.clientY - rect.top - size / 2

                ripple.style.width = ripple.style.height = size + "px"
                ripple.style.left = x + "px"
                ripple.style.top = y + "px"
                ripple.style.position = "absolute"
                ripple.style.borderRadius = "50%"
                ripple.style.background = "rgba(255, 255, 255, 0.3)"
                ripple.style.transform = "scale(0)"
                ripple.style.animation = "ripple 0.6s linear"
                ripple.style.pointerEvents = "none"

                this.style.position = "relative"
                this.style.overflow = "hidden"
                this.appendChild(ripple)

                setTimeout(() => {
                    ripple.remove()
                }, 600)
            })
        })

        // Add loading animation to main card
        const mainCard = document.querySelector(".main-profile-card")
        mainCard.style.opacity = "0"
        mainCard.style.transform = "translateY(50px)"

        setTimeout(() => {
            mainCard.style.transition = "all 0.8s ease"
            mainCard.style.opacity = "1"
            mainCard.style.transform = "translateY(0)"
        }, 200)

        // Security status pulse animation
        const securityStatus = document.querySelector(".security-status")
        if (securityStatus) {
            setInterval(() => {
                securityStatus.style.transform = "scale(1.05)"
                setTimeout(() => {
                    securityStatus.style.transform = "scale(1)"
                }, 200)
            }, 3000)
        }

        // Achievement items hover effect
        const achievementItems = document.querySelectorAll(".achievement-item")
        achievementItems.forEach((item) => {
            item.addEventListener("mouseenter", function () {
                this.style.transform = "translateX(15px)"
                this.style.background = "var(--teal-100)"
            })

            item.addEventListener("mouseleave", function () {
                this.style.transform = "translateX(0)"
                this.style.background = "var(--teal-50)"
            })
        })

        // Certification items hover effect
        const certItems = document.querySelectorAll(".cert-item")
        certItems.forEach((item) => {
            item.addEventListener("mouseenter", function () {
                this.style.transform = "translateX(10px)"
                this.style.background = "var(--teal-100)"
            })

            item.addEventListener("mouseleave", function () {
                this.style.transform = "translateX(0)"
                this.style.background = "var(--teal-50)"
            })
        })

        // Add security clearance level animation
        const clearanceCards = document.querySelectorAll(".clearance-card")
        clearanceCards.forEach((card, index) => {
            setTimeout(() => {
                card.style.opacity = "0"
                card.style.transform = "translateY(30px)"
                card.style.transition = "all 0.6s ease"

                setTimeout(() => {
                    card.style.opacity = "1"
                    card.style.transform = "translateY(0)"
                }, 100)
            }, index * 200)
        })
    })

    // Add CSS for ripple animation
    const style = document.createElement("style")
    style.textContent = `
  @@keyframes ripple {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }
`
    document.head.appendChild(style)

    // Print functionality
    function printProfile() {
        window.print()
    }

    // Edit functionality placeholder
  

    // Verify functionality placeholder
    function verifyProfile() {
        alert("Profile verification would be implemented here")
    }

</script>


