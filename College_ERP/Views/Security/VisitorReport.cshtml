
@{
    ViewBag.Title = "VisitorReport";
    Layout = "~/Views/Shared/_securityLayout.cshtml";
    var data = ViewData["visitorlistrepo"] as List<College_ERP.Models.Security.main.VisitorModel>;
}
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.2/css/buttons.dataTables.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
    .dt-button {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 8px !important;
        color: inherit !important;
    }

        .dt-button:hover,
        .dt-button:focus,
        .dt-button:active {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
        }

    .dt-buttons {
        display: flex;
        align-items: center;
        gap: 8px; /* -6px ki jagah positive gap use karein */
        margin-top: 7px;
    }

    .icon-btn {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 5px 10px !important;
        min-width: auto !important;
        cursor: pointer;
    }

        .icon-btn:hover {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            transform: scale(1.15);
            transition: .2s ease;
        }

        .icon-btn:focus,
        .icon-btn:active {
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
        }
    table.dataTable thead th,
    table.dataTable thead td {
        border: 1px solid #dee2e6 !important;
    }

    table.dataTable tbody td {
        border: 1px solid #dee2e6 !important;
    }
</style>

<div class="content-page">
    <div class="card">
        <div class="card-header mb-2 py-0 text-end border-bottom-0">
        </div>
        <div class="card-body py-0 my-0">
            <div class="row">
                <div class="col-sm-12 text-center">

                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header d-flex border-bottom-0 pb-0">
                            <h4>All Visitors List</h4>
                            <div class="w-25 pb-1 ms-5 ">
                                <input type="text" name="searchFilter" id="searchFilter" class="form-control" style="margin-left:200px" placeholder="Search By Name or Mobile" />
                            </div>
                        </div>
                        <div class="card-body py-0 my-0">
                            <table id="datatable" class="table table-bordered dt-responsive nowrap w-100">
                                <thead>
                                    <tr>
                                        <th>SR</th>
                                        <th>Name</th>
                                        <th>Mobile</th>
                                        <th>Email</th>
                                        <th>Address</th>
                                        <th>Photo</th>
                                    </tr>
                                </thead>
                                <tbody id="visitorTableBody">
                                    @if (data != null)
                                    {
                                        int count = 1;
                                        foreach (var item in data)
                                        {
                                            <tr>
                                                <td>@count</td>
                                                <td>
                                                    <a href="#" title="Show History" data-id=@item.id class="showvisitoryhistory">@item.name</a>
                                                </td>
                                                <td>@item.mobile</td>
                                                <td>@item.email</td>
                                                <td>@item.address</td>
                                                <td><a href="@item.imageName" target="_blank" title="Show Photo">Show</a></td>
                                                <!--<td class="text-center">-->
                                                @*<a href="#" class="btn btn-sm deletemat" data-id="@item.id" title="Delete"><i data-feather="trash-2" class="text-danger ms-2"></i></a>*@
                                                <!--<a href="#" title="Login Visitor" data-id="@item.id" class="btn text-success loginVisitor">Login</a>
                                                </td>-->
                                            </tr>
                                            count++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Modal History-->
<div class="modal fade" id="historyShowModal" tabindex="-1" aria-labelledby="historyShowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="historyShowModalLabel">History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="datatablehis" class="table table-bordered ">
                        <thead>
                            <tr>
                                <th>SR</th>
                                <th>Name</th>
                                <th>Reason</th>
                                <th>Remark</th>
                                <th>Logout Time</th>
                                <th>Visit For</th>
                                <th>Person Name</th>
                                <th>Photo</th>
                            </tr>
                        </thead>
                        <tbody id="visitorTableBodyHistory">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script defer src="https://cdn.datatables.net/buttons/3.2.2/js/dataTables.buttons.js"></script>
<script defer src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.dataTables.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script defer src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.html5.min.js"></script>




<script>
    function initializeDataTable() {
        debugger;

        // Export columns
        const exportColumns = [0, 1, 2, 3, 4, 5];

        // PDF column widths
        const pdfColumnWidths = ['*', '*', '*', '*', '*', '*'];

        let table = $('#datatable').DataTable({
            ordering: false,
            autoWidth: false,
            pageLength: 10,
            lengthMenu: [
                [10, 20, 50, 100],
                [10, 20, 50, 100]
            ],
            dom: '<"top"lBf>rt<"bottom"ip><"clear">',

            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fa-solid fa-file-excel" style="color:#287f71;font-size:25px;"></i>',
                    className: 'icon-btn',
                    titleAttr: 'Export Excel',
                    exportOptions: {
                        columns: exportColumns
                    }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fa-solid fa-file-pdf" style="color:#dc3545;font-size:25px;"></i>',
                    className: 'icon-btn',
                    titleAttr: 'Export PDF',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    exportOptions: {
                        columns: exportColumns
                    },
                    customize: function (doc) {

                        doc.defaultStyle.fontSize = 6;
                        doc.defaultStyle.alignment = 'center';

                        doc.styles.tableHeader.fontSize = 7;
                        doc.styles.tableHeader.bold = true;
                        doc.styles.tableHeader.alignment = 'center';

                        doc.content[1].table.widths = pdfColumnWidths;

                        var body = doc.content[1].table.body;

                        for (var i = 0; i < body.length; i++) {
                            for (var j = 0; j < body[i].length; j++) {
                                body[i][j].alignment = 'center';
                                body[i][j].margin = [2, 4, 2, 4];
                            }
                        }
                    }
                }
            ]
        });

        return table;
    }
    function initializeDataTablehis() {
        debugger;

        // Export columns (exclude last Action column)
        const exportColumns = [0, 1, 2, 3, 4, 5, 6, 7];

        // PDF column widths
        const pdfColumnWidths = ['*', '*', '*', '*', '*', '*', '*', '*'];

        let table = $('#datatablehis').DataTable({
            ordering: false,
            autoWidth: false,
            pageLength: 10,
            lengthMenu: [
                [10, 20, 50, 100],
                [10, 20, 50, 100]
            ],
            dom: '<"top"lBf>rt<"bottom"ip><"clear">',

            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fa-solid fa-file-excel" style="color:#287f71;font-size:25px;"></i>',
                    className: 'icon-btn',
                    titleAttr: 'Export Excel',
                    exportOptions: {
                        columns: exportColumns
                    }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fa-solid fa-file-pdf" style="color:#dc3545;font-size:25px;"></i>',
                    className: 'icon-btn',
                    titleAttr: 'Export PDF',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    exportOptions: {
                        columns: exportColumns
                    },
                    customize: function (doc) {

                        // Default font settings
                        doc.defaultStyle.fontSize = 6;
                        doc.defaultStyle.alignment = 'center';

                        // Header settings
                        doc.styles.tableHeader.fontSize = 7;
                        doc.styles.tableHeader.bold = true;
                        doc.styles.tableHeader.alignment = 'center';

                        // Set equal column widths
                        doc.content[1].table.widths = pdfColumnWidths;

                        // Center all table cells
                        var body = doc.content[1].table.body;

                        for (var i = 0; i < body.length; i++) {
                            for (var j = 0; j < body[i].length; j++) {
                                body[i][j].alignment = 'center';
                                body[i][j].margin = [2, 4, 2, 4];
                            }
                        }
                    }
                }
            ]
        });

        return table;
    }
    $(document).ready(function () {
        initializeDataTable()
        initializeDataTablehis()
    })
</script>

<script>
    $(document).ready(function () {

        $('.showvisitoryhistory').click(function () {
            let id = $(this).data('id');
            $.ajax({
                url: '/security/GetVisitorsHistory',
                type: 'get',
                data: { id: id },
                success: function (res) {
                    if (res && res.length > 0) {
                        let html = '';
                        res.forEach(function (visitor, index) {
                            html += `<tr>
                                 <td>${index + 1}</td>
                                 <td>${visitor.name}</td>
                                 <td>${visitor.reason}</td>
                                 <td>${visitor.remark}</td>
                                 <td>${visitor.logOutTime}</td>
                                 <td>${visitor.userType !== "student" ? visitor.staffRole : visitor.userType}</td>
                                 <td>${visitor.personName}</td>
                                <td>${visitor.imageName && visitor.imageName != "" ? `<a href="${visitor.imageName}" target="_blank" title="Show Photo">Show</a>` : "Not Uploaded"}
                                </td>

                            </tr>`;
                        });
                        $('#visitorTableBodyHistory').html(html);
                    } else {
                        $('#visitorTableBodyHistory').empty();
                        Swal.fire({
                            title: 'Warning',
                            text: 'Data not found!',
                            icon: 'warning',
                            didClose: () => { $('#visitorTableBody').append(`<tr><td colspan="8" class="text-center text-danger">No data found</td></tr>`) }
                        });
                    }
                    $('#historyShowModal').modal('show');
                },
                error: function (xhr) {
                    console.log(xhr);

                    Swal.fire('Error', 'Failed to fetch data', 'error');
                }
            });
        })
    });
</script>
<script>
    $(document).ready(function () {
        let debounceTimer;

        $('#searchFilter').on('input', function () {
            clearTimeout(debounceTimer); // Clear any existing timer

            debounceTimer = setTimeout(function () {
                let inputdata = $('#searchFilter').val();

                $.ajax({
                    url: '/security/GetAllVisitorByFilter',
                    type: 'get',
                    data: { filt: inputdata },
                    success: function (res) {
                        if (res && res.length > 0) {
                            $('#visitorTableBody').empty();
                            let html = '';
                            res.forEach(function (visitor, index) {
                                html += `<tr>
                                    <td>${index + 1}</td>
                                    <td>${visitor.name}</td>
                                    <td>${visitor.mobile}</td>
                                    <td>${visitor.email}</td>
                                    <td>${visitor.address}</td>
                                    <td><a href="${visitor.imageName}" target="_blank" title="Show Photo">Show</a></td>

                                </tr>`;
                            });
                            $('#visitorTableBody').html(html);
                        } else {
                            $('#visitorTableBody').empty();
                            Swal.fire({
                                title: 'Warning',
                                text: 'Data not found!',
                                icon: 'warning',
                                didClose: () => { $('#visitorTableBody').append(`<tr><td colspan="6" class="text-center text-danger">No data found</td></tr>`) }
                            });
                        }
                    },
                    error: function (xhr) {
                        console.log(xhr);

                        Swal.fire('Error', 'Failed to fetch data', 'error');
                    }
                });
            }, 500); // Wait 500ms after typing stops
        });
    });
</script>

