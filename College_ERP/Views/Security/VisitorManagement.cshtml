<script>
    let webcamActive = false;

    document.getElementById('cameraPlaceholder').addEventListener('click', function () {
        if (!webcamActive) {
            navigator.mediaDevices.getUserMedia({ video: true })
                .then(function (stream) {
                    stream.getTracks().forEach(track => track.stop());

                    const modal = new bootstrap.Modal(document.getElementById('cameraModal'));
                    modal.show();

                    Webcam.set({
                        width: 450, // or just omit width
                        height: 340,
                        image_format: 'jpeg',
                        jpeg_quality: 90
                    });

                    Webcam.attach('#my_camera');
                    webcamActive = true;
                })
                .catch(function () {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Camera Not Detected',
                        text: 'Please connect a webcam to take a photo.',
                        confirmButtonText: 'OK'
                    });
                });
        }
    });

    document.getElementById('takePhoto').addEventListener('click', function () {
        Webcam.snap(function (data_uri) {
            document.getElementById('capturedImage').value = data_uri;
            if (data_uri != null) {
                $('#previewImage').attr('src', data_uri);
                $('#imagenotCAp').hide();
            }
            document.getElementById('placeholderText').textContent = 'visitor_photo.jpg';

            Webcam.reset();
            webcamActive = false;

            const modal = bootstrap.Modal.getInstance(document.getElementById('cameraModal'));
            modal.hide();
        });
    });


    function closeCamera() {
        if (webcamActive) {
            Webcam.reset();
            webcamActive = false;
        }
    }
    $('#previewButton').on('click', function () {
        $('#ImageModal').modal('show');
    });

    $('#visiterModalClosebtn').on('click', function () {
        $('.addVisitorForm')[0].reset();
        $('#capturedImage').val();
        $('#addVisitorModal').modal('hide');
    });
</script>

<script>
    $(document).ready(function () {


        let debounceTimer;

        $('#searchFilter').on('input', function () {
            clearTimeout(debounceTimer); // Clear any existing timer

            debounceTimer = setTimeout(function () {
                let inputdata = $('#searchFilter').val();

                $.ajax({
                    url: '/security/GetAllVisitorByFilter',
                    type: 'get',
                    data: { filt: inputdata },
                    success: function (res) {
                        if (res && res.length > 0) {
                            $('#visitorTableBody').empty();
                            let html = '';
                            res.forEach(function (visitor, index) {
                                html += `<tr>
                                    <td>${index + 1}</td>
                                    <td>${visitor.name}</td>
                                    <td>${visitor.mobile}</td>
                                    <td>${visitor.email}</td>
                                    <td>${visitor.address}</td>
                                    <td>${
                                    visitor.imageName && visitor.imageName != ""
                                    ? `<a href="${visitor.imageName}" target="_blank" title="Show Photo">Show</a>`
                                        : "Not Uploaded"
}</td>
                                    <td><a href="#" title="Login Visitor" data-id="${visitor.id}" class="btn text-success loginVisitor">Login</a></td>
                                </tr>`;
                            });
                            $('#visitorTableBody').html(html);
                            
                        } else {
                            $('#visitorTableBody').empty();
                            $('#visitorTableBody').html(`<tr><td colspan="7" class="text-center text-danger">No Data Found</td></tr>`);

                        }
                    },
                    error: function (xhr) {
                        console.log(xhr);
                    }
                });
            }, 500); // Wait 500ms after typing stops
        });
    });
</script>

<script>
