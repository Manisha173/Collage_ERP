                    $('#lguserTypeSelect').val(data.userType).trigger('change');

                    if (data.userType === 'staff') {
                        $('#lgroomDropdown, #lgclsDropdown, #lgsecDropdown, #lgstdDropdown, #lgstudentOptions').hide();
                        $('#lgstaffDropdown, #lgpersonDropdown').show();

                        $('#lgstaffRole').val(data.staffRole);
                        getpersonbytype(data.staffRole, "update").then(() => {
                            $('#lgpersonId').val(data.personId);
                        });
                    } else if (data.userType === 'student') {
                        $('#lgstaffDropdown, #lgpersonDropdown').hide();
                        $('#lgstudentOptions, #lgclsDropdown, #lgsecDropdown, #lgstdDropdown').show();

                        $('#lgclassSectionOption').prop('checked', true);
