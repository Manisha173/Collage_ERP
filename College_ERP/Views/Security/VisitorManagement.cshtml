<script type="text/javascript" src="https://cdn.rawgit.com/jhuckaby/webcamjs/master/webcam.min.js"></script>

<script>


    $(document).ready(function () {
        // By default, show student-specific fields
        $('#staffDropdown, #personDropdown').hide();
        $('#radioContainer').show();

        // Show fields based on default selected radio (class)
        if ($('#classMode').is(':checked')) {
            $('#clsDropdown, #secDropdown').show();
            $('#roomDropdown').hide();
        } else {
            $('#clsDropdown, #secDropdown').hide();
            $('#roomDropdown').show();
        }

        $('#stdDropdown').show();
    });

    // Already existing code: on change of dropdown and radio buttons
    $('.uuserTypeSelect').on('change', function () {
        debugger
        if ($(this).val() === 'staff') {
            $('#staffDropdown, #personDropdown').show();
            $('#clsDropdown, #secDropdown, #stdDropdown, #roomDropdown, #radioContainer').hide();
            $('#lgstaffDropdown, #lgpersonDropdown').show();
            $('#lgstudentOptions, #lgclsDropdown, #lgsecDropdown, #lgstdDropdown').hide();
        } else if ($(this).val() === 'student') {
            $('#staffDropdown, #personDropdown').hide();
            $('#radioContainer').show();
            $('input[name="mode"][value="class"]').prop('checked', true);
            $('#clsDropdown, #secDropdown, #stdDropdown').show();
            $('#roomDropdown').hide();
            $('#lgstaffDropdown, #lgpersonDropdown').hide();
            $('#lgstudentOptions, #lgclsDropdown, #lgsecDropdown, #lgstdDropdown').show();
        }
    });

    $(document).on('change', 'input[name="inputType"]', function () {
        debugger
        if ($(this).val() === 'class') {
            $('#clsDropdown, #secDropdown').show();
            $('#lgclsDropdown, #lgsecDropdown').show();
            $('#roomDropdown').hide();
            $('#lgroomDropdown').hide();
        } else if($(this).val() === 'room') {
            $('#clsDropdown, #secDropdown').hide();
            $('#lgclsDropdown, #lgsecDropdown').hide();
            $('#roomDropdown').show();
            $('#lgroomDropdown').show();
        }
        $('#stdDropdown').show();
    });
    $(document).on('change', 'input[name="mode"]', function () {
        debugger
        if ($(this).val() === 'class') {
            $('#clsDropdown, #secDropdown').show();
            $('#lgclsDropdown, #lgsecDropdown').show();
            $('#roomDropdown').hide();
            $('#lgroomDropdown').hide();
        } else if($(this).val() === 'room') {
            $('#clsDropdown, #secDropdown').hide();
            $('#lgclsDropdown, #lgsecDropdown').hide();
            $('#roomDropdown').show();
            $('#lgroomDropdown').show();
        }
        $('#stdDropdown').show();
    });
</script>


<script>
    $(function () {
        $('.mobileval').on('input', function () {
            let m = $(this).val().replace(/\D/g, '').slice(0, 10);
            $(this).val(m);
            $('.mobileError').text(
                m.length < 10 ? 'Mobile number must be 10 digits.' :
                    !/^[6-9]/.test(m) ? 'Mobile number must start with 6, 7, 8, or 9.' : ''
            );
        });
    });
    $(function () {
        $('.adharval').on('input', function () {
            let a = $(this).val().replace(/\D/g, '').slice(0, 12);
            $(this).val(a);
            $('.adharError').text(
                a.length < 12 ? 'Aadhaar number must be 12 digits.' : ''
            );
        });
    });
</script>

<script>
    $(document).on('change', '#roomNo', function () {
        debugger
        let id = $(this).val();
        fetchStudentsByRoomNo(id);
    });
    $(document).on('change', '#lgroomNo', function () {
        debugger
        let id = $(this).val();
        fetchStudentsByRoomNo(id);
    });
    function fetchStudentsByRoomNo(roomNo) {
        $.ajax({
            url: '/security/GetStudentsByRoomNo',
            type: 'get',
            data: { roomNo: roomNo },
            success: function (response) {
                if (response.length > 0) {
                    let options = '<option value="">--Select Student--</option>';
                    response.forEach(student => {
                        options += `<option value="${student.studentid}">${student.userName}</option>`;


                    });
                    $('.bindStudent').html(options);
                } else {
                    $('.bindStudent').empty();
                    $('.bindStudent').html('<option value="">--No Student Available--</option>');
                }
            },
            error: function () {
                Swal.fire('Error', 'Unable to fetch students for this Room No', 'error');
            }
        });
    }

    $(document).ready(function () {
        $("#datatable1").DataTable();
    });
    $(document).on("change", "#class", function () {
        debugger
        $('.bindStudent').html(`<option selected disabled>--Select Student--</option>`);
        $("#section").html(`<option selected disabled>--Select Section--</option>`);
        let id = $(this).val();
        Swal.fire({
            title: 'Please wait!',
            text: 'Loading Section...',
            outsideClick: false,
            allowEscapeKey: false,
            didOpen: () => { Swal.showLoading(); }
        });
        $.ajax({
            url: '/security/GetSectionByClassId',
            type: 'get',
            data: { id: id },
            success: function (response) {
                if (response && response.length > 0) {
                    $.each(response, function (index, item) {
                        $("#section").append(`<option value='${item.SectionId}'>${item.SectionName}</option>`);
                    });
                    Swal.close();
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'error',
                    text: 'Something went wrong with the request'
                });
            }
        });
    });
    $(document).ready(function () {

        //Bind Student Starts

        $("#lgclass").on("change", function () {
            $('.bindStudent').html(`<option selected disabled>--Select Student--</option>`);
            $("#lgsection").html(`<option selected disabled>--Select Section--</option>`);
            let id = $(this).val();
            Swal.fire({
                title: 'Please wait!',
                text: 'Loading Section...',
                outsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });
            $.ajax({
                url: '/security/GetSectionByClassId',
                type: 'get',
                data: { id: id },
                success: function (response) {
