            let data = new FormData(this);

            // Check for base64 image (from webcam)
            let base64Image = $('#capturedImage').val();
            if (base64Image) {
                let blob = dataURItoBlob(base64Image); // Convert base64 to blob
                data.append("image", blob, "visitor_photo.jpg"); // Append to form data
